// New student: archive-backed student creation.
import { Button, LineEdit, Theme } from "../theme.slint";
import { PanelShell } from "./panel-shell.slint";

export component NewStudentPanel inherits Rectangle {
    in property <bool> can-create: false;

    in-out property <string> name;
    in-out property <string> grade;
    in-out property <string> subjects;
    in-out property <string> objectives;
    in-out property <string> difficulties;
    in-out property <string> notes;

    callback close();
    callback create();

    width: 100%;
    height: 100%;
    background: transparent;

    PanelShell {
        available-width: root.width;
        available-height: root.height;
        heading: "New student";
        detail: "Add a student to this archive";
        close => { root.close(); }

        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    Text { text: "Name"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                    LineEdit { text <=> root.name; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    Text { text: "Grade or level"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                    LineEdit { text <=> root.grade; }
                }
            }
            Text { text: "Subjects"; color: Theme.faint; font-size: 12px; font-weight: 600; }
            LineEdit { text <=> root.subjects; }
            Text { text: "Learning objectives"; color: Theme.faint; font-size: 12px; font-weight: 600; }
            LineEdit { text <=> root.objectives; }
            Text { text: "Known difficulties"; color: Theme.faint; font-size: 12px; font-weight: 600; }
            LineEdit { text <=> root.difficulties; }
            Text { text: "Tutor notes"; color: Theme.faint; font-size: 12px; font-weight: 600; }
            LineEdit { text <=> root.notes; }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Add student";
                    variant: "primary";
                    enabled: root.can-create;
                    clicked => { root.create(); }
                }
                Button { text: "Cancel"; variant: "ghost"; clicked => { root.close(); } }
                Rectangle { }
            }
        }
    }
}
