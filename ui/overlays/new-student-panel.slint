import { Button, LineEdit } from "../theme.slint";
import { ActionWrap, Field, FormWrap } from "../components/page-parts.slint";
import { PanelShell } from "./panel-shell.slint";

export component NewStudentPanel inherits Rectangle {
    in property <bool> can-create: false;

    in-out property <string> name;
    in-out property <string> grade;
    in-out property <string> subjects;
    in-out property <string> objectives;
    in-out property <string> difficulties;
    in-out property <string> notes;

    callback close();
    callback create();

    width: 100%;
    height: 100%;
    background: transparent;

    PanelShell {
        available-width: root.width;
        available-height: root.height;
        heading: "New student";
        detail: "Add a student to this archive";
        close => { root.close(); }

        FormWrap {
            Field { label: "Name"; LineEdit { text <=> root.name; } }
            Field { label: "Grade or level"; max-width: 240px; LineEdit { text <=> root.grade; } }
            Field { label: "Subjects"; LineEdit { text <=> root.subjects; } }
            Field { label: "Learning objectives"; LineEdit { text <=> root.objectives; } }
            Field { label: "Known difficulties"; LineEdit { text <=> root.difficulties; } }
            Field { label: "Tutor notes"; LineEdit { text <=> root.notes; } }
        }

        ActionWrap {
            Button {
                text: "Add student";
                variant: "primary";
                enabled: root.can-create;
                clicked => { root.create(); }
            }
            Button { text: "Cancel"; variant: "ghost"; clicked => { root.close(); } }
        }
    }
}
