import { Button, ComboBox, LineEdit, Theme } from "../theme.slint";
import { ActionWrap, Field, FormWrap } from "../components/page-parts.slint";
import { PanelShell } from "./panel-shell.slint";

export component ExportPanel inherits Rectangle {
    in property <[string]> guide-options: [];
    in property <[string]> track-options: [];
    in property <bool> has-session: false;
    in property <bool> has-audio: root.track-options.length > 0;
    in-out property <string> selected-guide;
    in-out property <string> selected-track;
    in-out property <string> guide-format: "markdown";
    in-out property <string> guide-path;
    in-out property <string> wav-path;
    in-out property <string> session-path;

    callback close();
    callback export-guide(string, string, string);
    callback export-wav(string);
    callback export-session(string);
    callback track-selected(string);

    width: 100%;
    height: 100%;
    background: transparent;

    PanelShell {
        available-width: root.width;
        available-height: root.height;
        heading: "Export";
        detail: "Only implemented formats are shown";
        close => { root.close(); }

        Text { text: "Study guide"; color: Theme.ink; font-size: 16px; font-weight: 700; }
        Text {
            text: "Export the selected guide using a format the guide exporter implements.";
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        FormWrap {
            Field {
                label: "Guide";
                ComboBox { model: root.guide-options; current-value <=> root.selected-guide; }
            }
            Field {
                label: "Format";
                max-width: 200px;
                ComboBox {
                    model: ["markdown", "html", "json", "pdf", "docx"];
                    current-value <=> root.guide-format;
                }
            }
        }
        Field {
            label: "Export file";
            LineEdit { placeholder-text: "Export file path"; text <=> root.guide-path; }
        }
        ActionWrap {
            Button {
                text: "Export guide";
                variant: "primary";
                enabled: root.selected-guide != "" && root.guide-path != "";
                clicked => { root.export-guide(root.selected-guide, root.guide-format, root.guide-path); }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }

        Text { text: "Session audio"; color: Theme.ink; font-size: 16px; font-weight: 700; }
        Text {
            text: "Choose a track from the current take in the recording dock.";
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        FormWrap {
            Field {
                label: "WAV file";
                LineEdit { placeholder-text: "WAV export path"; text <=> root.wav-path; }
            }
            Field {
                label: "Track";
                max-width: 240px;
                ComboBox {
                    model: root.track-options;
                    current-value <=> root.selected-track;
                    enabled: root.has-audio;
                    accessible-label: "Track to export";
                    selected(value) => { root.track-selected(value); }
                }
            }
        }
        ActionWrap {
            Button {
                text: "Export WAV";
                enabled: root.has-session && root.has-audio && root.wav-path != "";
                clicked => { root.export-wav(root.wav-path); }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }

        Text { text: "Session package"; color: Theme.ink; font-size: 16px; font-weight: 700; }
        Text {
            text: "Exports the session as a portable package that can be imported into another archive.";
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        Field {
            label: "Package file";
            LineEdit {
                placeholder-text: "Package output path (for example Session.tux)";
                text <=> root.session-path;
            }
        }
        ActionWrap {
            Button {
                text: "Export session package";
                enabled: root.has-session && root.session-path != "";
                clicked => { root.export-session(root.session-path); }
            }
        }
    }
}
