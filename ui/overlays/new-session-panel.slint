// New session: creates its journal entry and session in one real operation.
import { Button, ComboBox, LineEdit, Theme } from "../theme.slint";
import { PanelShell } from "./panel-shell.slint";

export component NewSessionPanel inherits Rectangle {
    in property <[string]> student-options: [];
    in property <[string]> template-options: [];
    in property <string> status;
    in property <bool> can-create: false;

    in-out property <string> title;
    in-out property <string> subject;
    in-out property <string> type: "notes-only";
    in-out property <string> student: "Anonymous session";
    in-out property <string> objectives;
    in-out property <string> template;
    in-out property <string> new-student-name;
    in-out property <string> new-student-grade;

    callback close();
    callback create();

    width: 100%;
    height: 100%;
    background: transparent;

    PanelShell {
        available-width: root.width;
        available-height: root.height;
        heading: "New session";
        detail: "Create a journal entry and its session";
        close => { root.close(); }

        VerticalLayout {
            spacing: 12px;

            Text {
                text: "Create a session with its own journal entry.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }

            Text { text: "Title"; color: Theme.faint; font-size: 11px; font-weight: 600; }
            LineEdit { placeholder-text: "For example, Rhetorical analysis"; text <=> root.title; }

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    Text { text: "Subject"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    LineEdit { placeholder-text: "AP Language and Composition"; text <=> root.subject; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    Text { text: "Student"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    ComboBox { model: root.student-options; current-value <=> root.student; }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    Text { text: "Session type"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    ComboBox {
                        model: ["notes-only", "record-audio", "import-recording"];
                        current-value <=> root.type;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    Text { text: "Guide template"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    ComboBox { model: root.template-options; current-value <=> root.template; }
                }
            }
            Text { text: "Learning objectives"; color: Theme.faint; font-size: 11px; font-weight: 600; }
            LineEdit { placeholder-text: "Optional"; text <=> root.objectives; }

            if root.student == "Create a new student" : HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    Text { text: "New student name"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    LineEdit { text <=> root.new-student-name; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    Text { text: "Grade or level"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    LineEdit { text <=> root.new-student-grade; }
                }
            }

            Text { text: root.status; color: Theme.faint; font-size: 11px; wrap: word-wrap; }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Create session";
                    variant: "primary";
                    enabled: root.can-create;
                    clicked => { root.create(); }
                }
                Button { text: "Cancel"; variant: "ghost"; clicked => { root.close(); } }
                Rectangle { }
            }
        }
    }
}
