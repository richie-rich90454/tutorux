import { Button, ComboBox, LineEdit, Theme } from "../theme.slint";
import { ActionWrap, Field, FormWrap } from "../components/page-parts.slint";
import { PanelShell } from "./panel-shell.slint";

export component NewSessionPanel inherits Rectangle {
    in property <[string]> student-options: [];
    in property <[string]> template-options: [];
    in property <string> status;
    in property <bool> can-create: false;

    in-out property <string> title;
    in-out property <string> subject;
    in-out property <string> type: "notes-only";
    in-out property <string> student: "Anonymous session";
    in-out property <string> objectives;
    in-out property <string> template;
    in-out property <string> new-student-name;
    in-out property <string> new-student-grade;

    callback close();
    callback create();

    width: 100%;
    height: 100%;
    background: transparent;

    PanelShell {
        available-width: root.width;
        available-height: root.height;
        heading: "New session";
        detail: "Create a journal entry and its session";
        close => { root.close(); }

        Text {
            text: "Create a session with its own journal entry.";
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        FormWrap {
            Field {
                label: "Title";
                LineEdit { placeholder-text: "For example, Rhetorical analysis"; text <=> root.title; }
            }
            Field {
                label: "Subject";
                LineEdit { placeholder-text: "AP Language and Composition"; text <=> root.subject; }
            }
            Field {
                label: "Student";
                ComboBox { model: root.student-options; current-value <=> root.student; }
            }
            Field {
                label: "Session type";
                max-width: 240px;
                ComboBox {
                    model: ["notes-only", "record-audio", "import-recording"];
                    current-value <=> root.type;
                }
            }
            Field {
                label: "Guide template";
                ComboBox { model: root.template-options; current-value <=> root.template; }
            }
        }
        Field {
            label: "Learning objectives";
            LineEdit { placeholder-text: "Optional"; text <=> root.objectives; }
        }

        if root.student == "Create a new student" : FormWrap {
            Field {
                label: "New student name";
                LineEdit { text <=> root.new-student-name; }
            }
            Field {
                label: "Grade or level";
                max-width: 240px;
                LineEdit { text <=> root.new-student-grade; }
            }
        }

        Text { text: root.status; color: Theme.faint; font-size: 12px; wrap: word-wrap; }

        ActionWrap {
            Button {
                text: "Create session";
                variant: "primary";
                enabled: root.can-create;
                clicked => { root.create(); }
            }
            Button { text: "Cancel"; variant: "ghost"; clicked => { root.close(); } }
        }
    }
}
