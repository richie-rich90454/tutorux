import { Button, LineEdit, ScrollText, Theme } from "../theme.slint";
import { ActionWrap, Field, FormWrap } from "../components/page-parts.slint";
import { PanelShell } from "./panel-shell.slint";

export component AiPanel inherits Rectangle {
    in property <bool> has-session: false;
    in property <string> output;
    in-out property <string> provider;
    in-out property <string> endpoint;
    in-out property <string> model-id;
    in-out property <string> model-path;
    in-out property <string> package-job-id;
    in-out property <string> api-key-environment;
    in-out property <string> confirmation-hash;
    in-out property <string> package-path;
    in-out property <string> response-path;

    callback close();
    callback command(string, string, string);

    width: 100%;
    height: 100%;
    background: transparent;

    PanelShell {
        available-width: root.width;
        available-height: root.height;
        heading: "AI actions";
        detail: "Optional preparation and review workflows";
        close => { root.close(); }

        Text {
            text: "Manual packages need no API key. BYOK sends data only after you review the exact request and confirm its hash.";
            color: Theme.muted;
            font-size: 12px;
            line-height-factor: 1.45;
            wrap: word-wrap;
        }

        FormWrap {
            Field {
                label: "Provider";
                LineEdit {
                    placeholder-text: "Provider ID, such as openai, ollama, llama.cpp-embedded";
                    text <=> root.provider;
                }
            }
            Field {
                label: "Endpoint";
                LineEdit { placeholder-text: "Optional provider endpoint"; text <=> root.endpoint; }
            }
            Field {
                label: "Model ID";
                LineEdit { placeholder-text: "Model ID"; text <=> root.model-id; }
            }
        }

        Field {
            label: "Embedded model";
            LineEdit {
                placeholder-text: "GGUF model path for embedded llama.cpp";
                text <=> root.model-path;
            }
        }

        ActionWrap {
            Button { text: "Configure"; clicked => { root.command(root.provider, "configure", ""); } }
            Button { text: "Select GGUF"; clicked => { root.command(root.provider, "select-embedded", ""); } }
            Button { text: "Provider integrations"; clicked => { root.command(root.provider, "providers", ""); } }
            Button { text: "Refresh model catalog"; clicked => { root.command(root.provider, "models", ""); } }
            Button { text: "Installed models"; clicked => { root.command(root.provider, "model-list", ""); } }
            Button { text: "Verify model"; clicked => { root.command(root.provider, "verify-model", ""); } }
        }

        Rectangle { height: 1px; background: Theme.line; }

        Text { text: "Manual package"; color: Theme.ink; font-size: 14px; font-weight: 700; }
        Field {
            label: "Export path";
            LineEdit { placeholder-text: "Optional package export path"; text <=> root.package-path; }
        }
        ActionWrap {
            Button {
                text: "Prepare chat package";
                variant: "primary";
                enabled: root.has-session;
                clicked => { root.command(root.provider, "package", root.package-path); }
            }
            Button {
                text: "Prepare ZIP package";
                enabled: root.has-session;
                clicked => { root.command(root.provider, "zip-package", root.package-path); }
            }
            Button {
                text: "Prepare local package";
                enabled: root.has-session;
                clicked => { root.command(root.provider, "local-package", root.package-path); }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }

        Text { text: "Run with a provider"; color: Theme.ink; font-size: 14px; font-weight: 700; }
        FormWrap {
            Field {
                label: "Package job";
                LineEdit { placeholder-text: "Package job ID"; text <=> root.package-job-id; }
            }
            Field {
                label: "API key";
                LineEdit {
                    placeholder-text: "Environment variable name";
                    text <=> root.api-key-environment;
                }
            }
        }
        ActionWrap {
            Button {
                text: "Preview / run locally";
                enabled: root.has-session;
                clicked => { root.command(root.provider, "generate", ""); }
            }
        }

        Field {
            label: "Request confirmation";
            LineEdit {
                placeholder-text: "Paste the exact request body SHA-256 after review";
                text <=> root.confirmation-hash;
            }
        }
        ActionWrap {
            Button {
                text: "Confirm outbound request";
                enabled: root.has-session && root.confirmation-hash != "";
                clicked => { root.command(root.provider, "confirm-send", ""); }
            }
        }

        Field {
            label: "External response";
            LineEdit {
                placeholder-text: "JSON file path";
                text <=> root.response-path;
            }
        }
        ActionWrap {
            Button {
                text: "Import response";
                enabled: root.has-session && root.response-path != "";
                clicked => { root.command(root.provider, "import", root.response-path); }
            }
        }

        ScrollText { height: 180px; text: root.output; text-color: Theme.body; }
    }
}
