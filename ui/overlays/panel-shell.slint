// Shared modal sheet: 5 px radius, one hairline header, internal scrolling.
import { Button, ScrollArea, Theme } from "../theme.slint";

export component PanelShell inherits Rectangle {
    in property <string> heading;
    in property <string> detail;
    in property <length> available-width: 1024px;
    in property <length> available-height: 768px;
    in property <length> sheet-width: 780px;
    in property <bool> inline: false;
    in property <string> close-label: "Close";
    callback close;

    width: root.inline ? root.available-width : min(root.sheet-width, root.available-width - 64px);
    height: root.inline ? root.available-height : min(700px, root.available-height - 64px);
    x: root.inline ? 0px : (root.available-width - self.width) / 2;
    y: root.inline ? 0px : (root.available-height - self.height) / 2;
    background: Theme.surface;
    border-width: root.inline ? 0px : 1px;
    border-color: Theme.line;
    border-radius: root.inline ? 0px : 5px;
    clip: true;

    accessible-role: AccessibleRole.region;
    accessible-label: root.heading;

    TouchArea {
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 62px;
            background: Theme.surface;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: 22px;
                padding-right: 14px;
                spacing: 12px;

                VerticalLayout {
                    spacing: 2px;
                    padding-top: 13px;
                    Text {
                        text: root.heading;
                        color: Theme.ink;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.detail;
                        color: Theme.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                }

                Rectangle { }

                Button {
                    text: root.close-label;
                    variant: "ghost";
                    visible: !root.inline;
                    clicked => { root.close(); }
                }
            }
        }

        focus-scope := FocusScope {
            vertical-stretch: 1;
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close();
                    return accept;
                }
                reject
            }

            ScrollArea {
                width: 100%;
                height: 100%;
                content-width: self.visible-width;
                content-height: max(self.visible-height, body.preferred-height);

                body := VerticalLayout {
                    width: parent.visible-width;
                    padding: 22px;
                    spacing: 14px;

                    @children
                }
            }
        }
    }
}

export component FieldLabel inherits Text {
    height: 17px;
    vertical-alignment: bottom;
    color: Theme.faint;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1px;
}
