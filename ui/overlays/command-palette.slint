// Command palette: one searchable, keyboard-navigable list of primary actions.
import { Button, LineEdit, Theme } from "../theme.slint";

export component CommandPalette inherits Rectangle {
    in-out property <string> query;
    callback close;
    callback action(string);

    width: 100%;
    height: 100%;
    background: Theme.scrim;
    z: 200;

    init => { search.focus-input(); }

    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: max(12px, min(max(48px, parent.height / 5), parent.height - self.height - 12px));
        width: min(560px, parent.width - 48px);
        height: palette-content.preferred-height + 24px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 5px;

        palette-content := VerticalLayout {
            padding: 12px;
            spacing: 6px;

            search := LineEdit {
                placeholder-text: "Find an action";
                text <=> root.query;
                accepted => {
                    if (root.matches("Journal")) {
                        root.action("journal");
                    } else if (root.matches("Sessions")) {
                        root.action("sessions");
                    } else if (root.matches("Students")) {
                        root.action("students");
                    } else if (root.matches("Materials")) {
                        root.action("materials");
                    } else if (root.matches("Study guide")) {
                        root.action("guides");
                    } else if (root.matches("New session")) {
                        root.action("new-session");
                    } else if (root.matches("New student")) {
                        root.action("new-student");
                    } else if (root.matches("Export")) {
                        root.action("export");
                    } else if (root.matches("Settings")) {
                        root.action("settings");
                    } else if (root.matches("Command console")) {
                        root.action("console");
                    }
                }
            }

            Text {
                text: "Actions";
                color: Theme.faint;
                font-size: 12px;
                font-weight: 600;
                height: 20px;
            }

            if root.matches("Journal") : Button {
                text: "Open journal";
                width: 100%;
                fill: true;
                label-left-aligned: true;
                variant: "ghost";
                clicked => { root.action("journal"); }
            }
            if root.matches("Sessions") : Button {
                text: "Go to sessions";
                width: 100%;
                fill: true;
                label-left-aligned: true;
                variant: "ghost";
                clicked => { root.action("sessions"); }
            }
            if root.matches("Students") : Button {
                text: "Go to students";
                width: 100%;
                fill: true;
                label-left-aligned: true;
                variant: "ghost";
                clicked => { root.action("students"); }
            }
            if root.matches("Materials") : Button {
                text: "Go to materials";
                width: 100%;
                fill: true;
                label-left-aligned: true;
                variant: "ghost";
                clicked => { root.action("materials"); }
            }
            if root.matches("Study guide") : Button {
                text: "Open study guide";
                width: 100%;
                fill: true;
                label-left-aligned: true;
                variant: "ghost";
                clicked => { root.action("guides"); }
            }
            if root.matches("New session") : Button {
                text: "New session";
                width: 100%;
                fill: true;
                label-left-aligned: true;
                variant: "ghost";
                clicked => { root.action("new-session"); }
            }
            if root.matches("New student") : Button {
                text: "New student";
                width: 100%;
                fill: true;
                label-left-aligned: true;
                variant: "ghost";
                clicked => { root.action("new-student"); }
            }
            if root.matches("Export") : Button {
                text: "Export…";
                width: 100%;
                fill: true;
                label-left-aligned: true;
                variant: "ghost";
                clicked => { root.action("export"); }
            }
            if root.matches("Settings") : Button {
                text: "Settings";
                width: 100%;
                fill: true;
                label-left-aligned: true;
                variant: "ghost";
                clicked => { root.action("settings"); }
            }
            if root.matches("Command console") : Button {
                text: "Command console";
                width: 100%;
                fill: true;
                label-left-aligned: true;
                variant: "ghost";
                clicked => { root.action("console"); }
            }

            if !root.has-results() : Text {
                text: "No actions match ‘" + root.query + "’.";
                color: Theme.muted;
                font-size: 13px;
                height: 36px;
                vertical-alignment: center;
                accessible-role: AccessibleRole.text;
                accessible-label: "No matching actions";
            }
        }
    }

    public function focus-search() {
        search.focus-input();
    }

    pure function matches(label: string) -> bool {
        return root.query == "" ||
               label.to-lowercase().replace-all(root.query.to-lowercase(), "") != label.to-lowercase();
    }

    pure function has-results() -> bool {
        return root.matches("Journal") || root.matches("Sessions") ||
               root.matches("Students") || root.matches("Materials") ||
               root.matches("Study guide") || root.matches("New session") ||
               root.matches("New student") || root.matches("Export") ||
               root.matches("Settings") || root.matches("Command console");
    }
}
