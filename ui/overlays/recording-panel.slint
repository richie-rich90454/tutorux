import { Button, CheckBox, ComboBox, LineEdit, ScrollText, Theme } from "../theme.slint";
import { ActionWrap, Field, FormWrap } from "../components/page-parts.slint";
import { PanelShell } from "./panel-shell.slint";

export component RecordingPanel inherits Rectangle {
    in property <bool> has-session: false;
    in property <bool> writable: true;
    in property <string> preflight-output;
    in property <int> input-level: 0;
    in property <bool> preflight-ready: false;
    in property <string> preflight-requested-device-id;
    in-out property <string> microphone;
    in property <string> status-output;
    in property <string> command-output;

    in-out property <string> source: "microphone";
    in-out property <string> durability: "default";
    in-out property <string> playback;
    in-out property <string> application;
    in-out property <string> import-path;
    in-out property <string> export-path;
    in-out property <string> export-track;
    in-out property <bool> consent: false;
    in-out property <bool> live-transcription: false;
    in-out property <string> live-model-path;

    callback close();
    callback command(string, string);
    callback check-device();

    width: 100%;
    height: 100%;
    background: transparent;

    property <bool> needs-preflight: root.source == "microphone" || root.source == "both";
    property <bool> preflight-matches:
        root.preflight-requested-device-id == root.microphone;
    property <bool> preflight-ok:
        !root.needs-preflight || (root.preflight-ready && root.preflight-matches);
    property <bool> can-start:
        root.writable && root.has-session && root.consent &&
        root.source != "imported-file" && root.preflight-ok;

    PanelShell {
        available-width: root.width;
        available-height: root.height;
        heading: "Audio capture";
        detail: "Microphone, system audio, and archive-backed capture";
        close => { root.close(); }

        Text {
            text: "Choose a source, check the microphone input, confirm consent, then start capture. Audio is committed directly to the selected archive.";
            color: Theme.muted;
            font-size: 12px;
            line-height-factor: 1.45;
            wrap: word-wrap;
        }

        FormWrap {
            Field {
                label: "Source";
                ComboBox {
                    model: ["microphone", "system-audio", "both", "application", "imported-file"];
                    current-value <=> root.source;
                }
            }
            Field {
                label: "Durability";
                ComboBox {
                    model: ["default", "maximum", "reduced-write"];
                    current-value <=> root.durability;
                }
            }
        }

        FormWrap {
            Field {
                label: "Microphone";
                LineEdit {
                    placeholder-text: "Default input or device ID";
                    text <=> root.microphone;
                }
            }
            Field {
                label: "System-audio monitor / loopback";
                LineEdit { placeholder-text: "Device ID (optional)"; text <=> root.playback; }
            }
        }

        FormWrap {
            Field {
                label: "Application audio";
                LineEdit { placeholder-text: "Application audio ID"; text <=> root.application; }
            }
        }
        ActionWrap {
            Button { text: "List audio sources"; clicked => { root.command("devices", ""); } }
            Button {
                text: "Check microphone";
                enabled: root.needs-preflight;
                clicked => { root.check-device(); }
            }
            Rectangle {
                width: 220px;
                height: 8px;
                border-radius: 4px;
                background: Theme.surface-inset;
                Rectangle {
                    width: parent.width * root.input-level / 100;
                    height: parent.height;
                    border-radius: 4px;
                    background: Theme.accent;
                }
            }
        }
        Text {
            text: "Start both uses the application source when an ID is set.";
            color: Theme.faint;
            font-size: 12px;
            wrap: word-wrap;
        }
        Text {
            text: root.preflight-output;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        Text {
            text: "Check the selected microphone before starting.";
            color: Theme.faint;
            font-size: 12px;
            visible: !root.preflight-ok;
        }

        CheckBox {
            text: "I confirm that everyone being recorded has agreed to this recording.";
            checked <=> root.consent;
        }

        ActionWrap {
            Button {
                text: "Start";
                variant: "primary";
                enabled: root.can-start;
                clicked => { root.command("start", root.source); }
            }
            Button { text: "Pause"; enabled: root.has-session; clicked => { root.command("pause", ""); } }
            Button { text: "Resume"; enabled: root.has-session; clicked => { root.command("resume", ""); } }
            Button { text: "Stop"; enabled: root.has-session; clicked => { root.command("stop", ""); } }
            Button { text: "Status"; enabled: root.has-session; clicked => { root.command("status", ""); } }
        }

        CheckBox {
            text: "Create provisional transcript while recording";
            checked <=> root.live-transcription;
        }
        LineEdit {
            placeholder-text: "Local Whisper model path (GGML/GGUF)";
            text <=> root.live-model-path;
        }

        Rectangle { height: 1px; background: Theme.line; }

        Text { text: "Import or export audio"; color: Theme.ink; font-size: 14px; font-weight: 700; }
        FormWrap {
            Field {
                label: "Import";
                LineEdit { placeholder-text: "WAV file to import"; text <=> root.import-path; }
            }
            Field {
                label: "Export";
                LineEdit { placeholder-text: "WAV export path"; text <=> root.export-path; }
            }
            Field {
                label: "Track";
                LineEdit { placeholder-text: "Track ID (optional)"; text <=> root.export-track; }
            }
        }
        ActionWrap {
            Button {
                text: "Import";
                enabled: root.writable && root.has-session;
                clicked => { root.command("import", root.import-path); }
            }
            Button {
                text: "Export WAV";
                enabled: root.has-session && root.export-path != "";
                clicked => { root.command("export-wav", root.export-path); }
            }
            Button {
                text: "Export with gap silence";
                enabled: root.has-session && root.export-path != "";
                clicked => { root.command("export-wav-fill-gaps", root.export-path); }
            }
            Button {
                text: "Build waveform";
                enabled: root.has-session;
                clicked => { root.command("waveform", ""); }
            }
            Button {
                text: "Cancel waveform";
                variant: "ghost";
                clicked => { root.command("stop-waveform", ""); }
            }
        }

        Text {
            text: root.status-output;
            color: Theme.muted;
            font-size: 12px;
            line-height-factor: 1.4;
            wrap: word-wrap;
        }
        ScrollText { height: 150px; text: root.command-output; text-color: Theme.body; }
    }
}
