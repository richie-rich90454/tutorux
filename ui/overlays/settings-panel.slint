// Settings: appearance, archive-scoped configuration, diagnostics.
import { Button, ComboBox, LineEdit, Theme } from "../theme.slint";
import { PanelShell } from "./panel-shell.slint";

export component SettingsPanel inherits Rectangle {
    in property <string> archive-path;
    in-out property <string> theme-mode: "light";
    in-out property <string> shortcut-concept;
    in-out property <string> shortcut-mistake;
    in-out property <string> shortcut-correction;
    in-out property <string> shortcut-instruction;
    in-out property <string> shortcut-example;
    in-out property <string> shortcut-follow-up;
    in-out property <string> shortcut-note;
    in-out property <string> diagnostics-output;

    callback close();
    callback set-theme(string);
    callback save-shortcuts(string, string, string, string, string, string, string);
    callback diagnostics(string, string);

    width: 100%;
    height: 100%;
    background: transparent;

    PanelShell {
        available-width: root.width;
        available-height: root.height;
        heading: "Settings";
        detail: "Application, archive, and diagnostics";
        close => { root.close(); }

        VerticalLayout {
            spacing: 16px;

            Text { text: "Appearance"; color: Theme.ink; font-size: 15px; font-weight: 700; }
            HorizontalLayout {
                spacing: 12px;
                Text { text: "Theme"; color: Theme.body; font-size: 13px; vertical-alignment: center; }
                ComboBox {
                    model: ["light", "dark"];
                    current-value <=> root.theme-mode;
                    width: 160px;
                    horizontal-stretch: 0;
                    selected(value) => {
                        root.theme-mode = value;
                        root.set-theme(value);
                    }
                }
                Rectangle { }
            }

            Rectangle { height: 1px; background: Theme.line; }

            Text { text: "Archive-specific configuration"; color: Theme.ink; font-size: 15px; font-weight: 700; }
            Text {
                text: "Tutorux stores workspace settings in the selected .tux archive. API keys are read from environment variables unless you explicitly save an encrypted credential record.";
                color: Theme.muted;
                font-size: 12px;
                line-height-factor: 1.45;
                wrap: word-wrap;
            }
            Text {
                text: "settings list · settings get KEY · settings set --key KEY --value VALUE · archive verify --full";
                color: Theme.accent-text;
                font-size: 11.5px;
                wrap: word-wrap;
            }
            Text { text: "Quick marker keys (Control on Windows and Linux, Command on macOS)"; color: Theme.ink; font-size: 12.5px; font-weight: 600; }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { placeholder-text: "Concept"; text <=> root.shortcut-concept; }
                LineEdit { placeholder-text: "Mistake"; text <=> root.shortcut-mistake; }
                LineEdit { placeholder-text: "Correction"; text <=> root.shortcut-correction; }
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { placeholder-text: "Instruction"; text <=> root.shortcut-instruction; }
                LineEdit { placeholder-text: "Example"; text <=> root.shortcut-example; }
                LineEdit { placeholder-text: "Follow up"; text <=> root.shortcut-follow-up; }
                LineEdit { placeholder-text: "Note"; text <=> root.shortcut-note; }
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Save marker keys";
                    variant: "primary";
                    enabled: root.archive-path != "";
                    clicked => {
                        root.save-shortcuts(root.shortcut-concept, root.shortcut-mistake,
                            root.shortcut-correction, root.shortcut-instruction,
                            root.shortcut-example, root.shortcut-follow-up, root.shortcut-note);
                    }
                }
                Rectangle { }
            }

            Rectangle { height: 1px; background: Theme.line; }

            Text { text: "Diagnostics"; color: Theme.ink; font-size: 15px; font-weight: 700; }
            Text {
                text: "Inspect the integrity of the open archive, or export a JSON report for support. Nothing is uploaded.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Run diagnostics";
                    variant: "primary";
                    enabled: root.archive-path != "";
                    clicked => { root.diagnostics("run", ""); }
                }
                LineEdit { placeholder-text: "Report output path"; text <=> root.diagnostics-output; }
                Button {
                    text: "Export report";
                    enabled: root.archive-path != "" && root.diagnostics-output != "";
                    clicked => { root.diagnostics("report", root.diagnostics-output); }
                }
            }
            Text { text: "Tutorux · portable tutoring workbench"; color: Theme.faint; font-size: 11.5px; }
        }
    }
}
