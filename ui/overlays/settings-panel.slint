import { Button, ComboBox, LineEdit, Theme } from "../theme.slint";
import { ActionWrap, Field, FormWrap } from "../components/page-parts.slint";
import { PanelShell } from "./panel-shell.slint";

export component SettingsPanel inherits Rectangle {
    in property <string> archive-path;
    in property <bool> inline: false;
    in-out property <string> theme-mode: "light";
    in-out property <string> shortcut-concept;
    in-out property <string> shortcut-mistake;
    in-out property <string> shortcut-correction;
    in-out property <string> shortcut-instruction;
    in-out property <string> shortcut-example;
    in-out property <string> shortcut-follow-up;
    in-out property <string> shortcut-note;
    in-out property <string> diagnostics-output;

    callback close();
    callback set-theme(string);
    callback save-shortcuts(string, string, string, string, string, string, string);
    callback diagnostics(string, string);
    callback archive-action(string);

    width: 100%;
    height: 100%;
    background: transparent;

    PanelShell {
        available-width: root.width;
        available-height: root.height;
        inline: root.inline;
        heading: "Settings";
        detail: "Application, archive, and diagnostics";
        close => { root.close(); }

        Text { text: "Appearance"; color: Theme.ink; font-size: 16px; font-weight: 700; }
        FormWrap {
            Field {
                label: "Theme";
                max-width: 220px;
                ComboBox {
                    model: ["light", "dark", "system"];
                    current-value <=> root.theme-mode;
                    selected(value) => {
                        root.theme-mode = value;
                        root.set-theme(value);
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }

        Text { text: "Archive-specific configuration"; color: Theme.ink; font-size: 16px; font-weight: 700; }
        Text {
            text: "Tutorux stores workspace settings in the selected .tux archive. API keys are read from environment variables unless you explicitly save an encrypted credential record.";
            color: Theme.muted;
            font-size: 12px;
            line-height-factor: 1.45;
            wrap: word-wrap;
        }
        ActionWrap {
            Button {
                text: "Verify archive";
                enabled: root.archive-path != "";
                clicked => { root.archive-action("verify"); }
            }
            Button {
                text: "Compact archive";
                enabled: root.archive-path != "";
                clicked => { root.archive-action("compact"); }
            }
            Button {
                text: "Archive tools";
                enabled: root.archive-path != "";
                clicked => { root.archive-action("tools"); }
            }
            Button {
                text: "Developer console";
                clicked => { root.archive-action("console"); }
            }
        }

        Text {
            text: "Quick marker keys (Control on Windows and Linux, Command on macOS)";
            color: Theme.ink;
            font-size: 12px;
            font-weight: 600;
        }
        FormWrap {
            Field { label: "Concept"; LineEdit { placeholder-text: "Concept"; text <=> root.shortcut-concept; } }
            Field { label: "Mistake"; LineEdit { placeholder-text: "Mistake"; text <=> root.shortcut-mistake; } }
            Field { label: "Correction"; LineEdit { placeholder-text: "Correction"; text <=> root.shortcut-correction; } }
            Field { label: "Instruction"; LineEdit { placeholder-text: "Instruction"; text <=> root.shortcut-instruction; } }
            Field { label: "Example"; LineEdit { placeholder-text: "Example"; text <=> root.shortcut-example; } }
            Field { label: "Follow up"; LineEdit { placeholder-text: "Follow up"; text <=> root.shortcut-follow-up; } }
            Field { label: "Note"; LineEdit { placeholder-text: "Note"; text <=> root.shortcut-note; } }
        }
        ActionWrap {
            Button {
                text: "Save marker keys";
                variant: "primary";
                enabled: root.archive-path != "";
                clicked => {
                    root.save-shortcuts(root.shortcut-concept, root.shortcut-mistake,
                        root.shortcut-correction, root.shortcut-instruction,
                        root.shortcut-example, root.shortcut-follow-up, root.shortcut-note);
                }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }

        Text { text: "Diagnostics"; color: Theme.ink; font-size: 16px; font-weight: 700; }
        Text {
            text: "Inspect the integrity of the open archive, or export a JSON report for support. Nothing is uploaded.";
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        FormWrap {
            Field {
                label: "Report output";
                LineEdit { placeholder-text: "Report output path"; text <=> root.diagnostics-output; }
            }
        }
        ActionWrap {
            Button {
                text: "Run diagnostics";
                variant: "primary";
                enabled: root.archive-path != "";
                clicked => { root.diagnostics("run", ""); }
            }
            Button {
                text: "Export report";
                enabled: root.archive-path != "" && root.diagnostics-output != "";
                clicked => { root.diagnostics("report", root.diagnostics-output); }
            }
        }
        Text { text: "Tutorux · portable tutoring workbench"; color: Theme.faint; font-size: 12px; }
    }
}
