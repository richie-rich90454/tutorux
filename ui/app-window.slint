// Tutorux editorial workbench. The window binds the controller surface; each
// visual region lives in a focused component under panes/ or overlays/.
import { Button, CheckBox, ComboBox, LineEdit, ScrollArea, ScrollText, Theme } from "./theme.slint";
import { MarkerRow, MaterialRow, NoteRow, SessionRow, StudentRow } from "./models.slint";
import { Navigator } from "./panes/navigator.slint";
import { CommandBar } from "./panes/command-bar.slint";
import { SessionHeader } from "./panes/session-header.slint";
import { Notebook } from "./panes/notebook.slint";
import { TranscriptPane } from "./panes/transcript-pane.slint";
import { StudyGuidePane } from "./panes/study-guide-pane.slint";
import { SessionInspector } from "./panes/session-inspector.slint";
import { StudentPage } from "./panes/student-page.slint";
import { MaterialsPage } from "./panes/materials-page.slint";
import { RecordingTransport } from "./transport.slint";
import { ArchivePanel } from "./overlays/archive-panel.slint";
import { SettingsPanel } from "./overlays/settings-panel.slint";
import { RecordingPanel } from "./overlays/recording-panel.slint";
import { ConsentPanel } from "./overlays/consent-panel.slint";
import { AiPanel } from "./overlays/ai-panel.slint";
import { ConsolePanel } from "./overlays/console-panel.slint";
import { ExportPanel } from "./overlays/export-panel.slint";
import { NewSessionPanel } from "./overlays/new-session-panel.slint";
import { NewStudentPanel } from "./overlays/new-student-panel.slint";
import { PanelShell } from "./overlays/panel-shell.slint";
import { GuideDocumentEditor } from "./components/guide-document-editor.slint";
export component MainWindow inherits Window {
    title: root.selected-session-title == "" ? "Tutorux" : root.selected-session-title + " - Tutorux";
    preferred-width: 1600px;
    preferred-height: 930px;
    min-width: 940px;
    min-height: 600px;
    background: Theme.canvas;
    default-font-family: "Noto Sans";
    default-font-size: 14px;

    in-out property <string> archive-list;
    in-out property <[string]> archive-paths;
    in-out property <string> archive-path;
    in-out property <string> archive-name;
    in-out property <string> archive-passphrase;
    in-out property <string> new-archive-passphrase;
    in-out property <string> new-archive-description;
    in-out property <string> selected-archive;
    in-out property <string> archive-status;
    in-out property <bool> archive-writable: true;
    in-out property <bool> archive-busy: false;
    in-out property <bool> archive-recovery-needed: false;
    in-out property <bool> archive-recovery-recoverable: false;
    in-out property <bool> archive-recovery-tail-present: false;
    in-out property <bool> archive-header-repair-candidate: false;
    in-out property <bool> archive-header-repair-available: false;
    in-out property <string> archive-repair-copy-path;
    in-out property <string> archive-recovery-status;
    in-out property <string> sanitized-copy-output;
    in-out property <string> sanitized-copy-status: "Choose an output path and preview the copy.";
    in-out property <string> sanitized-copy-include-students;
    in-out property <string> sanitized-copy-exclude-students;
    in-out property <string> sanitized-copy-include-sessions;
    in-out property <string> sanitized-copy-exclude-sessions;
    in-out property <string> sanitized-copy-include-recording-tracks;
    in-out property <string> sanitized-copy-exclude-recording-tracks;
    in-out property <string> sanitized-copy-passphrase;
    in-out property <bool> sanitized-copy-include-recordings: false;
    in-out property <bool> sanitized-copy-include-private-annotations: false;
    in-out property <bool> sanitized-copy-include-generation-logs: false;
    in-out property <bool> sanitized-copy-include-credentials: false;
    in-out property <bool> sanitized-copy-ready: false;
    in-out property <string> students-text;
    in-out property <string> sessions-text;
    in-out property <[string]> session-options;
    in-out property <string> selected-session;
    in-out property <string> recording-microphone-device;
    in-out property <string> recording-playback-device;
    in-out property <string> recording-application-device;
    in-out property <string> recording-source: "microphone";
    in-out property <string> recording-durability: "default";
    in-out property <bool> recording-live-transcription-enabled: false;
    in-out property <string> recording-live-model-path;
    in-out property <string> recording-import-path;
    in-out property <string> recording-export-path;
    in-out property <string> recording-export-track;
    in-out property <bool> recording-consent-confirmed: false;
    in-out property <bool> recording-panel-open: false;
    in-out property <string> recording-status-output:
        "Select a session and check its recording status before continuing.";
    in-out property <string> recording-preflight-output: "Choose a microphone and check its input level before recording.";
    in-out property <int> recording-input-level: 0;
    in-out property <bool> recording-preflight-ready: false;
    in-out property <string> recording-preflight-device-id;
    in-out property <string> recording-preflight-requested-device-id;
    in-out property <[string]> guide-options;
    in-out property <string> selected-guide;
    in-out property <[string]> guide-block-options;
    in-out property <string> selected-guide-block;
    in-out property <string> guide-edit-text;
    in-out property <int> guide-edit-anchor: 0;
    in-out property <int> guide-edit-focus: 0;
    in-out property <string> guide-reference-id;
    in-out property <string> guide-block-kind: "paragraph";
    in-out property <string> guide-find-query;
    in-out property <string> guide-replace-text;
    in-out property <string> guide-provenance;
    in-out property <string> guide-export-path;
    in-out property <string> guide-export-format: "markdown";
    in-out property <string> guide-output;
    in-out property <bool> template-panel-open: false;
    in-out property <[string]> template-options;
    in-out property <string> selected-template;
    in-out property <string> template-name;
    in-out property <string> template-path;
    in-out property <string> template-output:
        "Open templates to list the guide templates in this archive.";
    in-out property <string> annotation-time: "00:00:00";
    in-out property <string> annotation-note;
    in-out property <string> asset-input-path;
    in-out property <[string]> asset-options;
    in-out property <string> selected-asset;
    in-out property <string> asset-preview-kind: "message";
    in-out property <string> asset-preview-description:
        "Choose a session, list its materials, then preview a selected file.";
    in-out property <string> asset-preview-body;
    in-out property <string> asset-preview-waveform;
    in-out property <image> asset-preview-image;
    in-out property <string> ai-provider-id: "openai";
    in-out property <string> ai-endpoint;
    in-out property <string> ai-model-id;
    in-out property <string> ai-model-path;
    in-out property <string> ai-package-job-id;
    in-out property <string> ai-api-key-environment: "OPENAI_API_KEY";
    in-out property <string> ai-confirmation-hash;
    in-out property <string> ai-package-path;
    in-out property <string> ai-response-path;
    in-out property <[string]> transcript-options;
    in-out property <string> selected-transcript;
    in-out property <string> transcript-edit-text;
    in-out property <string> transcript-provenance;
    in-out property <[string]> evidence-options;
    in-out property <string> selected-evidence;
    in-out property <string> evidence-output:
        "Select a session to extract or list its evidence.";
    in-out property <string> evidence-reject-reason;
    in-out property <string> shortcut-concept: "1";
    in-out property <string> shortcut-mistake: "2";
    in-out property <string> shortcut-correction: "3";
    in-out property <string> shortcut-instruction: "4";
    in-out property <string> shortcut-example: "5";
    in-out property <string> shortcut-follow-up: "6";
    in-out property <string> shortcut-note: "m";
    in-out property <string> status-message;
    in-out property <string> student-name;
    in-out property <string> student-grade;
    in-out property <string> student-subjects;
    in-out property <string> student-objectives;
    in-out property <string> student-difficulties;
    in-out property <string> student-notes;
    in-out property <[string]> student-options;
    in-out property <string> selected-student;
    in-out property <string> student-progress-skill;
    in-out property <string> student-progress-classification: "newly-observed";
    in-out property <string> student-progress-evidence-ids;
    in-out property <string> student-progress-reviewer;
    in-out property <string> student-progress-note;
    in-out property <string> student-progress-output: "Select a student to review learning history.";
    in-out property <string> student-profile-name;
    in-out property <string> student-profile-grade;
    in-out property <string> student-profile-subjects;
    in-out property <string> student-profile-objectives;
    in-out property <string> student-profile-difficulties;
    in-out property <string> student-profile-improvements;
    in-out property <string> student-profile-template;
    in-out property <string> student-profile-notes;
    in-out property <string> session-subject;
    in-out property <string> session-title;
    in-out property <string> session-objectives;
    in-out property <string> command-input;
    in-out property <string> command-output;
    in-out property <bool> command-running: false;
    in-out property <string> diagnostics-output;
    in-out property <bool> about-open: false;
    in-out property <string> active-view: "journal";
    in-out property <string> journal-query;
    in-out property <string> journal-sort: "Newest first";
    in-out property <string> journal-collection-filter: "All collections";
    in-out property <string> journal-tag-filter: "All tags";
    in-out property <[string]> journal-collection-options;
    in-out property <[string]> journal-tag-options;
    in-out property <string> journal-date-from;
    in-out property <string> journal-date-to;
    in-out property <string> journal-session-filter: "all";
    in-out property <string> journal-list-output;
    in-out property <[string]> journal-entry-options;
    in-out property <string> selected-journal-entry;
    in-out property <string> journal-timeline-output;
    in-out property <[string]> journal-session-options;
    in-out property <string> selected-journal-session;
    in-out property <string> journal-timeline-date;
    in-out property <bool> journal-session-expanded: false;
    in-out property <string> journal-session-detail-output: "Select a session and show its details.";
    in-out property <[string]> journal-session-student-options;
    in-out property <string> journal-session-student: "Anonymous session";
    in-out property <string> journal-session-new-student-name;
    in-out property <string> journal-session-new-student-grade;
    in-out property <string> journal-session-language: "auto";
    in-out property <string> journal-session-recording-source: "microphone";
    in-out property <[string]> journal-guide-template-options;
    in-out property <string> journal-session-template: "Use recommended template";
    in-out property <string> journal-guide-output:
        "Draft guides created from this entry will appear in Study guides.";
    in-out property <string> journal-entry-title;
    in-out property <string> journal-entry-date;
    in-out property <bool> journal-entry-create-open: false;
    in-out property <string> journal-entry-collections;
    in-out property <string> journal-entry-tags;
    in-out property <string> journal-entry-id;
    in-out property <bool> journal-entry-delete-confirmed: false;
    in-out property <string> journal-session-title;
    in-out property <string> journal-session-subject;
    in-out property <string> journal-session-objectives;
    in-out property <string> journal-session-type: "notes-only";
    in-out property <string> journal-session-id;
    in-out property <bool> journal-session-delete-confirmed: false;
    in-out property <bool> journal-session-delete-scope-reviewed: false;
    in-out property <string> journal-session-delete-preview-id;
    in-out property <string> journal-session-delete-scope-token;
    in-out property <string> journal-session-delete-scope-output:
        "Review the deletion scope before confirming.";
    in-out property <string> journal-document-id;
    in-out property <string> journal-document-text;
    in-out property <string> journal-document-blocks-json: "[]";
    in-out property <[string]> journal-note-block-options;
    in-out property <string> selected-journal-note-block;
    in-out property <string> journal-document-block-text;
    in-out property <string> journal-document-block-kind: "Paragraph";
    in-out property <int> journal-document-block-anchor-offset: 0;
    in-out property <int> journal-document-block-focus-offset: 0;
    property <bool> journal-inline-format-enabled:
        root.journal-document-block-count > 0 && root.journal-document-block-kind != "Code";
    in-out property <string> journal-document-new-block-text;
    in-out property <int> journal-document-block-index: -1;
    in-out property <int> journal-document-block-count: 0;
    in-out property <bool> journal-document-show-preview: false;
    in-out property <string> journal-item-name;
    in-out property <string> journal-item-id;
    in-out property <bool> journal-item-delete-confirmed: false;
    in-out property <string> journal-item-description;
    in-out property <string> journal-item-color;
    in-out property <string> theme-mode: "light";
    // Editorial workbench state
    in-out property <string> workbench-tab: "notebook";
    in-out property <string> navigator-scope: "sessions";
    in-out property <string> navigator-query;
    in-out property <bool> inspector-open: true;
    in-out property <bool> archive-menu-open: false;
    in-out property <bool> workspace-menu-open: false;
    in-out property <string> overlay-panel: "";
    in-out property <string> title-draft;
    in-out property <bool> title-editing: false;
    in-out property <string> details-student;
    in-out property <string> details-subject;
    in-out property <bool> details-editing: false;
    in-out property <bool> note-composer-open: false;
    in-out property <bool> guide-tools-open: false;
    in-out property <string> note-save-state: "saved";
    in-out property <string> selected-session-title;
    in-out property <string> selected-session-student;
    in-out property <string> selected-session-subject;
    in-out property <string> selected-session-started;
    in-out property <string> selected-session-state;
    in-out property <string> selected-session-student-choice;
    in-out property <string> session-package-path;
    in-out property <string> recording-state: "not-started";
    in-out property <int> recording-elapsed-seconds: 0;
    in-out property <[SessionRow]> session-rows: [];
    in-out property <[StudentRow]> student-rows: [];
    in-out property <[MaterialRow]> material-rows: [];
    in-out property <[NoteRow]> note-rows: [];
    in-out property <[MarkerRow]> marker-rows: [];
    forward-focus: marker-shortcuts;

    init => {
        Theme.mode = root.theme-mode;
        root.navigator-scope = "sessions";
        root.workbench-tab = "notebook";
    }
    changed theme-mode => { Theme.mode = root.theme-mode; }

    changed navigator-scope => {
        if (root.navigator-scope == "students" && root.selected-student != "" &&
                root.student-profile-name == "") {
            root.load-student-progress(root.selected-student);
        }
        if (root.navigator-scope == "materials" && root.selected-session != "") {
            root.asset-command(root.selected-session, "list", "");
        }
    }

    changed selected-journal-session => {
        root.journal-session-id = "";
        root.journal-session-expanded = false;
        root.recording-status-output =
            "Session selection changed. Check status before continuing capture.";
        root.journal-session-delete-confirmed = false;
        root.journal-session-delete-scope-reviewed = false;
        root.journal-session-delete-preview-id = "";
        root.journal-session-delete-scope-token = "";
    }
    changed selected-session => {
        root.asset-command(root.selected-session, "reset", "");
    }
    changed journal-session-id => {
        root.recording-status-output =
            "Session selection changed. Check status before continuing capture.";
        root.journal-session-delete-confirmed = false;
        root.journal-session-delete-scope-reviewed = false;
        root.journal-session-delete-preview-id = "";
        root.journal-session-delete-scope-token = "";
    }
    changed selected-journal-entry => {
        root.journal-entry-delete-confirmed = false;
    }
    changed journal-entry-id => {
        root.journal-entry-delete-confirmed = false;
    }
    changed journal-item-id => {
        root.journal-item-delete-confirmed = false;
    }
    changed template-panel-open => {
        if root.template-panel-open {
            root.template-command("list", "", "", "");
        }
    }
    changed journal-query => { root.schedule-journal-search(); }
    changed journal-sort => { root.schedule-journal-search(); }
    changed journal-collection-filter => { root.schedule-journal-search(); }
    changed journal-tag-filter => { root.schedule-journal-search(); }
    changed journal-date-from => { root.schedule-journal-search(); }
    changed journal-date-to => { root.schedule-journal-search(); }
    changed journal-session-filter => { root.schedule-journal-search(); }
    changed journal-session-type => {
        if root.journal-session-type == "notes-only" {
            root.journal-session-recording-source = "none";
            root.recording-source = "microphone";
        } else if root.journal-session-type == "import-recording" {
            root.journal-session-recording-source = "imported-file";
            root.recording-source = "microphone";
        } else {
            root.journal-session-recording-source = "microphone";
            root.recording-source = "microphone";
        }
    }
    changed selected-journal-note-block => {
        root.journal-action("document-block-select", root.journal-document-id,
            root.selected-journal-note-block, "", "", "", "");
    }
    changed sanitized-copy-output => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-students => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-exclude-students => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-sessions => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-exclude-sessions => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-recording-tracks => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-exclude-recording-tracks => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-recordings => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-private-annotations => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-generation-logs => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-credentials => { root.sanitized-copy-ready = false; }

    callback open-archive(string, string);
    callback archive-recovery-action(string);
    callback sanitized-copy(
        string, string, string, string, string, string, string,
        bool, bool, bool, bool, string, bool
    );
    callback forget-passphrase();
    callback create-archive(string, string, string);
    callback create-student(string, string, string, string, string, string);
    callback load-student-progress(string);
    callback review-student-progress(string, string, string, string, string, string);
    callback save-student-profile(string, string, string, string, string, string, string, string, string);
    callback create-session(string, string, string, string);
    callback journal-action(string, string, string, string, string, string, string);
    callback journal-session-create(string, string, string, string, string, string, string, string, string, string, string);
    callback open-session(string);
    callback review-transcript(string);
    callback load-transcript(string, string);
    callback save-transcript(string, string, string);
    callback evidence-command(string, string, string, string);
    callback quick-marker(string, string, string, string);
    callback recording-command(string, string, string);
    callback check-recording-device(string);
    pure callback accepts-dropped-files(data-transfer) -> bool;
    callback import-dropped-files(data-transfer);
    callback guide-command(string, string, string, string);
    callback template-command(string, string, string, string);
    callback diagnostics-command(string, string);
    callback compact-archive();
    callback asset-command(string, string, string);
    callback ai-command(string, string, string, string);
    callback load-guide-block(string, string);
    callback guide-edit-input-changed(string, int, int);
    callback guide-edit-selection-changed(int, int);
    callback find-guide-next(string);
    callback replace-guide-match(string, string);
    callback replace-all-guide-matches(string, string);
    callback insert-guide-markup(string, string);
    callback guide-edit-undo();
    callback guide-edit-redo();
    callback save-guide-block(string, string, string);
    callback save-marker-shortcuts(string, string, string, string, string, string, string);
    callback run-command(string, string);

    callback cancel-command();

    callback set-theme-mode(string);
    callback open-session-row(string);
    callback create-session-quick(string, string, string, string, string, string, string);
    callback rename-session(string, string);
    callback update-session-details(string, string, string);
    callback play-marker(string, int);
    callback export-session-package(string);

    function schedule-journal-search() {
        if (journal-search-timer.running) {
            journal-search-timer.restart();
        } else {
            journal-search-timer.start();
        }
    }

    function run-journal-search() {
        journal-search-timer.stop();
        root.journal-action("entry-list", root.journal-query,
            root.journal-collection-filter,
            root.journal-tag-filter,
            root.journal-date-from,
            root.journal-date-to,
            root.journal-session-filter);
    }

    journal-search-timer := Timer {
        interval: 260ms;
        running: false;
        triggered() => { root.run-journal-search(); }
    }

    pure function show-status() -> bool {
        return root.status-message != "" &&
               root.status-message != "Your tutoring data stays in the selected .tux archive." &&
               root.status-message != "Command completed.";
    }

    pure function matches(text: string, query: string) -> bool {
        if (query == "") {
            return true;
        }
        return text.to-lowercase().replace-all(query.to-lowercase(), "") != text.to-lowercase();
    }

    pure function pad2(value: int) -> string {
        return (value < 10 ? "0" : "") + (value * 1.0).to-fixed(0);
    }

    pure function elapsed-label() -> string {
        return pad2(root.recording-elapsed-seconds / 3600) + ":" +
               pad2(Math.mod(root.recording-elapsed-seconds / 60, 60)) + ":" +
               pad2(Math.mod(root.recording-elapsed-seconds, 60));
    }

    function notebook-action(action: string, argument: string) {
        if (action == "save") {
            root.journal-action("document-block-update",
                root.journal-document-id, root.selected-journal-note-block,
                root.journal-document-block-kind, root.journal-document-block-text,
                "", "");
        } else if (action == "format") {
            root.journal-action("document-block-format",
                root.journal-document-id, root.selected-journal-note-block,
                argument, "", "", "");
        } else if (action == "remove") {
            root.journal-action("document-block-remove",
                root.journal-document-id, root.selected-journal-note-block,
                "", "", "", "");
        } else if (action == "add") {
            root.journal-action("document-block-add",
                root.journal-document-id, root.journal-document-block-kind,
                root.journal-document-new-block-text, root.selected-journal-note-block,
                "", "");
        }
    }






    drop-area := DropArea {
        width: 100%;
        height: 100%;
        accessible-role: AccessibleRole.region;
        accessible-label: self.has-drag
            ? "Release the local files to import them into Tutorux."
            : "Tutorux file import. Drop local files anywhere in this window to add them to the selected archive.";
        accessible-live-region: AccessibleLiveness.polite;

        can-drop(event) => {
            root.accepts-dropped-files(event.data) ? DragAction.copy : DragAction.none
        }
        dropped(event) => {
            root.import-dropped-files(event.data);
            return event.proposed-action;
        }
    }

    marker-shortcuts := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape && root.overlay-panel != "") {
                root.overlay-panel = "";
                accept
            } else if (event.modifiers.control || event.modifiers.meta) && event.text == Key.K {
                navigator.focus-search-input();
                accept
            } else if event.modifiers.control && !event.repeat && root.selected-session != "" {
                if (event.text == root.shortcut-concept) {
                    root.quick-marker(root.selected-session, "important-concept",
                        root.elapsed-label(), root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-mistake) {
                    root.quick-marker(root.selected-session, "student-mistake",
                        root.elapsed-label(), root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-correction) {
                    root.quick-marker(root.selected-session, "tutor-correction",
                        root.elapsed-label(), root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-instruction) {
                    root.quick-marker(root.selected-session, "explicit-instruction",
                        root.elapsed-label(), root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-example) {
                    root.quick-marker(root.selected-session, "worked-example",
                        root.elapsed-label(), root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-follow-up) {
                    root.quick-marker(root.selected-session, "follow-up-priority",
                        root.elapsed-label(), root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-note) {
                    root.quick-marker(root.selected-session, "general-note",
                        root.elapsed-label(), root.annotation-note);
                    accept
                } else {
                    reject
                }
            } else {
                reject
            }
        }
    }

    Rectangle {
        background: Theme.canvas;

        HorizontalLayout {
            spacing: 0px;

            navigator := Navigator {
                archive-path: root.archive-path;
                archive-name: root.selected-archive;
                archive-status: root.archive-status;
                archive-busy: root.archive-busy;
                archive-writable: root.archive-writable;
                session-rows: root.session-rows;
                student-rows: root.student-rows;
                material-rows: root.material-rows;
                selected-session: root.selected-session;
                selected-student: root.selected-student;
                selected-asset: root.selected-asset;
                scope <=> root.navigator-scope;
                query <=> root.navigator-query;
                menu-open <=> root.archive-menu-open;

                select-session(id, choice) => {
                    root.selected-session = choice;
                    root.open-session-row(id);
                    root.workbench-tab = "notebook";
                    if (root.navigator-scope == "materials") {
                        root.asset-command(choice, "list", "");
                    }
                }
                select-student(choice) => {
                    root.selected-student = choice;
                    root.student-profile-name = "";
                    root.load-student-progress(choice);
                }
                preview-material(choice) => {
                    root.selected-asset = choice;
                    root.asset-command(root.selected-session, "preview", choice);
                }
                scope-changed(scope) => { }
                new-session() => { root.overlay-panel = "new-session"; }
                open-archive() => { root.overlay-panel = "archive"; }
                open-settings() => { root.overlay-panel = "settings"; }
            }

            Rectangle {
                background: Theme.canvas;

                VerticalLayout {
                    spacing: 0px;

                    CommandBar {
                        archive-path: root.archive-path;
                        archive-name: root.selected-archive;
                        session-title: root.selected-session-title;
                        inspector-open: root.inspector-open;
                        menu-open <=> root.workspace-menu-open;
                        action(command) => {
                            if (command == "focus-search") {
                                navigator.focus-search-input();
                            } else if (command == "toggle-details") {
                                root.inspector-open = !root.inspector-open;
                            } else if (command == "export") {
                                root.overlay-panel = "export";
                            } else if (command == "journal-tools") {
                                root.overlay-panel = "journal-tools";
                            } else if (command == "guide-editor") {
                                root.overlay-panel = "guide-tools";
                            } else if (command == "configure-audio") {
                                root.overlay-panel = "recording";
                            } else if (command == "guide-tools") {
                                root.workbench-tab = "guide";
                                root.guide-tools-open = true;
                            } else if (command == "ai") {
                                root.overlay-panel = "ai";
                            } else if (command == "console") {
                                root.overlay-panel = "console";
                            } else if (command == "settings") {
                                root.overlay-panel = "settings";
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.canvas;

                        // First launch
                        if root.archive-path == "" : Rectangle {
                            width: 100%;
                            height: 100%;
                            background: Theme.surface;

                            VerticalLayout {
                                x: max(48px, (parent.width - Theme.page-max-width) / 2);
                                y: (parent.height - self.height) / 2;
                                width: min(Theme.page-max-width, parent.width - 96px);
                                height: self.preferred-height;
                                vertical-stretch: 0;
                                spacing: 0px;

                                Text {
                                    text: "Portable workspace";
                                    color: Theme.accent;
                                    font-size: 12.5px;
                                    font-weight: 700;
                                    letter-spacing: 0.2px;
                                }
                                Rectangle { height: 16px; }
                                Text {
                                    text: "Open your tutoring archive.";
                                    color: Theme.ink;
                                    font-size: 30px;
                                    font-weight: 700;
                                    line-height-factor: 1.3;
                                }
                                Rectangle { height: 12px; }
                                Text {
                                    text: "Keep recordings, transcripts, notes, and study guides together in one portable file. Open an existing archive or create a new one in the current folder.";
                                    color: Theme.body;
                                    font-size: 14px;
                                    line-height-factor: 1.45;
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 26px; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Button {
                                        text: "Open archive";
                                        variant: "primary";
                                        clicked => { root.overlay-panel = "archive"; }
                                    }
                                    Button {
                                        text: "Create new archive";
                                        clicked => { root.overlay-panel = "archive"; }
                                    }
                                }
                                Rectangle { height: 30px; }
                                Text {
                                    text: "Tutorux stores session data inside the archive you choose. No account or background service is required to begin.";
                                    color: Theme.faint;
                                    font-size: 11.5px;
                                    line-height-factor: 1.4;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.archive-path != "" : VerticalLayout {
                            spacing: 0px;

                            if root.navigator-scope == "students" : StudentPage {
                                selected-student: root.selected-student;
                                progress-output: root.student-progress-output;
                                writable: root.archive-writable;
                                name <=> root.student-profile-name;
                                grade <=> root.student-profile-grade;
                                subjects <=> root.student-profile-subjects;
                                objectives <=> root.student-profile-objectives;
                                difficulties <=> root.student-profile-difficulties;
                                improvements <=> root.student-profile-improvements;
                                template <=> root.student-profile-template;
                                notes <=> root.student-profile-notes;
                                review-skill <=> root.student-progress-skill;
                                review-classification <=> root.student-progress-classification;
                                review-evidence <=> root.student-progress-evidence-ids;
                                review-reviewer <=> root.student-progress-reviewer;
                                review-note <=> root.student-progress-note;
                                save-profile => {
                                    root.save-student-profile(root.selected-student,
                                        root.student-profile-name, root.student-profile-grade,
                                        root.student-profile-subjects, root.student-profile-objectives,
                                        root.student-profile-difficulties, root.student-profile-improvements,
                                        root.student-profile-template, root.student-profile-notes);
                                }
                                review-progress => {
                                    root.review-student-progress(root.selected-student,
                                        root.student-progress-skill, root.student-progress-classification,
                                        root.student-progress-evidence-ids, root.student-progress-reviewer,
                                        root.student-progress-note);
                                }
                                load-history => { root.load-student-progress(root.selected-student); }
                                new-student => { root.overlay-panel = "new-student"; }
                            }

                            if root.navigator-scope == "materials" : MaterialsPage {
                                session-title: root.selected-session-title;
                                preview-kind: root.asset-preview-kind;
                                preview-description: root.asset-preview-description;
                                preview-body: root.asset-preview-body;
                                preview-waveform: root.asset-preview-waveform;
                                command-output: root.command-output;
                                preview-image: root.asset-preview-image;
                                input-path <=> root.asset-input-path;
                                selected-asset <=> root.selected-asset;
                                import-file(path) => { root.asset-command(root.selected-session, "add", path); }
                                list-materials => { root.asset-command(root.selected-session, "list", ""); }
                                preview(asset) => { root.asset-command(root.selected-session, "preview", asset); }
                            }

                            if root.navigator-scope == "sessions" : VerticalLayout {
                                spacing: 0px;

                                if root.selected-session-title == "" : Rectangle {
                                    background: Theme.surface;
                                    VerticalLayout {
                                        x: max(48px, (parent.width - Theme.page-max-width) / 2);
                                        y: (parent.height - self.height) / 2 - 24px;
                                        width: min(Theme.page-max-width, parent.width - 96px);
                                        spacing: 12px;
                                        Text { text: "No session selected."; color: Theme.ink; font-size: 30px; font-weight: 700; }
                                        Text {
                                            text: "Create a session to start the notebook, or choose one in the navigator.";
                                            color: Theme.body;
                                            font-size: 14px;
                                            line-height-factor: 1.45;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Button {
                                                text: "Create session";
                                                variant: "primary";
                                                clicked => { root.overlay-panel = "new-session"; }
                                            }
                                        }
                                    }
                                }

                                if root.selected-session-title != "" : VerticalLayout {
                                    spacing: 0px;

                                    SessionHeader {
                                        title: root.selected-session-title;
                                        student: root.selected-session-student;
                                        started: root.selected-session-started;
                                        state: root.selected-session-state;
                                        recording-state: root.recording-state;
                                        tab <=> root.workbench-tab;
                                        rename(title) => { root.rename-session(root.selected-session, title); }
                                        tab-changed(tab) => {
                                            if (tab == "transcript" && root.transcript-options.length == 0 &&
                                                    root.selected-session != "") {
                                                root.review-transcript(root.selected-session);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 100%;
                                        vertical-stretch: 1;
                                        background: Theme.surface;

                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            width: parent.width - (root.inspector-open ? Theme.inspector-width : 0px);
                                            height: 100%;
                                        if root.workbench-tab == "notebook" : Notebook {
                                            width: 100%;
                                            height: 100%;
                                            horizontal-stretch: 1;
                                            vertical-stretch: 1;
                                            rows: root.note-rows;
                                            document-id: root.journal-document-id;
                                            selected-block <=> root.selected-journal-note-block;
                                            block-text <=> root.journal-document-block-text;
                                            block-kind <=> root.journal-document-block-kind;
                                            inline-format-enabled: root.journal-inline-format-enabled;
                                            writable: root.archive-writable;
                                            save-state <=> root.note-save-state;
                                            new-block-text <=> root.journal-document-new-block-text;
                                            action(action, argument) => { root.notebook-action(action, argument); }
                                            open-journal-tools => { root.overlay-panel = "journal-tools"; }
                                        }

                                        if root.workbench-tab == "transcript" : TranscriptPane {
                                            width: 100%;
                                            height: 100%;
                                            horizontal-stretch: 1;
                                            vertical-stretch: 1;
                                            options: root.transcript-options;
                                            evidence-options: root.evidence-options;
                                            provenance: root.transcript-provenance;
                                            command-output: root.command-output;
                                            evidence-output: root.evidence-output;
                                            writable: root.archive-writable;
                                            has-session: root.selected-session != "";
                                            selected-segment <=> root.selected-transcript;
                                            selected-evidence <=> root.selected-evidence;
                                            edit-text <=> root.transcript-edit-text;
                                            reject-reason <=> root.evidence-reject-reason;
                                            load-segments => { root.review-transcript(root.selected-session); }
                                            load-segment => {
                                                root.load-transcript(root.selected-session, root.selected-transcript);
                                            }
                                            play => { root.recording-command(root.selected-session, "play-transcript", ""); }
                                            stop-playback => { root.recording-command(root.selected-session, "stop-playback", ""); }
                                            save => {
                                                root.save-transcript(root.selected-session,
                                                    root.selected-transcript, root.transcript-edit-text);
                                            }
                                            open-console => { root.overlay-panel = "console"; }
                                            evidence(action, reason) => {
                                                root.evidence-command(root.selected-session, action,
                                                    root.selected-evidence, reason);
                                            }
                                        }

                                        if root.workbench-tab == "guide" : StudyGuidePane {
                                            width: 100%;
                                            height: 100%;
                                            horizontal-stretch: 1;
                                            vertical-stretch: 1;
                                            guide-options: root.guide-options;
                                            block-options: root.guide-block-options;
                                            output: root.guide-output;
                                            writable: root.archive-writable;
                                            selected-guide <=> root.selected-guide;
                                            selected-block <=> root.selected-guide-block;
                                            edit-text <=> root.guide-edit-text;
                                            tools-open <=> root.guide-tools-open;
                                            load-block => {
                                                root.load-guide-block(root.selected-guide, root.selected-guide-block);
                                            }
                                            save-block => {
                                                root.save-guide-block(root.selected-guide,
                                                    root.selected-guide-block, root.guide-edit-text);
                                            }
                                            action(action) => { root.guide-command(root.selected-guide, action, "", ""); }
                                            open-ai => { root.overlay-panel = "ai"; }
                                            open-full-editor => { root.overlay-panel = "guide-tools"; }
                                        }                                        }
                                        if root.inspector-open : SessionInspector {
                                            x: parent.width - Theme.inspector-width;
                                            y: 0;
                                            width: Theme.inspector-width;
                                            height: 100%;
                                            student: root.selected-session-student;
                                            subject: root.selected-session-subject;
                                            started: root.selected-session-started;
                                            microphone: root.recording-microphone-device;
                                            source: root.recording-source;
                                            student-choice <=> root.selected-session-student-choice;
                                            elapsed-label: root.elapsed-label();
                                            student-options: root.journal-session-student-options;
                                            markers: root.marker-rows;
                                            marker-time <=> root.annotation-time;
                                            marker-note <=> root.annotation-note;
                                            update-details(choice, subject) => {
                                                root.update-session-details(root.selected-session, choice, subject);
                                            }
                                            open-recording => { root.overlay-panel = "recording"; }
                                            play-marker(startSeconds) => { root.play-marker(root.selected-session, startSeconds); }
                                            mark(type) => {
                                                root.quick-marker(root.selected-session, type,
                                                    root.annotation-time, root.annotation-note);
                                            }
                                        }                                    }

                                    RecordingTransport {
                                        state: root.recording-state;
                                        microphone: root.recording-microphone-device;
                                        writable: root.archive-writable;
                                        elapsed <=> root.recording-elapsed-seconds;
                                        command(action) => {
                                            root.recording-command(root.selected-session, action, "");
                                        }
                                        mark(time) => {
                                            root.quick-marker(root.selected-session, "general-note",
                                                time, root.annotation-note);
                                        }
                                        open-consent => { root.overlay-panel = "recording-consent"; }
                                        open-config => { root.overlay-panel = "recording"; }
                                    }

                                    if root.show-status() : Rectangle {
                                        height: 24px;
                                        background: Theme.surface;

                                        Rectangle {
                                            width: 100%;
                                            height: 1px;
                                            background: Theme.line;
                                        }

                                        Text {
                                            x: 20px;
                                            width: parent.width - 40px;
                                            height: parent.height;
                                            vertical-alignment: center;
                                            text: root.status-message;
                                            color: Theme.faint;
                                            font-size: 10.5px;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // One overlay at a time, above the workbench.
        if root.overlay-panel != "" : Rectangle {
            width: parent.width;
            height: parent.height;
            background: #0000002e;
            z: 100;

            TouchArea {
                clicked => { root.overlay-panel = ""; }
            }


            if root.overlay-panel == "journal-tools" : PanelShell {
                available-width: parent.width;
                available-height: parent.height;
                heading: "Journal tools";
                detail: "Entries, sessions, timeline, and structured notes";
                sheet-width: 1100px;
                close => { root.overlay-panel = ""; }

                VerticalLayout {
                    spacing: 16px;                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Journal";
                                    color: Theme.ink;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1.2px;
                                }
                                Text {
                                    text: "Entries and sessions";
                                    color: Theme.ink;
                                    font-size: 30px;
                                    font-weight: 700;
                                }
                            }
                            Rectangle { }
                            Button {
                                text: "+ New entry";
                                variant: "primary";
                                clicked => {
                                    root.journal-entry-title = "";
                                    root.journal-entry-date = "";
                                    root.journal-entry-collections = "";
                                    root.journal-entry-tags = "";
                                    root.journal-entry-create-open = true;
                                    root.status-message = "Add a title, then create the entry in the workspace.";
                                }
                            }
                        }

                        if root.journal-entry-create-open: Rectangle {
                            border-width: 1px;
                            border-color: Theme.line;
                            border-radius: 5px;
                            background: Theme.surface;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Text {
                                    text: "New journal entry";
                                    color: Theme.ink;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    legacy-journal-entry-title := LineEdit {
                                        placeholder-text: "Entry title";
                                        text <=> root.journal-entry-title;
                                        accessible-label: "New journal entry title";
                                    }
                                    LineEdit {
                                        placeholder-text: "Date YYYY-MM-DD (optional)";
                                        text <=> root.journal-entry-date;
                                        accessible-label: "New journal entry date";
                                    }
                                    Button {
                                        text: "Create entry";
                                        variant: "primary";
                                        enabled: root.journal-entry-title != "";
                                        clicked => {
                                            root.journal-action("entry-create",
                                                root.journal-entry-title,
                                                root.journal-entry-date,
                                                root.journal-entry-collections,
                                                root.journal-entry-tags,
                                                "", "");
                                        }
                                    }
                                    Button {
                                        text: "Cancel";
                                        clicked => { root.journal-entry-create-open = false; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-width: 1px;
                            border-color: Theme.line;
                            border-radius: 5px;
                            background: Theme.surface;
                            accessible-role: AccessibleRole.region;
                            accessible-label: "Journal search and filters";
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text {
                                    text: "Find an entry";
                                    color: Theme.ink;
                                    font-size: 15px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "Search titles, notes, transcripts, and guides";
                                        text <=> root.journal-query;
                                        accepted => { root.run-journal-search(); }
                                        accessible-label: "Search journal entries by title, notes, transcripts, and guides";
                                    }
                                    ComboBox {
                                        model: ["all", "with sessions", "without sessions"];
                                        current-value <=> root.journal-session-filter;
                                        accessible-label: "Filter entries by session presence";
                                    }
                                    Button {
                                        text: "Search";
                                        variant: "primary";
                                        clicked => { root.run-journal-search(); }
                                        accessible-label: "Search journal entries";
                                    }
                                    Button {
                                        text: "Collections";
                                        clicked => {
                                            root.journal-action("collection-list", "", "", "", "", "", "");
                                        }
                                        accessible-label: "Manage journal collections";
                                    }
                                    Button {
                                        text: "Tags";
                                        clicked => {
                                            root.journal-action("tag-list", "", "", "", "", "", "");
                                        }
                                        accessible-label: "Manage journal tags";
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ComboBox {
                                        model: ["Newest first", "Oldest first", "Title"];
                                        current-value <=> root.journal-sort;
                                        accessible-label: "Sort journal entries";
                                    }
                                    ComboBox {
                                        model: root.journal-collection-options;
                                        current-value <=> root.journal-collection-filter;
                                        accessible-label: "Filter entries by collection";
                                    }
                                    ComboBox {
                                        model: root.journal-tag-options;
                                        current-value <=> root.journal-tag-filter;
                                        accessible-label: "Filter entries by tag";
                                    }
                                    LineEdit {
                                        placeholder-text: "From YYYY-MM-DD";
                                        text <=> root.journal-date-from;
                                        accessible-label: "Filter entries from date";
                                    }
                                    LineEdit {
                                        placeholder-text: "To YYYY-MM-DD";
                                        text <=> root.journal-date-to;
                                        accessible-label: "Filter entries through date";
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 14px;
                            Rectangle {
                                width: 100%;
                                border-width: 1px;
                                border-color: Theme.line;
                                border-radius: 5px;
                                background: Theme.surface;
                                accessible-role: AccessibleRole.region;
                                accessible-label: "Journal entries";
                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 10px;
                                    Text {
                                        text: "Entries";
                                        color: Theme.ink;
                                        font-size: 17px;
                                        font-weight: 600;
                                    }
                                    if root.journal-entry-options.length > 0: ComboBox {
                                        model: root.journal-entry-options;
                                        current-value <=> root.selected-journal-entry;
                                        accessible-label: "Select a journal entry";
                                    }
                                    Button {
                                        text: "Open selected entry";
                                        enabled: root.selected-journal-entry != "";
                                        clicked => {
                                            root.journal-action("entry-show",
                                                root.selected-journal-entry,
                                                "", "", "", "", "");
                                        }
                                        accessible-label: "Open the selected journal entry";
                                    }
                                    ScrollText {
                                        height: 330px;
                                        text: root.journal-list-output;
                                        text-color: Theme.ink;
                                        accessible-label: "Journal search results";
                                        accessible-live-region: AccessibleLiveness.polite;
                                    }
                                    Text {
                                        text: "Newest entries appear first. Search and filters preserve this journal view.";
                                        color: Theme.ink;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 14px;
                                Rectangle {
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    border-radius: 5px;
                                    background: Theme.surface;
                                    accessible-role: AccessibleRole.region;
                                    accessible-label: "Journal entry workspace";
                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 9px;
                                        Text {
                                            text: "Entry workspace";
                                            color: Theme.ink;
                                            font-size: 17px;
                                            font-weight: 600;
                                        }
                                        LineEdit {
                                            placeholder-text: "Entry ID";
                                            text <=> root.journal-entry-id;
                                            accessible-label: "Journal entry identifier";
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Open entry";
                                                clicked => {
                                                    root.journal-action("entry-show",
                                                        root.journal-entry-id, "", "", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Update entry";
                                                clicked => {
                                                    root.journal-action("entry-update",
                                                        root.journal-entry-id,
                                                        root.journal-entry-title,
                                                        root.journal-entry-date,
                                                        root.journal-entry-collections,
                                                        root.journal-entry-tags, "");
                                                }
                                            }
                                            Button {
                                                text: "Clear date";
                                                clicked => {
                                                    root.journal-entry-date = "";
                                                    root.journal-action("entry-clear-date",
                                                        root.journal-entry-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Delete entry";
                                                variant: "danger";
                                                clicked => {
                                                    root.journal-action("entry-delete",
                                                        root.journal-entry-id, "", "", "", "", "");
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Title";
                                                text <=> root.journal-entry-title;
                                                accessible-label: "Journal entry title";
                                            }
                                            LineEdit {
                                                placeholder-text: "Entry date YYYY-MM-DD";
                                                text <=> root.journal-entry-date;
                                                accessible-label: "Journal entry date";
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Collection IDs, comma-separated";
                                                text <=> root.journal-entry-collections;
                                            }
                                            LineEdit {
                                                placeholder-text: "Tag IDs, comma-separated";
                                                text <=> root.journal-entry-tags;
                                            }
                                        }
                                        Button {
                                            text: "Create entry";
                                            clicked => {
                                                root.journal-action("entry-create",
                                                    root.journal-entry-title,
                                                    root.journal-entry-date,
                                                    root.journal-entry-collections,
                                                    root.journal-entry-tags,
                                                    "", "");
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    border-radius: 5px;
                                    background: Theme.surface;
                                    accessible-role: AccessibleRole.region;
                                    accessible-label: "Journal session timeline and controls";
                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 9px;
                                        Text {
                                            text: "Session timeline";
                                            color: Theme.ink;
                                            font-size: 17px;
                                            font-weight: 600;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Session date YYYY-MM-DD";
                                                text <=> root.journal-timeline-date;
                                                accessible-label: "Session timeline date";
                                            }
                                            Button {
                                                text: "Jump to date";
                                                clicked => {
                                                    root.journal-action("session-list", root.journal-entry-id,
                                                        root.journal-timeline-date, root.journal-timeline-date,
                                                        "", "", "");
                                                }
                                                accessible-label: "Show sessions on the selected date";
                                            }
                                            Button {
                                                text: "All dates";
                                                clicked => {
                                                    root.journal-timeline-date = "";
                                                    root.journal-action("session-list", root.journal-entry-id,
                                                        "", "", "", "", "");
                                                }
                                                accessible-label: "Show sessions from all dates";
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Session title";
                                                text <=> root.journal-session-title;
                                                accessible-label: "Session title";
                                            }
                                            ComboBox {
                                                model: ["notes-only", "record-audio", "import-recording"];
                                                current-value <=> root.journal-session-type;
                                                accessible-label: "New session mode";
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Subject";
                                                text <=> root.journal-session-subject;
                                            }
                                            LineEdit {
                                                placeholder-text: "Learning objectives";
                                                text <=> root.journal-session-objectives;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            ComboBox {
                                                model: root.journal-session-student-options;
                                                current-value <=> root.journal-session-student;
                                                accessible-label: "Student for the new session";
                                            }
                                            LineEdit {
                                                placeholder-text: "Language code, for example en or zh";
                                                text <=> root.journal-session-language;
                                                accessible-label: "Session language code";
                                            }
                                            ComboBox {
                                                model: root.journal-guide-template-options;
                                                current-value <=> root.journal-session-template;
                                                accessible-label: "Guide template for the new session";
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Capture source";
                                                color: Theme.ink;
                                                font-size: 12px;
                                            }
                                            if root.journal-session-type == "record-audio": ComboBox {
                                                model: ["microphone", "system-audio", "both", "application"];
                                                current-value <=> root.journal-session-recording-source;
                                                accessible-label: "Audio capture source for the new session";
                                            }
                                            if root.journal-session-type == "import-recording": ComboBox {
                                                model: ["imported-file"];
                                                current-value <=> root.journal-session-recording-source;
                                                accessible-label: "Recording source for the new session";
                                            }
                                            if root.journal-session-type == "notes-only": ComboBox {
                                                model: ["none"];
                                                current-value <=> root.journal-session-recording-source;
                                                accessible-label: "Recording source for the new session";
                                            }
                                        }
                                        if root.journal-session-student == "Create a new student": HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "New student name";
                                                text <=> root.journal-session-new-student-name;
                                                accessible-label: "New student name";
                                            }
                                            LineEdit {
                                                placeholder-text: "Grade or level";
                                                text <=> root.journal-session-new-student-grade;
                                                accessible-label: "New student grade or level";
                                            }
                                        }
                                        if root.journal-session-options.length > 0: ScrollArea {
                                            height: 170px;
                                            content-width: self.visible-width;
                                            content-height: max(self.visible-height,
                                                               legacy-session-list.preferred-height);
                                            legacy-session-list := VerticalLayout {
                                                width: parent.visible-width;
                                                spacing: 6px;
                                                for session in root.journal-session-options: Rectangle {
                                                    border-width: 1px;
                                                    border-color: Theme.line;
                                                    border-radius: 5px;
                                                    background: root.selected-journal-session == session ?
                                                Theme.accent-soft : Theme.surface;
                                                    VerticalLayout {
                                                        padding: 5px;
                                                        spacing: 4px;
                                                        Button {
                                                            text: session;
                                                            clicked => {
                                                                root.selected-journal-session = session;
                                                            }
                                                            accessible-label: "Select session " + session;
                                                        }
                                                        if root.selected-journal-session == session: HorizontalLayout {
                                                            spacing: 6px;
                                                            Button {
                                                                text: root.journal-session-expanded ? "Hide details" : "Show details";
                                                                clicked => {
                                                                    root.journal-session-expanded = !root.journal-session-expanded;
                                                                    if root.journal-session-expanded {
                                                                        root.journal-action("session-show", session,
                                                                            "", "", "", "", "");
                                                                    }
                                                                }
                                                                accessible-label: (root.journal-session-expanded ?
                                                                    "Hide details for session " :
                                                                    "Show details for session ") + session;
                                                            }
                                                            Button {
                                                                text: "Open session";
                                                                clicked => {
                                                                    root.open-session("Session 路 " + session);
                                                                }
                                                                accessible-label: "Open session " + session;
                                                            }
                                                            Button {
                                                                text: "Review transcript";
                                                                clicked => {
                                                                    root.review-transcript("Session 路 " + session);
                                                                }
                                                                accessible-label: "Review transcript for session " + session;
                                                            }
                                                            Button {
                                                                text: "Recording controls";
                                                                clicked => {
                                                                    root.selected-session = session;
                                                                    root.recording-panel-open = true;
                                                                }
                                                                accessible-label: "Open recording controls for session " + session;
                                                            }
                                                        }
                                                        if root.selected-journal-session == session && root.journal-session-expanded: Text {
                                                            text: root.journal-session-detail-output;
                                                            color: Theme.ink;
                                                            font-size: 11px;
                                                            wrap: word-wrap;
                                                            accessible-role: AccessibleRole.text;
                                                            accessible-label: "Expanded session details";
                                                            accessible-live-region: AccessibleLiveness.polite;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if root.journal-session-options.length == 0: Text {
                                            text: "No sessions are linked to this entry yet.";
                                            color: Theme.ink;
                                            font-size: 12px;
                                        }
                                        }
                                        LineEdit {
                                            placeholder-text: "Session ID";
                                            text <=> root.journal-session-id;
                                            accessible-label: "Session identifier";
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "New session";
                                                variant: "primary";
                                                clicked => {
                                                    root.journal-session-create(
                                                        root.journal-entry-id,
                                                        root.journal-session-type,
                                                        root.journal-session-title,
                                                        root.journal-session-student,
                                                        root.journal-session-subject,
                                                        root.journal-session-objectives,
                                                        root.journal-session-language,
                                                        root.journal-session-template,
                                                        root.journal-session-new-student-name,
                                                        root.journal-session-new-student-grade,
                                                        root.journal-session-recording-source);
                                                }
                                                accessible-label: "Create a new session in this journal entry";
                                            }
                                            Button {
                                                text: "Show timeline";
                                                clicked => {
                                                    root.journal-action("session-list",
                                                        root.journal-entry-id, root.journal-timeline-date,
                                                        root.journal-timeline-date, "", "", "");
                                                }
                                                accessible-label: "Refresh the session timeline";
                                            }
                                            Button {
                                                text: "Open session";
                                                clicked => {
                                                    root.open-session("Session 路 " +
                                                        (root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id));
                                                }
                                                accessible-label: "Open the selected session";
                                            }
                                            Button {
                                                text: "Review transcript";
                                                clicked => {
                                                    root.review-transcript("Session 路 " +
                                                        (root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id));
                                                }
                                                accessible-label: "Review the selected session transcript";
                                            }
                                            Button {
                                                text: "Recording / import controls";
                                                clicked => {
                                                    root.selected-session =
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id;
                                                    root.recording-panel-open = true;
                                                }
                                                accessible-label:
                                                    "Open recording or import controls for the selected session";
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Resume session";
                                                clicked => {
                                                    root.journal-action("session-resume",
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id,
                                                        "", "", "", "", "");
                                                }
                                                accessible-label: "Resume the selected session";
                                            }
                                            Button {
                                                text: "Complete session";
                                                clicked => {
                                                    root.journal-action("session-complete",
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id,
                                                        "", "", "", "", "");
                                                }
                                                accessible-label: "Complete the selected session";
                                            }
                                            Button {
                                                text: "Mark reviewed";
                                                clicked => {
                                                    root.journal-action("session-review",
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id,
                                                        "", "", "", "", "");
                                                }
                                                accessible-label: "Mark the selected session as reviewed";
                                            }
                                        }
                                        CheckBox {
                                            text: "I reviewed the deletion scope and want to remove this session.";
                                            checked <=> root.journal-session-delete-confirmed;
                                            enabled: root.journal-session-delete-scope-reviewed &&
                                                     (root.journal-session-id == "" ?
                                                         root.selected-journal-session :
                                                         root.journal-session-id) ==
                                                         root.journal-session-delete-preview-id;
                                        }
                                        ScrollText {
                                            height: 92px;
                                            text: root.journal-session-delete-scope-output;
                                            text-color: Theme.ink;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Review deletion scope";
                                                clicked => {
                                                    root.journal-session-delete-confirmed = false;
                                                    root.journal-session-delete-scope-reviewed = false;
                                                    root.journal-session-delete-preview-id = "";
                                                    root.journal-action("session-delete-preview",
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Confirm session deletion";
                                                variant: "danger";
                                                enabled: root.journal-session-delete-confirmed &&
                                                    root.journal-session-delete-scope-reviewed &&
                                                    (root.journal-session-id == "" ?
                                                        root.selected-journal-session :
                                                        root.journal-session-id) ==
                                                        root.journal-session-delete-preview-id;
                                                clicked => {
                                                    root.journal-action("session-delete-confirm",
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id,
                                                        root.journal-session-delete-scope-token,
                                                        "", "", "", "");
                                                    root.journal-session-delete-confirmed = false;
                                                }
                                            }
                                        }
                                        Text {
                                            text: "Audio starts only after microphone access, input level, and consent are confirmed.";
                                            color: Theme.ink;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.journal-timeline-output;
                                            color: Theme.ink;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                            accessible-role: AccessibleRole.text;
                                            accessible-label: "Session timeline results";
                                            accessible-live-region: AccessibleLiveness.polite;
                                        }
                                    }
                                }

                                Rectangle {
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    border-radius: 5px;
                                    background: Theme.surface;
                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 9px;
                                        Text {
                                            text: "Entry notes";
                                            color: Theme.ink;
                                            font-size: 17px;
                                            font-weight: 600;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Notes document ID";
                                                text <=> root.journal-document-id;
                                                enabled: root.journal-entry-id != "";
                                            }
                                            Button {
                                                text: "Load notes";
                                                enabled: root.journal-document-id != "";
                                                clicked => {
                                                    root.journal-action("document-show",
                                                        root.journal-document-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                        }
                                        Text {
                                            text: "Notes are edited as separate blocks, so each block keeps its type and identity.";
                                            color: Theme.ink;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: "Block"; color: Theme.ink; font-size: 12px; }
                                            ComboBox {
                                                model: root.journal-note-block-options;
                                                current-value <=> root.selected-journal-note-block;
                                                enabled: root.journal-document-block-count > 0;
                                            }
                                            Text { text: "Type"; color: Theme.ink; font-size: 12px; }
                                            ComboBox {
                                                model: ["Paragraph", "Heading", "Bulleted list",
                                                        "Numbered list", "Checklist", "Quote", "Code"];
                                                current-value <=> root.journal-document-block-kind;
                                                enabled: root.journal-document-block-count > 0;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: "Format selection";
                                                color: Theme.ink;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                            Button {
                                                text: "Bold";
                                                enabled: root.journal-inline-format-enabled;
                                                clicked => {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "bold", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Italic";
                                                enabled: root.journal-inline-format-enabled;
                                                clicked => {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "italic", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Strike";
                                                enabled: root.journal-inline-format-enabled;
                                                clicked => {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "strike", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Code";
                                                enabled: root.journal-inline-format-enabled;
                                                clicked => {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "code", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Link";
                                                enabled: root.journal-inline-format-enabled;
                                                clicked => {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "link", "", "", "");
                                                }
                                            }
                                        }
                                        Text {
                                            text: "Select text to format, or place the cursor to insert a span. Formatting uses portable Markdown; Ctrl+B, Ctrl+I, and Ctrl+K also work. Save the block to keep your edits.";
                                            color: Theme.ink;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                        TextInput {
                                            height: 160px;
                                            single-line: false;
                                            wrap: word-wrap;
                                            text <=> root.journal-document-block-text;
                                            font-size: 13px;
                                            color: Theme.ink;
                                            enabled: root.journal-document-block-count > 0;
                                            edited => { root.journal-document-block-text = self.text; }
                                            cursor-position-changed(position) => {
                                                root.journal-document-block-anchor-offset =
                                                    self.anchor-position-byte-offset;
                                                root.journal-document-block-focus-offset =
                                                    self.cursor-position-byte-offset;
                                            }
                                            key-pressed(event) => {
                                                if (root.journal-inline-format-enabled &&
                                                    (event.modifiers.control || event.modifiers.meta) &&
                                                    event.text == Key.B) {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "bold", "", "", "");
                                                    accept
                                                } else if (root.journal-inline-format-enabled &&
                                                           (event.modifiers.control ||
                                                            event.modifiers.meta) &&
                                                           event.text == Key.I) {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "italic", "", "", "");
                                                    accept
                                                } else if (root.journal-inline-format-enabled &&
                                                           (event.modifiers.control ||
                                                            event.modifiers.meta) &&
                                                           event.text == Key.K) {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "link", "", "", "");
                                                    accept
                                                } else {
                                                    reject
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Save block";
                                                enabled: root.journal-document-id != "" &&
                                                    root.selected-journal-note-block != "";
                                                clicked => {
                                                    root.journal-action("document-block-update",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        root.journal-document-block-kind,
                                                        root.journal-document-block-text,
                                                        "", "");
                                                }
                                            }
                                            Button {
                                                text: "Move up";
                                                enabled: root.journal-document-block-index > 0;
                                                clicked => {
                                                    root.journal-action("document-block-move",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "up", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Move down";
                                                enabled: root.journal-document-block-index >= 0 &&
                                                    root.journal-document-block-index + 1 <
                                                        root.journal-document-block-count;
                                                clicked => {
                                                    root.journal-action("document-block-move",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "down", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Remove block";
                                                variant: "danger";
                                                enabled: root.journal-document-id != "" &&
                                                    root.selected-journal-note-block != "";
                                                clicked => {
                                                    root.journal-action("document-block-remove",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "", "", "", "");
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: "Add a block"; color: Theme.ink; font-size: 12px; }
                                            Button {
                                                text: "Add block";
                                                enabled: root.journal-document-id != "" &&
                                                    root.journal-document-new-block-text != "";
                                                clicked => {
                                                    root.journal-action("document-block-add",
                                                        root.journal-document-id,
                                                        root.journal-document-block-kind,
                                                        root.journal-document-new-block-text,
                                                        root.selected-journal-note-block,
                                                        "", "");
                                                }
                                            }
                                        }
                                        TextInput {
                                            height: 90px;
                                            single-line: false;
                                            wrap: word-wrap;
                                            text <=> root.journal-document-new-block-text;
                                            font-size: 13px;
                                            color: Theme.ink;
                                            enabled: root.journal-document-id != "";
                                            edited => {
                                                root.journal-document-new-block-text = self.text;
                                            }
                                        }
                                        CheckBox {
                                            text: "Show saved notes as a whole document";
                                            checked <=> root.journal-document-show-preview;
                                        }
                                        if root.journal-document-show-preview: ScrollText {
                                            height: 100px;
                                            text: root.journal-document-text;
                                            text-color: Theme.ink;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Generate guide from this entry";
                                                clicked => {
                                                    root.journal-action("guide-generate-entry",
                                                        root.journal-entry-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Open study guides";
                                                clicked => { root.overlay-panel = "guide-tools"; }
                                            }
                                        }
                                        Text {
                                            text: root.journal-guide-output;
                                            color: Theme.ink;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                Rectangle {
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    border-radius: 5px;
                                    background: Theme.surface;
                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 9px;
                                        Text {
                                            text: "Organize this journal";
                                            color: Theme.ink;
                                            font-size: 17px;
                                            font-weight: 600;
                                        }
                                        LineEdit {
                                            placeholder-text: "Collection or tag ID";
                                            text <=> root.journal-item-id;
                                        }
                                        LineEdit {
                                            placeholder-text: "Collection or tag name";
                                            text <=> root.journal-item-name;
                                        }
                                        LineEdit {
                                            placeholder-text: "Description";
                                            text <=> root.journal-item-description;
                                        }
                                        LineEdit {
                                            placeholder-text: "Color, optional";
                                            text <=> root.journal-item-color;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Add collection";
                                                clicked => {
                                                    root.journal-action("collection-create",
                                                        root.journal-item-name,
                                                        root.journal-item-description,
                                                        root.journal-item-color,
                                                        "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Add tag";
                                                clicked => {
                                                    root.journal-action("tag-create",
                                                        root.journal-item-name,
                                                        root.journal-item-description,
                                                        root.journal-item-color,
                                                        "", "", "");
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Update collection";
                                                clicked => {
                                                    root.journal-action("collection-update",
                                                        root.journal-item-id,
                                                        root.journal-item-name,
                                                        root.journal-item-description,
                                                        root.journal-item-color,
                                                        "", "");
                                                }
                                            }
                                            Button {
                                                text: "Update tag";
                                                clicked => {
                                                    root.journal-action("tag-update",
                                                        root.journal-item-id,
                                                        root.journal-item-name,
                                                        root.journal-item-description,
                                                        root.journal-item-color,
                                                        "", "");
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Delete collection";
                                                variant: "danger";
                                                clicked => {
                                                    root.journal-action("collection-delete",
                                                        root.journal-item-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Delete tag";
                                                variant: "danger";
                                                clicked => {
                                                    root.journal-action("tag-delete",
                                                        root.journal-item-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                        }
                                    }
                                }
                            }                }
            }

            if root.overlay-panel == "guide-tools" : PanelShell {
                available-width: parent.width;
                available-height: parent.height;
                heading: "Guide editor";
                detail: "Review, edit, validate, template, and export the study guide";
                sheet-width: 1100px;
                close => { root.overlay-panel = ""; }

                VerticalLayout {
                    spacing: 14px;                                Text {
                                    text: "Guide review and export";
                                    color: Theme.ink;
                                    font-size: 16px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Review source-linked content, validate it, explicitly approve " +
                                          "the guide, then export a copy.";
                                    color: Theme.ink;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                if root.guide-options.length > 0: ComboBox {
                                    model: root.guide-options;
                                    current-value <=> root.selected-guide;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    if root.guide-block-options.length > 0: ComboBox {
                                        model: root.guide-block-options;
                                        current-value <=> root.selected-guide-block;
                                    }
                                    Button {
                                        text: "Load block";
                                        clicked => {
                                            root.load-guide-block(root.selected-guide,
                                                root.selected-guide-block);
                                        }
                                    }
                                    Button {
                                        text: "Save reviewed block";
                                        clicked => {
                                            root.save-guide-block(root.selected-guide,
                                                root.selected-guide-block, root.guide-edit-text);
                                        }
                                    }
                                }
                                Text {
                                    text: root.guide-provenance;
                                    color: Theme.ink;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        width: 270px;
                                        placeholder-text: "Source or asset UUID";
                                        text <=> root.guide-reference-id;
                                    }
                                    Button {
                                        text: "Insert source";
                                        clicked => {
                                            root.insert-guide-markup("source",
                                                                     root.guide-reference-id);
                                        }
                                    }
                                    Button {
                                        text: "Insert image";
                                        clicked => {
                                            root.insert-guide-markup("image",
                                                                     root.guide-reference-id);
                                        }
                                    }
                                    Button {
                                        text: "Code";
                                        clicked => { root.insert-guide-markup("code", ""); }
                                    }
                                    Button {
                                        text: "Equation";
                                        clicked => { root.insert-guide-markup("equation", ""); }
                                    }
                                    Button {
                                        text: "Table";
                                        clicked => { root.insert-guide-markup("table", ""); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    ComboBox {
                                        model: ["paragraph", "list-item", "quote", "code", "equation",
                                            "table", "image", "figure", "example", "instruction",
                                            "recommendation", "worked-example"];
                                        current-value <=> root.guide-block-kind;
                                    }
                                    Button {
                                        text: "Set block type";
                                        clicked => {
                                            root.insert-guide-markup(root.guide-block-kind, "");
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        placeholder-text: "Find in this block";
                                        text <=> root.guide-find-query;
                                    }
                                    Button {
                                        text: "Find next";
                                        clicked => {
                                            root.find-guide-next(root.guide-find-query);
                                        }
                                    }
                                    Button {
                                        text: "Replace";
                                        clicked => {
                                            root.replace-guide-match(root.guide-find-query,
                                                root.guide-replace-text);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        placeholder-text: "Replace with";
                                        text <=> root.guide-replace-text;
                                    }
                                    Button {
                                        text: "Replace all";
                                        clicked => {
                                            root.replace-all-guide-matches(root.guide-find-query,
                                                root.guide-replace-text);
                                        }
                                    }
                                }
                                guide-editor-text-input := GuideDocumentEditor {
                                    height: 170px;
                                    text <=> root.guide-edit-text;
                                    anchor-offset <=> root.guide-edit-anchor;
                                    focus-offset <=> root.guide-edit-focus;
                                    edited(text, focus, anchor) => {
                                        root.guide-edit-input-changed(text, focus, anchor);
                                    }
                                    selection-changed(focus, anchor) => {
                                        root.guide-edit-anchor = anchor;
                                        root.guide-edit-focus = focus;
                                        root.guide-edit-selection-changed(focus, anchor);
                                    }
                                    undo-requested => { root.guide-edit-undo(); }
                                    redo-requested => { root.guide-edit-redo(); }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Open guide";
                                        clicked => {
                                            root.guide-command(root.selected-guide, "show", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Validate sources";
                                        clicked => {
                                            root.guide-command(root.selected-guide, "validate", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Approve guide";
                                        variant: "primary";
                                        clicked => {
                                            root.guide-command(root.selected-guide, "approve", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Compare revisions";
                                        clicked => {
                                            root.guide-command(root.selected-guide, "compare", "", "");
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Regenerate this section";
                                        clicked => {
                                            root.guide-command(root.selected-guide,
                                                "regenerate-section", "", "");
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Add example";
                                        clicked => {
                                            root.guide-command(root.selected-guide,
                                                "add-example", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Remove block";
                                        clicked => {
                                            root.guide-command(root.selected-guide,
                                                "remove-block", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Move section up";
                                        clicked => {
                                            root.guide-command(root.selected-guide,
                                                "move-section-up", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Move section down";
                                        clicked => {
                                            root.guide-command(root.selected-guide,
                                                "move-section-down", "", "");
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ComboBox {
                                        model: ["markdown", "html", "json", "pdf", "docx"];
                                        current-value <=> root.guide-export-format;
                                    }
                                    LineEdit {
                                        placeholder-text: "Export file path";
                                        text <=> root.guide-export-path;
                                    }
                                    Button {
                                        text: "Export";
                                        variant: "primary";
                                        clicked => {
                                            root.guide-command(root.selected-guide, "export",
                                                root.guide-export-format, root.guide-export-path);
                                        }
                                    }
                                }
                                ScrollText {
                                    height: 260px;
                                    text: root.guide-output;
                                    text-color: Theme.ink;
                                }                }
            }
            if root.overlay-panel == "archive" : ArchivePanel {
                archive-path: root.archive-path;
                archive-list: root.archive-list;
                archive-paths: root.archive-paths;
                recovery-needed: root.archive-recovery-needed;
                recovery-recoverable: root.archive-recovery-recoverable;
                recovery-tail-present: root.archive-recovery-tail-present;
                header-repair-candidate: root.archive-header-repair-candidate;
                header-repair-available: root.archive-header-repair-available;
                recovery-status: root.archive-recovery-status;
                sanitized-copy-ready: root.sanitized-copy-ready;
                sanitized-copy-status: root.sanitized-copy-status;
                selected-archive <=> root.selected-archive;
                passphrase <=> root.archive-passphrase;
                new-passphrase <=> root.new-archive-passphrase;
                name <=> root.archive-name;
                description <=> root.new-archive-description;
                repair-copy-path <=> root.archive-repair-copy-path;
                sanitized-output <=> root.sanitized-copy-output;
                include-students <=> root.sanitized-copy-include-students;
                exclude-students <=> root.sanitized-copy-exclude-students;
                include-sessions <=> root.sanitized-copy-include-sessions;
                exclude-sessions <=> root.sanitized-copy-exclude-sessions;
                include-tracks <=> root.sanitized-copy-include-recording-tracks;
                exclude-tracks <=> root.sanitized-copy-exclude-recording-tracks;
                include-recordings <=> root.sanitized-copy-include-recordings;
                include-private-annotations <=> root.sanitized-copy-include-private-annotations;
                include-generation-logs <=> root.sanitized-copy-include-generation-logs;
                include-credentials <=> root.sanitized-copy-include-credentials;
                sanitized-passphrase <=> root.sanitized-copy-passphrase;
                close => { root.overlay-panel = ""; }
                open(path, passphrase) => { root.open-archive(path, passphrase); }
                forget => { root.forget-passphrase(); }
                create(name, passphrase, description) => {
                    root.create-archive(name, passphrase, description);
                }
                recovery(action) => { root.archive-recovery-action(action); }
                sanitize(out, incStudents, excStudents, incSessions, excSessions,
                         incTracks, excTracks, recordings, annotations, logs, credentials,
                         passphrase, confirm) => {
                    root.sanitized-copy(out, incStudents, excStudents, incSessions, excSessions,
                        incTracks, excTracks, recordings, annotations, logs, credentials,
                        passphrase, confirm);
                }
                compact => { root.compact-archive(); }
                verify => { root.diagnostics-command("archive", ""); }
            }

            if root.overlay-panel == "settings" : SettingsPanel {
                archive-path: root.archive-path;
                theme-mode <=> root.theme-mode;
                shortcut-concept <=> root.shortcut-concept;
                shortcut-mistake <=> root.shortcut-mistake;
                shortcut-correction <=> root.shortcut-correction;
                shortcut-instruction <=> root.shortcut-instruction;
                shortcut-example <=> root.shortcut-example;
                shortcut-follow-up <=> root.shortcut-follow-up;
                shortcut-note <=> root.shortcut-note;
                diagnostics-output <=> root.diagnostics-output;
                close => { root.overlay-panel = ""; }
                set-theme(mode) => { root.set-theme-mode(mode); }
                save-shortcuts(a, b, c, d, e, f, g) => {
                    root.save-marker-shortcuts(a, b, c, d, e, f, g);
                }
                diagnostics(action, path) => { root.diagnostics-command(action, path); }
            }

            if root.overlay-panel == "recording" : RecordingPanel {
                has-session: root.selected-session != "";
                writable: root.archive-writable;
                preflight-output: root.recording-preflight-output;
                input-level: root.recording-input-level;
                status-output: root.recording-status-output;
                command-output: root.command-output;
                source <=> root.recording-source;
                microphone <=> root.recording-microphone-device;
                playback <=> root.recording-playback-device;
                application <=> root.recording-application-device;
                import-path <=> root.recording-import-path;
                export-path <=> root.recording-export-path;
                export-track <=> root.recording-export-track;
                consent <=> root.recording-consent-confirmed;
                live-transcription <=> root.recording-live-transcription-enabled;
                live-model-path <=> root.recording-live-model-path;
                durability <=> root.recording-durability;
                close => { root.overlay-panel = ""; }
                command(action, argument) => {
                    root.recording-command(root.selected-session, action, argument);
                }
                check-device => { root.check-recording-device(root.recording-microphone-device); }
            }

            if root.overlay-panel == "recording-consent" : ConsentPanel {
                preflight-output: root.recording-preflight-output;
                input-level: root.recording-input-level;
                writable: root.archive-writable;
                has-session: root.selected-session != "";
                source: root.recording-source;
                consent <=> root.recording-consent-confirmed;
                close => { root.overlay-panel = ""; }
                check-device => { root.check-recording-device(root.recording-microphone-device); }
                start => {
                    root.overlay-panel = "";
                    root.recording-command(root.selected-session, "start", root.recording-source);
                }
            }

            if root.overlay-panel == "ai" : AiPanel {
                has-session: root.selected-session != "";
                output: root.command-output;
                provider <=> root.ai-provider-id;
                endpoint <=> root.ai-endpoint;
                model-id <=> root.ai-model-id;
                model-path <=> root.ai-model-path;
                package-job-id <=> root.ai-package-job-id;
                api-key-environment <=> root.ai-api-key-environment;
                confirmation-hash <=> root.ai-confirmation-hash;
                package-path <=> root.ai-package-path;
                response-path <=> root.ai-response-path;
                close => { root.overlay-panel = ""; }
                command(provider, action, path) => {
                    root.ai-command(provider, action, root.selected-session, path);
                }
            }

            if root.overlay-panel == "console" : ConsolePanel {
                running: root.command-running;
                output: root.command-output;
                input <=> root.command-input;
                close => { root.overlay-panel = ""; }
                run(input) => { root.run-command(input, root.new-archive-passphrase); }
                cancel => { root.cancel-command(); }
            }

            if root.overlay-panel == "export" : ExportPanel {
                guide-options: root.guide-options;
                has-session: root.selected-session != "";
                selected-guide <=> root.selected-guide;
                guide-format <=> root.guide-export-format;
                guide-path <=> root.guide-export-path;
                wav-path <=> root.recording-export-path;
                wav-track <=> root.recording-export-track;
                session-path <=> root.session-package-path;
                close => { root.overlay-panel = ""; }
                export-guide(guide, format, path) => {
                    root.guide-command(guide, "export", format, path);
                }
                export-wav(path) => {
                    root.recording-command(root.selected-session, "export-wav", path);
                }
                export-session(path) => { root.export-session-package(path); }
            }

            if root.overlay-panel == "new-session" : NewSessionPanel {
                student-options: root.journal-session-student-options;
                template-options: root.journal-guide-template-options;
                status: root.status-message;
                can-create: root.journal-session-title != "" && root.archive-path != "" &&
                            (root.journal-session-student != "Create a new student" ||
                             root.journal-session-new-student-name != "");
                title <=> root.journal-session-title;
                subject <=> root.journal-session-subject;
                type <=> root.journal-session-type;
                student <=> root.journal-session-student;
                objectives <=> root.journal-session-objectives;
                template <=> root.journal-session-template;
                new-student-name <=> root.journal-session-new-student-name;
                new-student-grade <=> root.journal-session-new-student-grade;
                close => { root.overlay-panel = ""; }
                create => {
                    root.create-session-quick(root.journal-session-title,
                        root.journal-session-subject, root.journal-session-type,
                        root.journal-session-student, root.journal-session-objectives,
                        root.journal-session-new-student-name,
                        root.journal-session-new-student-grade);
                    root.overlay-panel = "";
                }
            }

            if root.overlay-panel == "new-student" : NewStudentPanel {
                can-create: root.student-name != "" && root.archive-path != "";
                name <=> root.student-name;
                grade <=> root.student-grade;
                subjects <=> root.student-subjects;
                objectives <=> root.student-objectives;
                difficulties <=> root.student-difficulties;
                notes <=> root.student-notes;
                close => { root.overlay-panel = ""; }
                create => {
                    root.create-student(root.student-name, root.student-grade,
                        root.student-subjects, root.student-objectives,
                        root.student-difficulties, root.student-notes);
                    root.overlay-panel = "";
                }
            }
        }
    }
}
