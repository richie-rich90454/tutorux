    marker-shortcuts := FocusScope {
        capture-key-pressed(event) => {
            if event.modifiers.control && !event.repeat &&
                    (root.active-view == "sessions" || root.active-view == "recording") {
                if (event.text == root.shortcut-concept) {
                    root.quick-marker(root.selected-session, "important-concept",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-mistake) {
                    root.quick-marker(root.selected-session, "student-mistake",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-correction) {
                    root.quick-marker(root.selected-session, "tutor-correction",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-instruction) {
                    root.quick-marker(root.selected-session, "explicit-instruction",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-example) {
                    root.quick-marker(root.selected-session, "worked-example",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-follow-up) {
                    root.quick-marker(root.selected-session, "follow-up-priority",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-note) {
                    root.quick-marker(root.selected-session, "general-note", root.annotation-time,
                        root.annotation-note);
                    accept
                } else {
                    reject
                }
            } else {
                reject
            }
        }

