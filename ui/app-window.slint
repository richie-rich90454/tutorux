    in-out property <string> journal-date-to;
    in-out property <string> journal-session-filter: "all";
    in-out property <string> journal-list-output;
    in-out property <[string]> journal-entry-options;
    in-out property <string> selected-journal-entry;
    in-out property <string> journal-timeline-output;
    in-out property <[string]> journal-session-options;
    in-out property <string> selected-journal-session;
    in-out property <string> journal-timeline-date;
    in-out property <bool> journal-session-expanded: false;
    in-out property <string> journal-session-detail-output: "Select a session and show its details.";
    in-out property <[string]> journal-session-student-options;
    in-out property <string> journal-session-student: "Anonymous session";
    in-out property <string> journal-session-new-student-name;
    in-out property <string> journal-session-new-student-grade;
    in-out property <string> journal-session-language: "auto";
    in-out property <string> journal-session-recording-source: "microphone";
    in-out property <[string]> journal-guide-template-options;
    in-out property <string> journal-session-template: "Use recommended template";
    in-out property <string> journal-guide-output:
        "Draft guides created from this entry will appear in Study guides.";
    in-out property <string> journal-entry-title;
    in-out property <string> journal-entry-date;
    in-out property <bool> journal-entry-create-open: false;
    in-out property <string> journal-entry-collections;
    in-out property <string> journal-entry-tags;
    in-out property <string> journal-entry-id;
    in-out property <string> journal-session-title;
    in-out property <string> journal-session-subject;
    in-out property <string> journal-session-objectives;
    in-out property <string> journal-session-type: "notes-only";
    in-out property <string> journal-session-id;
    in-out property <bool> journal-session-delete-confirmed: false;
    in-out property <bool> journal-session-delete-scope-reviewed: false;
    in-out property <string> journal-session-delete-preview-id;
    in-out property <string> journal-session-delete-scope-token;
    in-out property <string> journal-session-delete-scope-output:
        "Review the deletion scope before confirming.";
    in-out property <string> journal-document-id;
    in-out property <string> journal-document-text;
    in-out property <string> journal-document-blocks-json: "[]";
    in-out property <[string]> journal-note-block-options;
    in-out property <string> selected-journal-note-block;
    in-out property <string> journal-document-block-text;
    in-out property <string> journal-document-block-kind: "Paragraph";
    in-out property <int> journal-document-block-anchor-offset: 0;
    in-out property <int> journal-document-block-focus-offset: 0;
    property <bool> journal-inline-format-enabled:
        root.journal-document-block-count > 0 && root.journal-document-block-kind != "Code";
    in-out property <string> journal-document-new-block-text;
    in-out property <int> journal-document-block-index: -1;
    in-out property <int> journal-document-block-count: 0;
    in-out property <bool> journal-document-show-preview: false;
    in-out property <string> journal-item-name;
    in-out property <string> journal-item-id;
    in-out property <string> journal-item-description;
    in-out property <string> journal-item-color;
    forward-focus: marker-shortcuts;

    changed selected-journal-session => {
        root.journal-session-id = "";
        root.journal-session-expanded = false;
        root.recording-status-output =
            "Session selection changed. Check status before continuing capture.";
        root.journal-session-delete-confirmed = false;
        root.journal-session-delete-scope-reviewed = false;
        root.journal-session-delete-preview-id = "";
        root.journal-session-delete-scope-token = "";
    }
    changed selected-session => {
        root.asset-command(root.selected-session, "reset", "");
    }
    changed journal-session-id => {
        root.recording-status-output =
            "Session selection changed. Check status before continuing capture.";
        root.journal-session-delete-confirmed = false;
        root.journal-session-delete-scope-reviewed = false;
        root.journal-session-delete-preview-id = "";
        root.journal-session-delete-scope-token = "";
    }
    changed journal-query => { root.schedule-journal-search(); }
    changed journal-sort => { root.schedule-journal-search(); }
    changed journal-collection-filter => { root.schedule-journal-search(); }
    changed journal-tag-filter => { root.schedule-journal-search(); }
    changed journal-date-from => { root.schedule-journal-search(); }
    changed journal-date-to => { root.schedule-journal-search(); }
    changed journal-session-filter => { root.schedule-journal-search(); }
    changed journal-session-type => {
        if root.journal-session-type == "notes-only" {
            root.journal-session-recording-source = "none";
            root.recording-source = "microphone";
        } else if root.journal-session-type == "import-recording" {
            root.journal-session-recording-source = "imported-file";
            root.recording-source = "microphone";
        } else {
            root.journal-session-recording-source = "microphone";
            root.recording-source = "microphone";
        }
    }
    changed selected-journal-note-block => {
        root.journal-action("document-block-select", root.journal-document-id,
            root.selected-journal-note-block, "", "", "", "");
    }
    changed sanitized-copy-output => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-students => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-exclude-students => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-sessions => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-exclude-sessions => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-recording-tracks => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-exclude-recording-tracks => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-recordings => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-private-annotations => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-generation-logs => { root.sanitized-copy-ready = false; }
    changed sanitized-copy-include-credentials => { root.sanitized-copy-ready = false; }

    callback open-archive(string, string);
    callback archive-recovery-action(string);
    callback sanitized-copy(
        string, string, string, string, string, string, string,
        bool, bool, bool, bool, string, bool
    );
    callback forget-passphrase();
    callback create-archive(string, string);
    callback create-student(string, string, string, string, string, string);
    callback load-student-progress(string);
    callback review-student-progress(string, string, string, string, string, string);
    callback save-student-profile(string, string, string, string, string, string, string, string, string);
    callback create-session(string, string, string, string);
    callback journal-action(string, string, string, string, string, string, string);
    callback journal-session-create(string, string, string, string, string, string, string, string, string, string, string);
    callback open-session(string);
    callback review-transcript(string);
    callback load-transcript(string, string);
    callback save-transcript(string, string, string);
    callback quick-marker(string, string, string, string);
    callback recording-command(string, string, string);
    callback check-recording-device(string);
    pure callback accepts-dropped-files(data-transfer) -> bool;
    callback import-dropped-files(data-transfer);
    callback guide-command(string, string, string, string);
    callback asset-command(string, string, string);
    callback ai-command(string, string, string, string);
    callback load-guide-block(string, string);
    callback guide-edit-input-changed(string, int, int);
    callback guide-edit-selection-changed(int, int);
    callback find-guide-next(string);
    callback replace-guide-match(string, string);
    callback replace-all-guide-matches(string, string);
    callback insert-guide-markup(string, string);
    callback guide-edit-undo();
    callback guide-edit-redo();
    callback save-guide-block(string, string, string);
    callback save-marker-shortcuts(string, string, string, string, string, string, string);
    callback run-command(string, string);

    callback cancel-command();

    function schedule-journal-search() {
        if (journal-search-timer.running) {
            journal-search-timer.restart();
        } else {
            journal-search-timer.start();
        }
    }

    function run-journal-search() {
        journal-search-timer.stop();
        root.journal-action("entry-list", root.journal-query,
            root.journal-collection-filter,
            root.journal-tag-filter,
            root.journal-date-from,
            root.journal-date-to,
            root.journal-session-filter);
    }

    journal-search-timer := Timer {
        interval: 260ms;
        running: false;
        triggered() => { root.run-journal-search(); }
    }

    drop-area := DropArea {
        width: 100%;
        height: 100%;
        accessible-role: AccessibleRole.region;
        accessible-label: self.has-drag
            ? "Release the local files to import them into Tutorux."
            : "Tutorux file import. Drop local files anywhere in this window to add them to the selected archive.";
        accessible-live-region: AccessibleLiveness.polite;

        can-drop(event) => {
            root.accepts-dropped-files(event.data) ? DragAction.copy : DragAction.none
        }
        dropped(event) => {
            root.import-dropped-files(event.data);
            return event.proposed-action;
        }

    marker-shortcuts := FocusScope {
        capture-key-pressed(event) => {
            if event.modifiers.control && !event.repeat &&
                    (root.active-view == "sessions" || root.active-view == "recording") {
                if (event.text == root.shortcut-concept) {
                    root.quick-marker(root.selected-session, "important-concept",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-mistake) {
                    root.quick-marker(root.selected-session, "student-mistake",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-correction) {
                    root.quick-marker(root.selected-session, "tutor-correction",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-instruction) {
                    root.quick-marker(root.selected-session, "explicit-instruction",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-example) {
                    root.quick-marker(root.selected-session, "worked-example",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-follow-up) {
                    root.quick-marker(root.selected-session, "follow-up-priority",
                        root.annotation-time, root.annotation-note);
                    accept
                } else if (event.text == root.shortcut-note) {
                    root.quick-marker(root.selected-session, "general-note", root.annotation-time,
                        root.annotation-note);
                    accept
                } else {
                    reject
                }
            } else {
                reject
            }
        }

        Rectangle {
        background: #ffffff;

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 248px;
                background: #111111;

                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;

                    HorizontalLayout {
                        spacing: 11px;
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 5px;
                            background: #1e40ff;
                            Text {
                                text: "T";
                                color: #ffffff;
                                font-size: 22px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            spacing: 1px;
                            Text {
                                text: "tutorux";
                                color: #ffffff;
                                font-size: 20px;
                                font-weight: 700;
                            }
                            Text {
                                text: "TEACHING, REMEMBERED";
                                color: #ffffff;
                                font-size: 9px;
                                letter-spacing: 1px;
                            }
                        }
                    }

                    Rectangle { height: 10px; }

                    Text {
                        text: "Journal";
                        color: #ffffff;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 1.2px;
                    }
                    Button {
                        text: "Journal";
                        clicked => { root.active-view = "journal"; }
                    }
                    Button {
                        text: "Archive";
                        clicked => { root.active-view = "archive"; }
                    }
                    Button {
                        text: "Students";
                        clicked => { root.active-view = "students"; }
                    }
                    Button {
                        text: "Sessions";
                        clicked => { root.active-view = "sessions"; }
                    }
                    Button {
                        text: "Materials";
                        clicked => { root.active-view = "assets"; }
                    }
                    Button {
                        text: "Recording";
                        clicked => {
                            root.selected-session =
                                root.journal-session-id == "" ?
                                    root.selected-journal-session : root.journal-session-id;
                            root.recording-panel-open = true;
                            root.active-view = "journal";
                        }
                    }
                    Button {
                        text: "Review desk";
                        clicked => { root.active-view = "review"; }
                    }
                    Button {
                        text: "AI workspace";
                        clicked => { root.active-view = "ai"; }
                    }
                    Button {
                        text: "Study guides";
                        clicked => { root.active-view = "guides"; }
                    }
                    Button {
                        text: "Settings";
                        clicked => { root.active-view = "settings"; }
                    }
                    Rectangle { height: 12px; }
                    Text {
                        text: "Portable archive";
                        color: #ffffff;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 1.2px;
                    }
                    Text {
                        text: root.selected-archive;
                        color: #ffffff;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.archive-status;
                        color: #e8edff;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "All changes are written directly into this .tux file.";
                        color: #ffffff;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    Rectangle { height: 80px; }

                    Rectangle {
                        border-radius: 5px;
                        background: #1e40ff;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: "Private by default"; color: #ffffff; font-size: 13px; font-weight: 600; }
                            Text {
                                text: "Your recordings and notes remain in your archive unless you choose to share them.";
                                color: #ffffff;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle { }
                    Text { text: "TUTORUX 1.0  ·  LOCAL WORKSPACE"; color: #ffffff; font-size: 9px; }
                }
            }

            Rectangle {
                background: #ffffff;
                VerticalLayout {
                    ScrollView {
                    vertical-stretch: 1;
                    if root.active-view == "legacy-overview": VerticalLayout {
                        padding: 34px;
                        padding-left: 42px;
                        padding-right: 42px;
                        spacing: 22px;

                    HorizontalLayout {
                        spacing: 20px;
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: "Your teaching workspace"; color: #111111; font-size: 10px; font-weight: 700; letter-spacing: 1.4px; }
                            Text { text: "Good work starts with good notes."; color: #111111; font-size: 27px; font-weight: 700; }
                        }
                        Rectangle { }
                        Button {
                            text: "+  New journal entry";
                            clicked => {
                                root.active-view = "journal";
                                root.status-message = "Choose or create a journal entry before starting a session.";
                            }
                        }
                        Button {
                            text: "About";
                            clicked => { root.about-open = !root.about-open; }
                        }
                    }

                    if root.about-open: Rectangle {
                        border-radius: 5px;
                        background: #ffffff;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;
                            Text {
                                text: "About Tutorux";
                                color: #111111;
                                font-size: 15px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Tutorux keeps teaching sessions in portable .tux archives.";
                                color: #111111;
                                font-size: 12px;
                            }
                            AboutSlint { }
                        }
                    }

                    Rectangle {
                        height: 146px;
                        border-radius: 5px;
                        background: #e8edff;
                        HorizontalLayout {
                            padding: 24px;
                            padding-left: 28px;
                            padding-right: 28px;
                            spacing: 18px;
                            VerticalLayout {
                                spacing: 9px;
                                Text { text: "A little progress, captured."; color: #111111; font-size: 21px; font-weight: 650; }
                                Text {
                                    text: "Keep each lesson connected to the ideas, questions and next steps that matter.";
                                    color: #111111;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                Text { text: root.status-message; color: #1e40ff; font-size: 12px; }
                            }
                            Rectangle { }
                            Rectangle {
                                width: 104px;
                                height: 104px;
                                border-radius: 5px;
                                background: #e8edff;
                                Text { text: "✳"; color: #1e40ff; font-size: 45px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 14px;
                        Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                Text { text: "Students"; color: #111111; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Learning histories"; color: #111111; font-size: 15px; font-weight: 600; }
                                LineEdit { placeholder-text: "Student name"; text <=> root.student-name; }
                                LineEdit { placeholder-text: "Grade or level"; text <=> root.student-grade; }
                                LineEdit { placeholder-text: "Subjects"; text <=> root.student-subjects; }
                                LineEdit { placeholder-text: "Learning objectives"; text <=> root.student-objectives; }
                                LineEdit { placeholder-text: "Known difficulties"; text <=> root.student-difficulties; }
                                LineEdit { placeholder-text: "Tutor notes"; text <=> root.student-notes; }
                                Button {
                                    text: "Add student";
                                    clicked => {
                                        root.create-student(root.student-name, root.student-grade,
                                            root.student-subjects, root.student-objectives,
                                            root.student-difficulties, root.student-notes);
                                    }
                                }
                            }
                        }
                        Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                Text { text: "New session"; color: #111111; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Start from a journal entry"; color: #111111; font-size: 15px; font-weight: 600; }
                                Text {
                                    text: "Sessions belong to an entry so lesson notes, recordings and guides stay together.";
                                    color: #111111;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                Button {
                                    text: "Choose a journal entry";
                                    clicked => {
                                        root.active-view = "journal";
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 14px;
                        Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                Text { text: "Archive"; color: #111111; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Open an existing workspace"; color: #111111; font-size: 15px; font-weight: 600; }
                                if root.archive-paths.length > 0: ComboBox {
                                    model: root.archive-paths;
                                    current-value <=> root.archive-path;
                                }
                                ScrollView {
                                    height: 112px;
                                    Text { text: root.archive-list; color: #111111; font-size: 11px; wrap: word-wrap; }
                                }
                                LineEdit { placeholder-text: "Path to a .tux archive"; text <=> root.archive-path; }
                                LineEdit {
                                    placeholder-text: "Archive passphrase (if encrypted)";
                                    input-type: password;
                                    text <=> root.archive-passphrase;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Open archive";
                                        clicked => {
                                            root.open-archive(root.archive-path, root.archive-passphrase);
                                            root.archive-passphrase = "";
                                        }
                                    }
                                    Button { text: "Forget passphrase"; clicked => { root.forget-passphrase(); } }
                                }
                            }
                        }
                        Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                Text { text: "Start fresh"; color: #111111; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Create a portable archive"; color: #111111; font-size: 15px; font-weight: 600; }
                                Text {
                                    text: "One file holds your students, sessions, recordings, materials and guides.";
                                    color: #111111;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                LineEdit { placeholder-text: "Tutorux.tux"; text <=> root.archive-name; }
                                LineEdit {
                                    placeholder-text: "Optional archive passphrase";
                                    input-type: password;
                                    text <=> root.new-archive-passphrase;
                                }
                                Button {
                                    text: "Create workspace";
                                    clicked => {
                                        root.create-archive(root.archive-name, root.new-archive-passphrase);
                                        root.new-archive-passphrase = "";
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 14px;
                        Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 7px;
                                Text { text: "Students in this archive"; color: #111111; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
                                ScrollView { height: 92px; Text { text: root.students-text; color: #111111; font-size: 11px; wrap: word-wrap; } }
                            }
                        }
                        Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 7px;
                                Text { text: "Recent sessions"; color: #111111; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
                                ScrollView { height: 92px; Text { text: root.sessions-text; color: #111111; font-size: 11px; wrap: word-wrap; } }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 5px;
                        background: #ffffff;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;
                            Text {
                                text: "Command console";
                                color: #111111;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1px;
                            }
                            Text {
                                text: "Run Tutorux commands against this archive";
                                color: #111111;
                                font-size: 15px;
                                font-weight: 600;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    placeholder-text: "annotation add --session ID --type note --at 00:00:00 --text \"...\"";
                                    text <=> root.command-input;
                                    accepted => {
                                        root.run-command(root.command-input, root.new-archive-passphrase);
                                        root.new-archive-passphrase = "";
                                    }
                                }
                                Button {
                                    text: "Run";
                                    clicked => {
                                        root.run-command(root.command-input, root.new-archive-passphrase);
                                        root.new-archive-passphrase = "";
                                    }
                                }
                                if root.command-running: Button {
                                    text: "Cancel";
                                    clicked => { root.cancel-command(); }
                                }
                            }
                            LineEdit {
                                placeholder-text: "New passphrase for archive encrypt/change-passphrase";
                                input-type: password;
                                text <=> root.new-archive-passphrase;
                            }
                            Text {
                                text: "Arguments are parsed by Tutorux; no shell commands are executed.";
                                color: #111111;
                                font-size: 11px;
                            }
                            ScrollView {
                                height: 150px;
                                Text {
                                    text: root.command-output;
                                    color: #111111;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    }
                    if root.active-view == "journal": VerticalLayout {
                        padding: 30px;
                        padding-left: 34px;
                        padding-right: 34px;
                        spacing: 18px;

                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Journal";
                                    color: #111111;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 1.2px;
                                }
                                Text {
                                    text: "Teaching, remembered.";
                                    color: #111111;
                                    font-size: 30px;
                                    font-weight: 700;
                                }
                            }
                            Rectangle { }
                            Button {
                                text: "+ New entry";
                                clicked => {
                                    root.journal-entry-title = "";
                                    root.journal-entry-date = "";
                                    root.journal-entry-collections = "";
                                    root.journal-entry-tags = "";
                                    root.journal-entry-create-open = true;
                                    root.status-message = "Add a title, then create the entry in the workspace.";
                                }
                            }
                        }

                        if root.journal-entry-create-open: Rectangle {
                            border-width: 1px;
                            border-color: #111111;
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Text {
                                    text: "New journal entry";
                                    color: #111111;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    journal-entry-title-input := LineEdit {
                                        placeholder-text: "Entry title";
                                        text <=> root.journal-entry-title;
                                        accessible-label: "New journal entry title";
                                    }
                                    LineEdit {
                                        placeholder-text: "Date YYYY-MM-DD (optional)";
                                        text <=> root.journal-entry-date;
                                        accessible-label: "New journal entry date";
                                    }
                                    Button {
                                        text: "Create entry";
                                        enabled: root.journal-entry-title != "";
                                        clicked => {
                                            root.journal-action("entry-create",
                                                root.journal-entry-title,
                                                root.journal-entry-date,
                                                root.journal-entry-collections,
                                                root.journal-entry-tags,
                                                "", "");
                                        }
                                    }
                                    Button {
                                        text: "Cancel";
                                        clicked => { root.journal-entry-create-open = false; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-width: 1px;
                            border-color: #111111;
                            border-radius: 5px;
                            background: #ffffff;
                            accessible-role: AccessibleRole.region;
                            accessible-label: "Journal search and filters";
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text {
                                    text: "Find an entry";
                                    color: #111111;
                                    font-size: 15px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "Search titles, notes, transcripts, and guides";
                                        text <=> root.journal-query;
                                        accepted => { root.run-journal-search(); }
                                        accessible-label: "Search journal entries by title, notes, transcripts, and guides";
                                    }
                                    ComboBox {
                                        model: ["all", "with sessions", "without sessions"];
                                        current-value <=> root.journal-session-filter;
                                        accessible-label: "Filter entries by session presence";
                                    }
                                    Button {
                                        text: "Search";
                                        clicked => { root.run-journal-search(); }
                                        accessible-label: "Search journal entries";
                                    }
                                    Button {
                                        text: "Collections";
                                        clicked => {
                                            root.journal-action("collection-list", "", "", "", "", "", "");
                                        }
                                        accessible-label: "Manage journal collections";
                                    }
                                    Button {
                                        text: "Tags";
                                        clicked => {
                                            root.journal-action("tag-list", "", "", "", "", "", "");
                                        }
                                        accessible-label: "Manage journal tags";
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ComboBox {
                                        model: ["Newest first", "Oldest first", "Title"];
                                        current-value <=> root.journal-sort;
                                        accessible-label: "Sort journal entries";
                                    }
                                    ComboBox {
                                        model: root.journal-collection-options;
                                        current-value <=> root.journal-collection-filter;
                                        accessible-label: "Filter entries by collection";
                                    }
                                    ComboBox {
                                        model: root.journal-tag-options;
                                        current-value <=> root.journal-tag-filter;
                                        accessible-label: "Filter entries by tag";
                                    }
                                    LineEdit {
                                        placeholder-text: "From YYYY-MM-DD";
                                        text <=> root.journal-date-from;
                                        accessible-label: "Filter entries from date";
                                    }
                                    LineEdit {
                                        placeholder-text: "To YYYY-MM-DD";
                                        text <=> root.journal-date-to;
                                        accessible-label: "Filter entries through date";
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 14px;
                            Rectangle {
                                width: 310px;
                                border-width: 1px;
                                border-color: #111111;
                                border-radius: 5px;
                                background: #ffffff;
                                accessible-role: AccessibleRole.region;
                                accessible-label: "Journal entries";
                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 10px;
                                    Text {
                                        text: "Entries";
                                        color: #111111;
                                        font-size: 17px;
                                        font-weight: 600;
                                    }
                                    if root.journal-entry-options.length > 0: ComboBox {
                                        model: root.journal-entry-options;
                                        current-value <=> root.selected-journal-entry;
                                        accessible-label: "Select a journal entry";
                                    }
                                    Button {
                                        text: "Open selected entry";
                                        enabled: root.selected-journal-entry != "";
                                        clicked => {
                                            root.journal-action("entry-show",
                                                root.selected-journal-entry,
                                                "", "", "", "", "");
                                        }
                                        accessible-label: "Open the selected journal entry";
                                    }
                                    ScrollView {
                                        height: 330px;
                                        Text {
                                            text: root.journal-list-output;
                                            color: #111111;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            accessible-role: AccessibleRole.text;
                                            accessible-label: "Journal search results";
                                            accessible-live-region: AccessibleLiveness.polite;
                                        }
                                    }
                                    Text {
                                        text: "Newest entries appear first. Search and filters preserve this journal view.";
                                        color: #111111;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 14px;
                                Rectangle {
                                    border-width: 1px;
                                    border-color: #111111;
                                    border-radius: 5px;
                                    background: #ffffff;
                                    accessible-role: AccessibleRole.region;
                                    accessible-label: "Journal entry workspace";
                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 9px;
                                        Text {
                                            text: "Entry workspace";
                                            color: #111111;
                                            font-size: 17px;
                                            font-weight: 600;
                                        }
                                        LineEdit {
                                            placeholder-text: "Entry ID";
                                            text <=> root.journal-entry-id;
                                            accessible-label: "Journal entry identifier";
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Open entry";
                                                clicked => {
                                                    root.journal-action("entry-show",
                                                        root.journal-entry-id, "", "", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Update entry";
                                                clicked => {
                                                    root.journal-action("entry-update",
                                                        root.journal-entry-id,
                                                        root.journal-entry-title,
                                                        root.journal-entry-date,
                                                        root.journal-entry-collections,
                                                        root.journal-entry-tags, "");
                                                }
                                            }
                                            Button {
                                                text: "Clear date";
                                                clicked => {
                                                    root.journal-entry-date = "";
                                                    root.journal-action("entry-clear-date",
                                                        root.journal-entry-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Delete entry";
                                                clicked => {
                                                    root.journal-action("entry-delete",
                                                        root.journal-entry-id, "", "", "", "", "");
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Title";
                                                text <=> root.journal-entry-title;
                                                accessible-label: "Journal entry title";
                                            }
                                            LineEdit {
                                                placeholder-text: "Entry date YYYY-MM-DD";
                                                text <=> root.journal-entry-date;
                                                accessible-label: "Journal entry date";
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Collection IDs, comma-separated";
                                                text <=> root.journal-entry-collections;
                                            }
                                            LineEdit {
                                                placeholder-text: "Tag IDs, comma-separated";
                                                text <=> root.journal-entry-tags;
                                            }
                                        }
                                        Button {
                                            text: "Create entry";
                                            clicked => {
                                                root.journal-action("entry-create",
                                                    root.journal-entry-title,
                                                    root.journal-entry-date,
                                                    root.journal-entry-collections,
                                                    root.journal-entry-tags,
                                                    "", "");
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    border-width: 1px;
                                    border-color: #111111;
                                    border-radius: 5px;
                                    background: #ffffff;
                                    accessible-role: AccessibleRole.region;
                                    accessible-label: "Journal session timeline and controls";
                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 9px;
                                        Text {
                                            text: "Session timeline";
                                            color: #111111;
                                            font-size: 17px;
                                            font-weight: 600;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Session date YYYY-MM-DD";
                                                text <=> root.journal-timeline-date;
                                                accessible-label: "Session timeline date";
                                            }
                                            Button {
                                                text: "Jump to date";
                                                clicked => {
                                                    root.journal-action("session-list", root.journal-entry-id,
                                                        root.journal-timeline-date, root.journal-timeline-date,
                                                        "", "", "");
                                                }
                                                accessible-label: "Show sessions on the selected date";
                                            }
                                            Button {
                                                text: "All dates";
                                                clicked => {
                                                    root.journal-timeline-date = "";
                                                    root.journal-action("session-list", root.journal-entry-id,
                                                        "", "", "", "", "");
                                                }
                                                accessible-label: "Show sessions from all dates";
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Session title";
                                                text <=> root.journal-session-title;
                                                accessible-label: "Session title";
                                            }
                                            ComboBox {
                                                model: ["notes-only", "record-audio", "import-recording"];
                                                current-value <=> root.journal-session-type;
                                                accessible-label: "New session mode";
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Subject";
                                                text <=> root.journal-session-subject;
                                            }
                                            LineEdit {
                                                placeholder-text: "Learning objectives";
                                                text <=> root.journal-session-objectives;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            ComboBox {
                                                model: root.journal-session-student-options;
                                                current-value <=> root.journal-session-student;
                                                accessible-label: "Student for the new session";
                                            }
                                            LineEdit {
                                                placeholder-text: "Language code, for example en or zh";
                                                text <=> root.journal-session-language;
                                                accessible-label: "Session language code";
                                            }
                                            ComboBox {
                                                model: root.journal-guide-template-options;
                                                current-value <=> root.journal-session-template;
                                                accessible-label: "Guide template for the new session";
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Capture source";
                                                color: #111111;
                                                font-size: 12px;
                                            }
                                            if root.journal-session-type == "record-audio": ComboBox {
                                                model: ["microphone", "system-audio", "both", "application"];
                                                current-value <=> root.journal-session-recording-source;
                                                accessible-label: "Audio capture source for the new session";
                                            }
                                            if root.journal-session-type == "import-recording": ComboBox {
                                                model: ["imported-file"];
                                                current-value <=> root.journal-session-recording-source;
                                                accessible-label: "Recording source for the new session";
                                            }
                                            if root.journal-session-type == "notes-only": ComboBox {
                                                model: ["none"];
                                                current-value <=> root.journal-session-recording-source;
                                                accessible-label: "Recording source for the new session";
                                            }
                                        }
                                        if root.journal-session-student == "Create a new student": HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "New student name";
                                                text <=> root.journal-session-new-student-name;
                                                accessible-label: "New student name";
                                            }
                                            LineEdit {
                                                placeholder-text: "Grade or level";
                                                text <=> root.journal-session-new-student-grade;
                                                accessible-label: "New student grade or level";
                                            }
                                        }
                                        if root.journal-session-options.length > 0: ScrollView {
                                            height: 170px;
                                            VerticalLayout {
                                                spacing: 6px;
                                                for session in root.journal-session-options: Rectangle {
                                                    border-width: 1px;
                                                    border-color: #111111;
                                                    border-radius: 5px;
                                                    background: root.selected-journal-session == session ?
                                                        #eef2fb : #ffffff;
                                                    VerticalLayout {
                                                        padding: 5px;
                                                        spacing: 4px;
                                                        Button {
                                                            text: session;
                                                            clicked => {
                                                                root.selected-journal-session = session;
                                                            }
                                                            accessible-label: "Select session " + session;
                                                        }
                                                        if root.selected-journal-session == session: HorizontalLayout {
                                                            spacing: 6px;
                                                            Button {
                                                                text: root.journal-session-expanded ? "Hide details" : "Show details";
                                                                clicked => {
                                                                    root.journal-session-expanded = !root.journal-session-expanded;
                                                                    if root.journal-session-expanded {
                                                                        root.journal-action("session-show", session,
                                                                            "", "", "", "", "");
                                                                    }
                                                                }
                                                                accessible-label: (root.journal-session-expanded ?
                                                                    "Hide details for session " :
                                                                    "Show details for session ") + session;
                                                            }
                                                            Button {
                                                                text: "Open session";
                                                                clicked => {
                                                                    root.open-session("Session · " + session);
                                                                }
                                                                accessible-label: "Open session " + session;
                                                            }
                                                            Button {
                                                                text: "Review transcript";
                                                                clicked => {
                                                                    root.review-transcript("Session · " + session);
                                                                }
                                                                accessible-label: "Review transcript for session " + session;
                                                            }
                                                            Button {
                                                                text: "Recording controls";
                                                                clicked => {
                                                                    root.selected-session = session;
                                                                    root.recording-panel-open = true;
                                                                }
                                                                accessible-label: "Open recording controls for session " + session;
                                                            }
                                                        }
                                                        if root.selected-journal-session == session && root.journal-session-expanded: Text {
                                                            text: root.journal-session-detail-output;
                                                            color: #111111;
                                                            font-size: 11px;
                                                            wrap: word-wrap;
                                                            accessible-role: AccessibleRole.text;
                                                            accessible-label: "Expanded session details";
                                                            accessible-live-region: AccessibleLiveness.polite;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if root.journal-session-options.length == 0: Text {
                                            text: "No sessions are linked to this entry yet.";
                                            color: #111111;
                                            font-size: 12px;
                                        }
                                        }
                                        LineEdit {
                                            placeholder-text: "Session ID";
                                            text <=> root.journal-session-id;
                                            accessible-label: "Session identifier";
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "New session";
                                                clicked => {
                                                    root.journal-session-create(
                                                        root.journal-entry-id,
                                                        root.journal-session-type,
                                                        root.journal-session-title,
                                                        root.journal-session-student,
                                                        root.journal-session-subject,
                                                        root.journal-session-objectives,
                                                        root.journal-session-language,
                                                        root.journal-session-template,
                                                        root.journal-session-new-student-name,
                                                        root.journal-session-new-student-grade,
                                                        root.journal-session-recording-source);
                                                }
                                                accessible-label: "Create a new session in this journal entry";
                                            }
                                            Button {
                                                text: "Show timeline";
                                                clicked => {
                                                    root.journal-action("session-list",
                                                        root.journal-entry-id, root.journal-timeline-date,
                                                        root.journal-timeline-date, "", "", "");
                                                }
                                                accessible-label: "Refresh the session timeline";
                                            }
                                            Button {
                                                text: "Open session";
                                                clicked => {
                                                    root.open-session("Session · " +
                                                        (root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id));
                                                }
                                                accessible-label: "Open the selected session";
                                            }
                                            Button {
                                                text: "Review transcript";
                                                clicked => {
                                                    root.review-transcript("Session · " +
                                                        (root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id));
                                                }
                                                accessible-label: "Review the selected session transcript";
                                            }
                                            Button {
                                                text: "Recording / import controls";
                                                clicked => {
                                                    root.selected-session =
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id;
                                                    root.recording-panel-open = true;
                                                }
                                                accessible-label:
                                                    "Open recording or import controls for the selected session";
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Resume session";
                                                clicked => {
                                                    root.journal-action("session-resume",
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id,
                                                        "", "", "", "", "");
                                                }
                                                accessible-label: "Resume the selected session";
                                            }
                                            Button {
                                                text: "Complete session";
                                                clicked => {
                                                    root.journal-action("session-complete",
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id,
                                                        "", "", "", "", "");
                                                }
                                                accessible-label: "Complete the selected session";
                                            }
                                            Button {
                                                text: "Mark reviewed";
                                                clicked => {
                                                    root.journal-action("session-review",
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id,
                                                        "", "", "", "", "");
                                                }
                                                accessible-label: "Mark the selected session as reviewed";
                                            }
                                        }
                                        CheckBox {
                                            text: "I reviewed the deletion scope and want to remove this session.";
                                            checked <=> root.journal-session-delete-confirmed;
                                            enabled: root.journal-session-delete-scope-reviewed &&
                                                     (root.journal-session-id == "" ?
                                                         root.selected-journal-session :
                                                         root.journal-session-id) ==
                                                         root.journal-session-delete-preview-id;
                                        }
                                        ScrollView {
                                            height: 92px;
                                            Text {
                                                text: root.journal-session-delete-scope-output;
                                                color: #111111;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Review deletion scope";
                                                clicked => {
                                                    root.journal-session-delete-confirmed = false;
                                                    root.journal-session-delete-scope-reviewed = false;
                                                    root.journal-session-delete-preview-id = "";
                                                    root.journal-action("session-delete-preview",
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Confirm session deletion";
                                                enabled: root.journal-session-delete-confirmed &&
                                                    root.journal-session-delete-scope-reviewed &&
                                                    (root.journal-session-id == "" ?
                                                        root.selected-journal-session :
                                                        root.journal-session-id) ==
                                                        root.journal-session-delete-preview-id;
                                                clicked => {
                                                    root.journal-action("session-delete-confirm",
                                                        root.journal-session-id == "" ?
                                                            root.selected-journal-session :
                                                            root.journal-session-id,
                                                        root.journal-session-delete-scope-token,
                                                        "", "", "", "");
                                                    root.journal-session-delete-confirmed = false;
                                                }
                                            }
                                        }
                                        Text {
                                            text: "Audio starts only after microphone access, input level, and consent are confirmed.";
                                            color: #111111;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.journal-timeline-output;
                                            color: #111111;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                            accessible-role: AccessibleRole.text;
                                            accessible-label: "Session timeline results";
                                            accessible-live-region: AccessibleLiveness.polite;
                                        }
                                    }
                                }

                                Rectangle {
                                    border-width: 1px;
                                    border-color: #111111;
                                    border-radius: 5px;
                                    background: #ffffff;
                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 9px;
                                        Text {
                                            text: "Entry notes";
                                            color: #111111;
                                            font-size: 17px;
                                            font-weight: 600;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                placeholder-text: "Notes document ID";
                                                text <=> root.journal-document-id;
                                                enabled: root.journal-entry-id != "";
                                            }
                                            Button {
                                                text: "Load notes";
                                                enabled: root.journal-document-id != "";
                                                clicked => {
                                                    root.journal-action("document-show",
                                                        root.journal-document-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                        }
                                        Text {
                                            text: "Notes are edited as separate blocks, so each block keeps its type and identity.";
                                            color: #111111;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: "Block"; color: #111111; font-size: 12px; }
                                            ComboBox {
                                                model: root.journal-note-block-options;
                                                current-value <=> root.selected-journal-note-block;
                                                enabled: root.journal-document-block-count > 0;
                                            }
                                            Text { text: "Type"; color: #111111; font-size: 12px; }
                                            ComboBox {
                                                model: ["Paragraph", "Heading", "Bulleted list",
                                                        "Numbered list", "Checklist", "Quote", "Code"];
                                                current-value <=> root.journal-document-block-kind;
                                                enabled: root.journal-document-block-count > 0;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: "Format selection";
                                                color: #111111;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                            Button {
                                                text: "Bold";
                                                enabled: root.journal-inline-format-enabled;
                                                clicked => {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "bold", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Italic";
                                                enabled: root.journal-inline-format-enabled;
                                                clicked => {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "italic", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Strike";
                                                enabled: root.journal-inline-format-enabled;
                                                clicked => {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "strike", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Code";
                                                enabled: root.journal-inline-format-enabled;
                                                clicked => {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "code", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Link";
                                                enabled: root.journal-inline-format-enabled;
                                                clicked => {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "link", "", "", "");
                                                }
                                            }
                                        }
                                        Text {
                                            text: "Select text to format, or place the cursor to insert a span. Formatting uses portable Markdown; Ctrl+B, Ctrl+I, and Ctrl+K also work. Save the block to keep your edits.";
                                            color: #111111;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                        TextInput {
                                            height: 160px;
                                            single-line: false;
                                            wrap: word-wrap;
                                            text <=> root.journal-document-block-text;
                                            font-size: 13px;
                                            color: #111111;
                                            enabled: root.journal-document-block-count > 0;
                                            edited => { root.journal-document-block-text = self.text; }
                                            cursor-position-changed(position) => {
                                                root.journal-document-block-anchor-offset =
                                                    self.anchor-position-byte-offset;
                                                root.journal-document-block-focus-offset =
                                                    self.cursor-position-byte-offset;
                                            }
                                            key-pressed(event) => {
                                                if (root.journal-inline-format-enabled &&
                                                    (event.modifiers.control || event.modifiers.meta) &&
                                                    event.text == Key.B) {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "bold", "", "", "");
                                                    accept
                                                } else if (root.journal-inline-format-enabled &&
                                                           (event.modifiers.control ||
                                                            event.modifiers.meta) &&
                                                           event.text == Key.I) {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "italic", "", "", "");
                                                    accept
                                                } else if (root.journal-inline-format-enabled &&
                                                           (event.modifiers.control ||
                                                            event.modifiers.meta) &&
                                                           event.text == Key.K) {
                                                    root.journal-action("document-block-format",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "link", "", "", "");
                                                    accept
                                                } else {
                                                    reject
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Save block";
                                                enabled: root.journal-document-id != "" &&
                                                    root.selected-journal-note-block != "";
                                                clicked => {
                                                    root.journal-action("document-block-update",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        root.journal-document-block-kind,
                                                        root.journal-document-block-text,
                                                        "", "");
                                                }
                                            }
                                            Button {
                                                text: "Move up";
                                                enabled: root.journal-document-block-index > 0;
                                                clicked => {
                                                    root.journal-action("document-block-move",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "up", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Move down";
                                                enabled: root.journal-document-block-index >= 0 &&
                                                    root.journal-document-block-index + 1 <
                                                        root.journal-document-block-count;
                                                clicked => {
                                                    root.journal-action("document-block-move",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "down", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Remove block";
                                                enabled: root.journal-document-id != "" &&
                                                    root.selected-journal-note-block != "";
                                                clicked => {
                                                    root.journal-action("document-block-remove",
                                                        root.journal-document-id,
                                                        root.selected-journal-note-block,
                                                        "", "", "", "");
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: "Add a block"; color: #111111; font-size: 12px; }
                                            Button {
                                                text: "Add block";
                                                enabled: root.journal-document-id != "" &&
                                                    root.journal-document-new-block-text != "";
                                                clicked => {
                                                    root.journal-action("document-block-add",
                                                        root.journal-document-id,
                                                        root.journal-document-block-kind,
                                                        root.journal-document-new-block-text,
                                                        root.selected-journal-note-block,
                                                        "", "");
                                                }
                                            }
                                        }
                                        TextInput {
                                            height: 90px;
                                            single-line: false;
                                            wrap: word-wrap;
                                            text <=> root.journal-document-new-block-text;
                                            font-size: 13px;
                                            color: #111111;
                                            enabled: root.journal-document-id != "";
                                            edited => {
                                                root.journal-document-new-block-text = self.text;
                                            }
                                        }
                                        CheckBox {
                                            text: "Show saved notes as a whole document";
                                            checked <=> root.journal-document-show-preview;
                                        }
                                        if root.journal-document-show-preview: ScrollView {
                                            height: 100px;
                                            Text {
                                                text: root.journal-document-text;
                                                color: #111111;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Generate guide from this entry";
                                                clicked => {
                                                    root.journal-action("guide-generate-entry",
                                                        root.journal-entry-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Open study guides";
                                                clicked => { root.active-view = "guides"; }
                                            }
                                        }
                                        Text {
                                            text: root.journal-guide-output;
                                            color: #111111;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                Rectangle {
                                    border-width: 1px;
                                    border-color: #111111;
                                    border-radius: 5px;
                                    background: #ffffff;
                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 9px;
                                        Text {
                                            text: "Organize this journal";
                                            color: #111111;
                                            font-size: 17px;
                                            font-weight: 600;
                                        }
                                        LineEdit {
                                            placeholder-text: "Collection or tag ID";
                                            text <=> root.journal-item-id;
                                        }
                                        LineEdit {
                                            placeholder-text: "Collection or tag name";
                                            text <=> root.journal-item-name;
                                        }
                                        LineEdit {
                                            placeholder-text: "Description";
                                            text <=> root.journal-item-description;
                                        }
                                        LineEdit {
                                            placeholder-text: "Color, optional";
                                            text <=> root.journal-item-color;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Add collection";
                                                clicked => {
                                                    root.journal-action("collection-create",
                                                        root.journal-item-name,
                                                        root.journal-item-description,
                                                        root.journal-item-color,
                                                        "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Add tag";
                                                clicked => {
                                                    root.journal-action("tag-create",
                                                        root.journal-item-name,
                                                        root.journal-item-description,
                                                        root.journal-item-color,
                                                        "", "", "");
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Update collection";
                                                clicked => {
                                                    root.journal-action("collection-update",
                                                        root.journal-item-id,
                                                        root.journal-item-name,
                                                        root.journal-item-description,
                                                        root.journal-item-color,
                                                        "", "");
                                                }
                                            }
                                            Button {
                                                text: "Update tag";
                                                clicked => {
                                                    root.journal-action("tag-update",
                                                        root.journal-item-id,
                                                        root.journal-item-name,
                                                        root.journal-item-description,
                                                        root.journal-item-color,
                                                        "", "");
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Delete collection";
                                                clicked => {
                                                    root.journal-action("collection-delete",
                                                        root.journal-item-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                            Button {
                                                text: "Delete tag";
                                                clicked => {
                                                    root.journal-action("tag-delete",
                                                        root.journal-item-id,
                                                        "", "", "", "", "");
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.active-view == "archive": VerticalLayout {
                        padding: 34px;
                        spacing: 18px;
                        Text {
                            text: "Archive";
                            color: #111111;
                            font-size: 28px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Open or create the portable .tux file that holds this journal.";
                            color: #111111;
                            font-size: 13px;
                        }
                        if root.archive-recovery-needed: Rectangle {
                            border-width: 1px;
                            border-color: #b42318;
                            border-radius: 5px;
                            background: #fff7f5;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 9px;
                                Text {
                                    text: "This archive needs recovery review";
                                    color: #8f1d16;
                                    font-size: 15px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: root.archive-recovery-status;
                                    color: #111111;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    if root.archive-recovery-recoverable: Button {
                                        text: "Recover verified work";
                                        clicked => {
                                            root.archive-recovery-action("recover-unpublished");
                                        }
                                    }
                                    if root.archive-recovery-tail-present: Button {
                                        text: "Discard incomplete tail";
                                        clicked => {
                                            root.archive-recovery-action("discard-tail");
                                        }
                                    }
                                }
                                if root.archive-header-repair-candidate: HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "Path for a separate repaired .tux copy";
                                        text <=> root.archive-repair-copy-path;
                                    }
                                    Button {
                                        text: "Create verified repaired copy";
                                        enabled: root.archive-header-repair-available && root.archive-repair-copy-path != "";
                                        clicked => {
                                            root.archive-recovery-action("repair-copy");
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            Rectangle {
                                border-width: 1px;
                                border-color: #111111;
                                border-radius: 5px;
                                background: #ffffff;
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 10px;
                                    Text {
                                        text: "Open an archive";
                                        color: #111111;
                                        font-size: 16px;
                                        font-weight: 600;
                                    }
                                    if root.archive-paths.length > 0: ComboBox {
                                        model: root.archive-paths;
                                        current-value <=> root.archive-path;
                                    }
                                    LineEdit {
                                        placeholder-text: "Path to a .tux archive";
                                        text <=> root.archive-path;
                                    }
                                    LineEdit {
                                        placeholder-text: "Archive passphrase";
                                        input-type: password;
                                        text <=> root.archive-passphrase;
                                    }
                                    Button {
                                        text: "Open archive";
                                        clicked => {
                                            root.open-archive(root.archive-path,
                                                root.archive-passphrase);
                                            root.archive-passphrase = "";
                                        }
                                    }
                                    Button {
                                        text: "Forget passphrase";
                                        clicked => { root.forget-passphrase(); }
                                    }
                                }
                            }
                            Rectangle {
                                border-width: 1px;
                                border-color: #111111;
                                border-radius: 5px;
                                background: #ffffff;
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 10px;
                                    Text {
                                        text: "Create an archive";
                                        color: #111111;
                                        font-size: 16px;
                                        font-weight: 600;
                                    }
                                    LineEdit {
                                        placeholder-text: "Tutorux.tux";
                                        text <=> root.archive-name;
                                    }
                                    LineEdit {
                                        placeholder-text: "Optional archive passphrase";
                                        input-type: password;
                                        text <=> root.new-archive-passphrase;
                                    }
                                    Button {
                                        text: "Create archive";
                                        clicked => {
                                            root.create-archive(root.archive-name,
                                                root.new-archive-passphrase);
                                            root.new-archive-passphrase = "";
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            border-width: 1px;
                            border-color: #111111;
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                Text {
                                    text: "Create a sanitized copy";
                                    color: #111111;
                                    font-size: 16px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Preview first. Track filters opt in recordings; other sensitive categories default off.";
                                    color: #111111;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                LineEdit {
                                    placeholder-text: "Output path, for example Share.tux";
                                    text <=> root.sanitized-copy-output;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "Include student UUIDs, comma separated";
                                        text <=> root.sanitized-copy-include-students;
                                    }
                                    LineEdit {
                                        placeholder-text: "Exclude student UUIDs, comma separated";
                                        text <=> root.sanitized-copy-exclude-students;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "Include session UUIDs, comma separated";
                                        text <=> root.sanitized-copy-include-sessions;
                                    }
                                    LineEdit {
                                        placeholder-text: "Exclude session UUIDs, comma separated";
                                        text <=> root.sanitized-copy-exclude-sessions;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "Include track UUIDs, comma separated";
                                        text <=> root.sanitized-copy-include-recording-tracks;
                                    }
                                    LineEdit {
                                        placeholder-text: "Exclude track UUIDs, comma separated";
                                        text <=> root.sanitized-copy-exclude-recording-tracks;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    CheckBox {
                                        text: "Recordings";
                                        checked <=> root.sanitized-copy-include-recordings;
                                    }
                                    CheckBox {
                                        text: "Private annotations";
                                        checked <=> root.sanitized-copy-include-private-annotations;
                                    }
                                    CheckBox {
                                        text: "Generation logs";
                                        checked <=> root.sanitized-copy-include-generation-logs;
                                    }
                                    CheckBox {
                                        text: "Credentials";
                                        checked <=> root.sanitized-copy-include-credentials;
                                    }
                                }
                                LineEdit {
                                    placeholder-text: "Output passphrase (needed for credentials/encrypted source)";
                                    input-type: password;
                                    text <=> root.sanitized-copy-passphrase;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Preview selection";
                                        clicked => {
                                            root.sanitized-copy(root.sanitized-copy-output,
                                                root.sanitized-copy-include-students,
                                                root.sanitized-copy-exclude-students,
                                                root.sanitized-copy-include-sessions,
                                                root.sanitized-copy-exclude-sessions,
                                                root.sanitized-copy-include-recording-tracks,
                                                root.sanitized-copy-exclude-recording-tracks,
                                                root.sanitized-copy-include-recordings,
                                                root.sanitized-copy-include-private-annotations,
                                                root.sanitized-copy-include-generation-logs,
                                                root.sanitized-copy-include-credentials,
                                                root.sanitized-copy-passphrase, false);
                                        }
                                    }
                                    Button {
                                        text: "Create reviewed copy";
                                        enabled: root.sanitized-copy-ready;
                                        clicked => {
                                            root.sanitized-copy(root.sanitized-copy-output,
                                                root.sanitized-copy-include-students,
                                                root.sanitized-copy-exclude-students,
                                                root.sanitized-copy-include-sessions,
                                                root.sanitized-copy-exclude-sessions,
                                                root.sanitized-copy-include-recording-tracks,
                                                root.sanitized-copy-exclude-recording-tracks,
                                                root.sanitized-copy-include-recordings,
                                                root.sanitized-copy-include-private-annotations,
                                                root.sanitized-copy-include-generation-logs,
                                                root.sanitized-copy-include-credentials,
                                                root.sanitized-copy-passphrase, true);
                                        }
                                    }
                                }
                                Text {
                                    text: root.sanitized-copy-status;
                                    color: #111111;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        ScrollView {
                            height: 160px;
                            Text {
                                text: root.archive-list;
                                color: #111111;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if root.active-view != "journal" && root.active-view != "archive" &&
                            root.active-view != "legacy-overview": VerticalLayout {
                        padding: 34px;
                        padding-left: 42px;
                        padding-right: 42px;
                        spacing: 22px;

                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 5px;
                                Text {
                                    text: root.active-view == "students" ? "Student records" :
                                          root.active-view == "sessions" ? "Session workspace" :
                                          root.active-view == "assets" ? "Session materials" :
                                          root.active-view == "recording" ? "Recording studio" :
                                          root.active-view == "review" ? "Session review" :
                                          root.active-view == "ai" ? "AI workspace" :
                                          root.active-view == "guides" ? "Study guides" : "Archive settings";
                                    color: #111111;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 1.4px;
                                }
                                Text {
                                    text: root.active-view == "students" ? "Learning histories" :
                                          root.active-view == "sessions" ? "Every lesson, in context" :
                                          root.active-view == "assets" ? "Keep lesson materials with the archive" :
                                          root.active-view == "recording" ? "Capture directly into the archive" :
                                          root.active-view == "review" ? "Evidence, transcript, and materials" :
                                          root.active-view == "ai" ? "Prepare, review, and generate" :
                                          root.active-view == "guides" ? "Edit and approve learning guides" : "Portable workspace preferences";
                                    color: #111111;
                                    font-size: 27px;
                                    font-weight: 700;
                                }
                            }
                            Rectangle { }
                            Button {
                                text: "Back to journal";
                                clicked => { root.active-view = "journal"; }
                            }
                        }

                        if root.active-view == "students": Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;
                                Text { text: "Students and learning history"; color: #111111; font-size: 16px; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ComboBox {
                                        model: root.student-options;
                                        current-value <=> root.selected-student;
                                    }
                                    Button {
                                        text: "Load progress";
                                        clicked => { root.load-student-progress(root.selected-student); }
                                    }
                                }
                                Text { text: "Profile"; color: #111111; font-size: 14px; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { placeholder-text: "Name"; text <=> root.student-profile-name; }
                                    LineEdit { placeholder-text: "Grade or level"; text <=> root.student-profile-grade; }
                                    LineEdit { placeholder-text: "Subjects"; text <=> root.student-profile-subjects; }
                                    LineEdit { placeholder-text: "Preferred guide template"; text <=> root.student-profile-template; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { placeholder-text: "Learning objectives"; text <=> root.student-profile-objectives; }
                                    LineEdit { placeholder-text: "Known difficulties"; text <=> root.student-profile-difficulties; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { placeholder-text: "Demonstrated improvements"; text <=> root.student-profile-improvements; }
                                    LineEdit { placeholder-text: "Tutor notes"; text <=> root.student-profile-notes; }
                                }
                                Button {
                                    text: "Save profile";
                                    clicked => {
                                        root.save-student-profile(root.selected-student,
                                            root.student-profile-name, root.student-profile-grade,
                                            root.student-profile-subjects, root.student-profile-objectives,
                                            root.student-profile-difficulties, root.student-profile-improvements,
                                            root.student-profile-template, root.student-profile-notes);
                                    }
                                }
                                ScrollView {
                                    height: 210px;
                                    Text { text: root.student-progress-output; color: #111111; font-size: 12px; wrap: word-wrap; }
                                }
                                Text { text: "Tutor review"; color: #111111; font-size: 14px; font-weight: 600; }
                                Text { text: "Classifications require source evidence from this student's archive. Mastery requires human-verified evidence."; color: #111111; font-size: 11px; wrap: word-wrap; }
                                Text { text: "Reviewer names are tutor-entered audit labels; Tutorux does not authenticate identity."; color: #111111; font-size: 11px; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { placeholder-text: "Skill"; text <=> root.student-progress-skill; }
                                    ComboBox {
                                        model: ["newly-observed", "recurring", "partial-improvement", "demonstrated-mastery", "unverified-improvement", "not-revisited"];
                                        current-value <=> root.student-progress-classification;
                                    }
                                }
                                LineEdit { placeholder-text: "Evidence node UUIDs, comma separated"; text <=> root.student-progress-evidence-ids; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { placeholder-text: "Reviewed by (tutor-entered label)"; text <=> root.student-progress-reviewer; }
                                    LineEdit { placeholder-text: "Review note (optional)"; text <=> root.student-progress-note; }
                                }
                                Button {
                                    text: "Save reviewed progress";
                                    clicked => {
                                        root.review-student-progress(root.selected-student,
                                            root.student-progress-skill,
                                            root.student-progress-classification,
                                            root.student-progress-evidence-ids,
                                            root.student-progress-reviewer,
                                            root.student-progress-note);
                                    }
                                }
                            }
                        }
                        if root.active-view == "sessions": Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 12px;
                                Text { text: "Session workspace"; color: #111111; font-size: 16px; font-weight: 600; }
                                if root.session-options.length > 0: ComboBox {
                                    model: root.session-options;
                                    current-value <=> root.selected-session;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "Microphone device ID (optional)";
                                        text <=> root.recording-microphone-device;
                                    }
                                    LineEdit {
                                        placeholder-text: "System-audio monitor / loopback ID";
                                        text <=> root.recording-playback-device;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "WAV export path";
                                        text <=> root.recording-export-path;
                                    }
                                    LineEdit {
                                        placeholder-text: "Track ID (needed for multiple tracks)";
                                        text <=> root.recording-export-track;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Export WAV";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "export-wav", root.recording-export-path);
                                        }
                                    }
                                    Button {
                                        text: "Export with gap silence";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "export-wav-fill-gaps",
                                                root.recording-export-path);
                                        }
                                    }
                                    Button {
                                        text: "Build waveform";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "waveform", "");
                                        }
                                    }
                                    Button {
                                        text: "Cancel waveform";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "stop-waveform", "");
                                        }
                                    }
                                }
                                ScrollView {
                                    height: 110px;
                                    Text {
                                        text: root.command-output;
                                        color: #111111;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Open session details";
                                        clicked => { root.open-session(root.selected-session); }
                                    }
                                    Button {
                                        text: "Review transcript";
                                        clicked => { root.review-transcript(root.selected-session); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "Time (HH:MM:SS)";
                                        text <=> root.annotation-time;
                                    }
                                    LineEdit {
                                        placeholder-text: "Optional note";
                                        text <=> root.annotation-note;
                                    }
                                }
                                Text {
                                    text: "⌘/Ctrl + " + root.shortcut-concept + " concept · " +
                                          root.shortcut-mistake + " mistake · " +
                                          root.shortcut-correction + " correction · " +
                                          root.shortcut-instruction + " instruction · " +
                                          root.shortcut-example + " example · " +
                                          root.shortcut-follow-up + " follow up · " +
                                          root.shortcut-note + " note";
                                    color: #111111;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Concept";
                                        clicked => {
                                            root.quick-marker(root.selected-session,
                                                "important-concept", root.annotation-time,
                                                root.annotation-note);
                                        }
                                    }
                                    Button {
                                        text: "Mistake";
                                        clicked => {
                                            root.quick-marker(root.selected-session,
                                                "student-mistake", root.annotation-time,
                                                root.annotation-note);
                                        }
                                    }
                                    Button {
                                        text: "Correction";
                                        clicked => {
                                            root.quick-marker(root.selected-session,
                                                "tutor-correction", root.annotation-time,
                                                root.annotation-note);
                                        }
                                    }
                                    Button {
                                        text: "Instruction";
                                        clicked => {
                                            root.quick-marker(root.selected-session,
                                                "explicit-instruction", root.annotation-time,
                                                root.annotation-note);
                                        }
                                    }
                                    Button {
                                        text: "Worked example";
                                        clicked => {
                                            root.quick-marker(root.selected-session,
                                                "worked-example", root.annotation-time,
                                                root.annotation-note);
                                        }
                                    }
                                    Button {
                                        text: "Follow up";
                                        clicked => {
                                            root.quick-marker(root.selected-session,
                                                "follow-up-priority", root.annotation-time,
                                                root.annotation-note);
                                        }
                                    }
                                }
                                ScrollView {
                                    height: 220px;
                                    Text { text: root.sessions-text; color: #111111; font-size: 12px; wrap: word-wrap; }
                                }
                                ScrollView {
                                    height: 180px;
                                    Text { text: root.command-output; color: #111111; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }
                        if root.active-view == "assets": Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 12px;
                                Text {
                                    text: "Materials in this archive";
                                    color: #111111;
                                    font-size: 16px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Drop local files anywhere in this window to add them to this archive. The selected session is attached when one is selected. Files are copied into the archive; they are never extracted.";
                                    color: #111111;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    accessible-role: AccessibleRole.text;
                                }
                                if root.session-options.length > 0: ComboBox {
                                    model: root.session-options;
                                    current-value <=> root.selected-session;
                                }
                                LineEdit {
                                    placeholder-text: "File path to import";
                                    text <=> root.asset-input-path;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Import into session";
                                        clicked => {
                                            root.asset-command(root.selected-session, "add",
                                                root.asset-input-path);
                                        }
                                    }
                                    Button {
                                        text: "List session materials";
                                        clicked => {
                                            root.asset-command(root.selected-session, "list", "");
                                        }
                                    }
                                }
                                if root.asset-options.length > 0: HorizontalLayout {
                                    spacing: 8px;
                                    ComboBox {
                                        model: root.asset-options;
                                        current-value <=> root.selected-asset;
                                        accessible-label: "Material to preview";
                                    }
                                    Button {
                                        text: "Preview selected";
                                        enabled: root.selected-asset != "";
                                        clicked => {
                                            root.asset-command(root.selected-session, "preview",
                                                root.selected-asset);
                                        }
                                    }
                                }
                                Text {
                                    text: root.asset-preview-description;
                                    color: #111111;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    accessible-role: AccessibleRole.text;
                                }
                                if root.asset-preview-kind == "image": Rectangle {
                                    height: 340px;
                                    border-width: 1px;
                                    border-color: #111111;
                                    border-radius: 5px;
                                    background: #ffffff;
                                    Image {
                                        x: 12px;
                                        y: 12px;
                                        width: parent.width - 24px;
                                        height: parent.height - 24px;
                                        source: root.asset-preview-image;
                                        image-fit: contain;
                                        accessible-label: root.asset-preview-description;
                                    }
                                }
                                if root.asset-preview-kind == "text": Rectangle {
                                    height: 250px;
                                    border-width: 1px;
                                    border-color: #111111;
                                    border-radius: 5px;
                                    background: #ffffff;
                                    ScrollView {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: parent.height - 20px;
                                        Text {
                                            width: parent.visible-width;
                                            text: root.asset-preview-body;
                                            color: #111111;
                                            font-size: 12px;
                                            font-family: "monospace";
                                            wrap: word-wrap;
                                            accessible-role: AccessibleRole.text;
                                        }
                                    }
                                }
                                if root.asset-preview-kind == "audio": Rectangle {
                                    height: 88px;
                                    border-width: 1px;
                                    border-color: #111111;
                                    border-radius: 5px;
                                    background: #ffffff;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 4px;
                                        Text {
                                            text: root.asset-preview-waveform;
                                            color: #1e40ff;
                                            font-size: 24px;
                                            font-family: "monospace";
                                            accessible-role: AccessibleRole.text;
                                            accessible-label: "Audio waveform preview";
                                        }
                                        Text {
                                            text: root.asset-preview-body;
                                            color: #111111;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                if root.asset-preview-kind == "message": Text {
                                    text: root.asset-preview-body;
                                    color: #111111;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    accessible-role: AccessibleRole.text;
                                }
                                ScrollView {
                                    height: 260px;
                                    Text {
                                        text: root.command-output;
                                        color: #111111;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        if root.active-view == "recording": Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 12px;
                                Text {
                                    text: "Archive-backed audio capture";
                                    color: #111111;
                                    font-size: 16px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Choose a session, check your microphone, confirm consent, " +
                                          "then start capture. Recorded audio is committed directly " +
                                          "to the selected archive.";
                                    color: #111111;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                if root.session-options.length > 0: ComboBox {
                                    model: root.session-options;
                                    current-value <=> root.selected-session;
                                }
                                ComboBox {
                                    model: ["microphone", "system-audio", "both", "application", "imported-file"];
                                    current-value <=> root.recording-source;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "WAV file to import into this session";
                                        text <=> root.recording-import-path;
                                    }
                                    Button {
                                        text: "Import recording";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "import", root.recording-import-path);
                                        }
                                    }
                                }
                                LineEdit {
                                    placeholder-text: "Microphone device ID (optional)";
                                    text <=> root.recording-microphone-device;
                                }
                                LineEdit {
                                    placeholder-text: "System-audio monitor / loopback ID (optional)";
                                    text <=> root.recording-playback-device;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "Application audio ID";
                                        text <=> root.recording-application-device;
                                    }
                                    Button {
                                        text: "List audio sources";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "devices", "");
                                        }
                                    }
                                }
                            Text {
                                text: "Start both uses this application when an ID is set.";
                                color: #111111;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                                CheckBox {
                                    text: "Create provisional transcript while recording";
                                    checked <=> root.recording-live-transcription-enabled;
                                }
                                LineEdit {
                                    placeholder-text: "Local Whisper model path (GGML/GGUF)";
                                    text <=> root.recording-live-model-path;
                                }
                                Text {
                                    text: "Live transcription needs one source and a local Whisper model. Segments are provisional until reviewed.";
                                    color: #111111;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "Speak naturally during the short microphone check. It is temporary " +
                                          "and is not saved in the archive.";
                                    color: #111111;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Check microphone";
                                        clicked => {
                                            root.check-recording-device(
                                                root.recording-microphone-device);
                                        }
                                    }
                                    Rectangle {
                                        width: 240px;
                                        height: 12px;
                                        border-width: 1px;
                                        border-color: #111111;
                                        border-radius: 5px;
                                        background: #ffffff;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            width: parent.width * root.recording-input-level / 100;
                                            height: parent.height;
                                            border-radius: 5px;
                                            background: #1e40ff;
                                        }
                                    }
                                    Text {
                                        text: root.recording-preflight-output;
                                        color: #111111;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }
                                CheckBox {
                                    text: "I confirm that everyone being recorded has agreed to this recording.";
                                    checked <=> root.recording-consent-confirmed;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Start selected source";
                                        enabled: root.recording-source != "imported-file" &&
                                            root.recording-consent-confirmed &&
                                            ((root.recording-source == "microphone" || root.recording-source == "both") ?
                                                (root.recording-preflight-ready &&
                                                 root.recording-preflight-requested-device-id ==
                                                     root.recording-microphone-device) :
                                                (root.recording-source != "application" ||
                                                 root.recording-application-device != ""));
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "start", root.recording-source);
                                        }
                                    }
                                    Button {
                                        text: "Pause";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "pause", "");
                                        }
                                    }
                                    Button {
                                        text: "Resume";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "resume", "");
                                        }
                                    }
                                    Button {
                                        text: "Stop";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "stop", "");
                                        }
                                    }
                                    Button {
                                        text: "Status";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "status", "");
                                        }
                                    }
                                }
                                ScrollView {
                                    height: 180px;
                                    Text {
                                        text: root.command-output;
                                        color: #111111;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        if root.active-view == "review": Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 12px;
                                Text {
                                    text: "Review the source before approval";
                                    color: #111111;
                                    font-size: 16px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Correct transcript wording and verify it against the recording. " +
                                          "Human corrections remain revisioned in the archive.";
                                    color: #111111;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                if root.session-options.length > 0: ComboBox {
                                    model: root.session-options;
                                    current-value <=> root.selected-session;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    if root.transcript-options.length > 0: ComboBox {
                                        model: root.transcript-options;
                                        current-value <=> root.selected-transcript;
                                    }
                                    Button {
                                        text: "Refresh transcript";
                                        clicked => { root.review-transcript(root.selected-session); }
                                    }
                                    Button {
                                        text: "Load segment";
                                        clicked => {
                                            root.load-transcript(root.selected-session,
                                                root.selected-transcript);
                                        }
                                    }
                                    Button {
                                        text: "Play from timestamp";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "play-transcript", "");
                                        }
                                    }
                                    Button {
                                        text: "Stop audio";
                                        clicked => {
                                            root.recording-command(root.selected-session,
                                                "stop-playback", "");
                                        }
                                    }
                                }
                                Text {
                                    text: root.transcript-provenance;
                                    color: #111111;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                TextInput {
                                    height: 120px;
                                    single-line: false;
                                    wrap: word-wrap;
                                    text <=> root.transcript-edit-text;
                                }
                                Button {
                                    text: "Save human correction";
                                    clicked => {
                                        root.save-transcript(root.selected-session,
                                            root.selected-transcript, root.transcript-edit-text);
                                    }
                                }
                                ScrollView { height: 230px; Text { text: root.command-output; color: #111111; font-size: 12px; wrap: word-wrap; } }
                            }
                        }
                        if root.active-view == "ai": Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 12px;
                                Text {
                                    text: "Choose a workflow";
                                    color: #111111;
                                    font-size: 16px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Manual packages need no API key. BYOK sends data only after " +
                                          "you review the exact request and confirm its hash.";
                                    color: #111111;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                LineEdit {
                                    placeholder-text: "Provider ID, such as openai, ollama, llama.cpp-embedded";
                                    text <=> root.ai-provider-id;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "Optional provider endpoint";
                                        text <=> root.ai-endpoint;
                                    }
                                    LineEdit {
                                        placeholder-text: "Model ID";
                                        text <=> root.ai-model-id;
                                    }
                                    LineEdit {
                                        placeholder-text: "GGUF model path (embedded llama.cpp)";
                                        text <=> root.ai-model-path;
                                    }
                                    Button {
                                        text: "Configure";
                                        clicked => {
                                            root.ai-command(root.ai-provider-id, "configure",
                                                root.selected-session, "");
                                        }
                                    }
                                    Button {
                                        text: "Select GGUF";
                                        clicked => {
                                            root.ai-command(root.ai-provider-id, "select-embedded",
                                                root.selected-session, "");
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Provider integrations";
                                        clicked => {
                                            root.ai-command(root.ai-provider-id, "providers",
                                                "", "");
                                        }
                                    }
                                    Button {
                                        text: "Refresh model catalog";
                                        clicked => {
                                            root.ai-command(root.ai-provider-id, "models", "", "");
                                        }
                                    }
                                }
                                if root.session-options.length > 0: ComboBox {
                                    model: root.session-options;
                                    current-value <=> root.selected-session;
                                }
                                LineEdit {
                                    placeholder-text: "Optional manual package export path";
                                    text <=> root.ai-package-path;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Prepare manual chat package";
                                        clicked => {
                                            root.ai-command(root.ai-provider-id, "package",
                                                root.selected-session, root.ai-package-path);
                                        }
                                    }
                                    Button {
                                        text: "Prepare ZIP handoff with assets";
                                        clicked => {
                                            root.ai-command(root.ai-provider-id, "zip-package",
                                                root.selected-session, root.ai-package-path);
                                        }
                                    }
                                    Button {
                                        text: "Prepare local package";
                                        clicked => {
                                            root.ai-command(root.ai-provider-id, "local-package",
                                                root.selected-session, root.ai-package-path);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "AI package job ID";
                                        text <=> root.ai-package-job-id;
                                    }
                                    LineEdit {
                                        placeholder-text: "API key environment variable";
                                        text <=> root.ai-api-key-environment;
                                    }
                                    Button {
                                        text: "Preview / run locally";
                                        clicked => {
                                            root.ai-command(root.ai-provider-id, "generate",
                                                root.selected-session, "");
                                        }
                                    }
                                }
                                LineEdit {
                                    placeholder-text: "Review the request, then paste its exact body SHA-256 here";
                                    text <=> root.ai-confirmation-hash;
                                }
                                Button {
                                    text: "Confirm outbound request";
                                    clicked => {
                                        root.ai-command(root.ai-provider-id, "confirm-send",
                                            root.selected-session, "");
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: "External response JSON file path";
                                        text <=> root.ai-response-path;
                                    }
                                    Button {
                                        text: "Import external response";
                                        clicked => {
                                            root.ai-command(root.ai-provider-id, "import",
                                                root.selected-session, root.ai-response-path);
                                        }
                                    }
                                }
                                ScrollView {
                                    height: 220px;
                                    Text {
                                        text: root.command-output;
                                        color: #111111;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        if root.active-view == "guides": Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 12px;
                                Text {
                                    text: "Guide review and export";
                                    color: #111111;
                                    font-size: 16px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Review source-linked content, validate it, explicitly approve " +
                                          "the guide, then export a copy.";
                                    color: #111111;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                if root.guide-options.length > 0: ComboBox {
                                    model: root.guide-options;
                                    current-value <=> root.selected-guide;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    if root.guide-block-options.length > 0: ComboBox {
                                        model: root.guide-block-options;
                                        current-value <=> root.selected-guide-block;
                                    }
                                    Button {
                                        text: "Load block";
                                        clicked => {
                                            root.load-guide-block(root.selected-guide,
                                                root.selected-guide-block);
                                        }
                                    }
                                    Button {
                                        text: "Save reviewed block";
                                        clicked => {
                                            root.save-guide-block(root.selected-guide,
                                                root.selected-guide-block, root.guide-edit-text);
                                        }
                                    }
                                }
                                Text {
                                    text: root.guide-provenance;
                                    color: #111111;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        width: 270px;
                                        placeholder-text: "Source or asset UUID";
                                        text <=> root.guide-reference-id;
                                    }
                                    Button {
                                        text: "Insert source";
                                        clicked => {
                                            root.insert-guide-markup("source",
                                                                     root.guide-reference-id);
                                        }
                                    }
                                    Button {
                                        text: "Insert image";
                                        clicked => {
                                            root.insert-guide-markup("image",
                                                                     root.guide-reference-id);
                                        }
                                    }
                                    Button {
                                        text: "Code";
                                        clicked => { root.insert-guide-markup("code", ""); }
                                    }
                                    Button {
                                        text: "Equation";
                                        clicked => { root.insert-guide-markup("equation", ""); }
                                    }
                                    Button {
                                        text: "Table";
                                        clicked => { root.insert-guide-markup("table", ""); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    ComboBox {
                                        model: ["paragraph", "list-item", "quote", "code", "equation",
                                            "table", "image", "figure", "example", "instruction",
                                            "recommendation", "worked-example"];
                                        current-value <=> root.guide-block-kind;
                                    }
                                    Button {
                                        text: "Set block type";
                                        clicked => {
                                            root.insert-guide-markup(root.guide-block-kind, "");
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        placeholder-text: "Find in this block";
                                        text <=> root.guide-find-query;
                                    }
                                    Button {
                                        text: "Find next";
                                        clicked => {
                                            root.find-guide-next(root.guide-find-query);
                                        }
                                    }
                                    Button {
                                        text: "Replace";
                                        clicked => {
                                            root.replace-guide-match(root.guide-find-query,
                                                root.guide-replace-text);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        placeholder-text: "Replace with";
                                        text <=> root.guide-replace-text;
                                    }
                                    Button {
                                        text: "Replace all";
                                        clicked => {
                                            root.replace-all-guide-matches(root.guide-find-query,
                                                root.guide-replace-text);
                                        }
                                    }
                                }
                                guide-editor-text-input := GuideDocumentEditor {
                                    height: 170px;
                                    text <=> root.guide-edit-text;
                                    anchor-offset <=> root.guide-edit-anchor;
                                    focus-offset <=> root.guide-edit-focus;
                                    edited(text, focus, anchor) => {
                                        root.guide-edit-input-changed(text, focus, anchor);
                                    }
                                    selection-changed(focus, anchor) => {
                                        root.guide-edit-anchor = anchor;
                                        root.guide-edit-focus = focus;
                                        root.guide-edit-selection-changed(focus, anchor);
                                    }
                                    undo-requested => { root.guide-edit-undo(); }
                                    redo-requested => { root.guide-edit-redo(); }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Open guide";
                                        clicked => {
                                            root.guide-command(root.selected-guide, "show", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Validate sources";
                                        clicked => {
                                            root.guide-command(root.selected-guide, "validate", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Approve guide";
                                        clicked => {
                                            root.guide-command(root.selected-guide, "approve", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Compare revisions";
                                        clicked => {
                                            root.guide-command(root.selected-guide, "compare", "", "");
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Regenerate this section";
                                        clicked => {
                                            root.guide-command(root.selected-guide,
                                                "regenerate-section", "", "");
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Add example";
                                        clicked => {
                                            root.guide-command(root.selected-guide,
                                                "add-example", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Remove block";
                                        clicked => {
                                            root.guide-command(root.selected-guide,
                                                "remove-block", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Move section up";
                                        clicked => {
                                            root.guide-command(root.selected-guide,
                                                "move-section-up", "", "");
                                        }
                                    }
                                    Button {
                                        text: "Move section down";
                                        clicked => {
                                            root.guide-command(root.selected-guide,
                                                "move-section-down", "", "");
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ComboBox {
                                        model: ["markdown", "html", "pdf", "docx"];
                                        current-value <=> root.guide-export-format;
                                    }
                                    LineEdit {
                                        placeholder-text: "Export file path";
                                        text <=> root.guide-export-path;
                                    }
                                    Button {
                                        text: "Export";
                                        clicked => {
                                            root.guide-command(root.selected-guide, "export",
                                                root.guide-export-format, root.guide-export-path);
                                        }
                                    }
                                }
                                ScrollView {
                                    height: 260px;
                                    Text {
                                        text: root.guide-output;
                                        color: #111111;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        if root.active-view == "settings": Rectangle {
                            border-radius: 5px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 12px;
                                Text { text: "Archive-specific configuration"; color: #111111; font-size: 16px; font-weight: 600; }
                                Text { text: "Tutorux stores workspace settings in the selected .tux archive. API keys are read from environment variables unless you explicitly save an encrypted credential record."; color: #111111; font-size: 13px; wrap: word-wrap; }
                                Text { text: "settings list   ·   settings get KEY   ·   settings set KEY VALUE   ·   archive verify --full"; color: #1e40ff; font-size: 12px; wrap: word-wrap; }
                                Text {
                                    text: "Quick marker keys (Control on Windows/Linux, Command on macOS)";
                                    color: #111111;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { placeholder-text: "Concept"; text <=> root.shortcut-concept; }
                                    LineEdit { placeholder-text: "Mistake"; text <=> root.shortcut-mistake; }
                                    LineEdit { placeholder-text: "Correction"; text <=> root.shortcut-correction; }
                                    LineEdit { placeholder-text: "Instruction"; text <=> root.shortcut-instruction; }
                                    LineEdit { placeholder-text: "Example"; text <=> root.shortcut-example; }
                                    LineEdit { placeholder-text: "Follow up"; text <=> root.shortcut-follow-up; }
                                    LineEdit { placeholder-text: "Note"; text <=> root.shortcut-note; }
                                }
                                Button {
                                    text: "Save marker keys to this archive";
                                    clicked => {
                                        root.save-marker-shortcuts(root.shortcut-concept,
                                            root.shortcut-mistake, root.shortcut-correction,
                                            root.shortcut-instruction, root.shortcut-example,
                                            root.shortcut-follow-up, root.shortcut-note);
                                    }
                                }
                            }
                        }

                        CommandPanel {
                            command-input <=> root.command-input;
                            command-output <=> root.command-output;
                            command-running <=> root.command-running;
                            run-command => { root.run-command(root.command-input, root.new-archive-passphrase); }
                            cancel-command => { root.cancel-command(); }
                        }
                    }
                    }

                    if root.recording-panel-open: Rectangle {
                        height: 300px;
                        border-width: 1px;
                        border-color: #111111;
                        border-radius: 5px;
                        background: #ffffff;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Capture controls";
                                    color: #111111;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                }
                                Rectangle { }
                                if root.journal-session-options.length > 0: ComboBox {
                                    model: root.journal-session-options;
                                    current-value <=> root.selected-journal-session;
                                }
                                Button {
                                    text: "Recording studio";
                                    clicked => {
                                        root.selected-session =
                                            root.journal-session-id == "" ?
                                                root.selected-journal-session :
                                                root.journal-session-id;
                                        root.active-view = "recording";
                                    }
                                }
                                Button {
                                    text: "Hide";
                                    clicked => { root.recording-panel-open = false; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                ComboBox {
                                    model: ["microphone", "system-audio", "both", "application", "imported-file"];
                                    current-value <=> root.recording-source;
                                }
                                LineEdit {
                                    placeholder-text: "Microphone device ID (optional)";
                                    text <=> root.recording-microphone-device;
                                }
                                Button {
                                    text: "Check microphone";
                                    clicked => {
                                        root.check-recording-device(
                                            root.recording-microphone-device);
                                    }
                                }
                                Rectangle {
                                    width: 160px;
                                    height: 12px;
                                    border-width: 1px;
                                    border-color: #111111;
                                    border-radius: 5px;
                                    background: #ffffff;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width * root.recording-input-level / 100;
                                        height: parent.height;
                                        border-radius: 5px;
                                        background: #1e40ff;
                                    }
                                }
                                Text {
                                    text: root.recording-preflight-output;
                                    color: #111111;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                            LineEdit {
                                placeholder-text: "System-audio monitor / loopback ID (optional)";
                                text <=> root.recording-playback-device;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    placeholder-text: "Application audio ID";
                                    text <=> root.recording-application-device;
                                }
                                Button {
                                    text: "List audio sources";
                                    clicked => {
                                        root.recording-command(
                                            root.journal-session-id == "" ?
                                                root.selected-journal-session :
                                                root.journal-session-id,
                                            "devices", "");
                                    }
                                }
                            }
                                Text {
                                    text: "Start both tracks uses this application when an ID is set.";
                                    color: #111111;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            if root.recording-source == "imported-file": HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    placeholder-text: "WAV recording to import";
                                    text <=> root.recording-import-path;
                                }
                                Button {
                                    text: "Import recording";
                                    enabled: root.recording-import-path != "";
                                    clicked => {
                                        root.recording-command(
                                            root.journal-session-id == "" ?
                                                root.selected-journal-session :
                                                root.journal-session-id,
                                            "import", root.recording-import-path);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                CheckBox {
                                    text: "Everyone recorded has agreed";
                                    checked <=> root.recording-consent-confirmed;
                                }
                                Button {
                                    text: "Start selected source";
                                    enabled: root.recording-consent-confirmed &&
                                        root.recording-source != "imported-file" &&
                                        ((root.recording-source == "microphone" || root.recording-source == "both") ?
                                            (root.recording-preflight-ready &&
                                             root.recording-preflight-requested-device-id ==
                                                 root.recording-microphone-device) :
                                            (root.recording-source != "application" ||
                                             root.recording-application-device != "")) &&
                                        (root.journal-session-id != "" ||
                                         root.selected-journal-session != "");
                                    clicked => {
                                        root.recording-command(
                                            root.journal-session-id == "" ?
                                                root.selected-journal-session :
                                                root.journal-session-id,
                                            "start", root.recording-source);
                                    }
                                }
                                Button {
                                    text: "Pause";
                                    enabled: root.journal-session-id != "" ||
                                             root.selected-journal-session != "";
                                    clicked => {
                                        root.recording-command(
                                            root.journal-session-id == "" ?
                                                root.selected-journal-session :
                                                root.journal-session-id,
                                            "pause", "");
                                    }
                                }
                                Button {
                                    text: "Resume";
                                    enabled: root.journal-session-id != "" ||
                                             root.selected-journal-session != "";
                                    clicked => {
                                        root.recording-command(
                                            root.journal-session-id == "" ?
                                                root.selected-journal-session :
                                                root.journal-session-id,
                                            "resume", "");
                                    }
                                }
                                Button {
                                    text: "Stop";
                                    enabled: root.journal-session-id != "" ||
                                             root.selected-journal-session != "";
                                    clicked => {
                                        root.recording-command(
                                            root.journal-session-id == "" ?
                                                root.selected-journal-session :
                                                root.journal-session-id,
                                            "stop", "");
                                    }
                                }
                                Button {
                                    text: "Status";
                                    enabled: root.journal-session-id != "" ||
                                             root.selected-journal-session != "";
                                    clicked => {
                                        root.recording-command(
                                            root.journal-session-id == "" ?
                                                root.selected-journal-session :
                                                root.journal-session-id,
                                            "status", "");
                                    }
                                }
                            }
                            Text {
                                text: root.recording-status-output;
                                color: #111111;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
        }
    }

        if drop-area.has-drag: Rectangle {
            x: 32px;
            y: 32px;
            width: parent.width - 64px;
            height: parent.height - 64px;
            border-width: 2px;
            border-color: #1e40ff;
            border-radius: 5px;
            background: #ffffff;
            opacity: 0.96;
            accessible-role: AccessibleRole.groupbox;
            accessible-label: "Release to import the dropped files into Tutorux.";

            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: "Drop files to import";
                    color: #111111;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    accessible-role: AccessibleRole.text;
                }
                Text {
                    text: root.selected-session == ""
                        ? "Files will be added to this archive without a session."
                        : "Files will be added to the selected session.";
                    color: #111111;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }
