import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

component GuideDocumentEditor inherits Rectangle {
    in-out property <string> text;
    in-out property <int> anchor-offset: 0;
    in-out property <int> focus-offset: 0;
    callback edited(string, int, int);
    callback selection-changed(int, int);
    callback undo-requested();
    callback redo-requested();

    public function set-selection-offsets(anchor: int, focus: int) {
        editor.set-selection-offsets(anchor, focus);
    }

    changed anchor-offset => {
        editor.set-selection-offsets(root.anchor-offset, root.focus-offset);
    }
    changed focus-offset => {
        editor.set-selection-offsets(root.anchor-offset, root.focus-offset);
    }

    border-width: 1px;
    border-color: #111111;
    border-radius: 5px;
    background: #ffffff;

    ScrollView {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        content-width: self.visible-width;
        content-height: max(self.visible-height, editor.preferred-height);

        editor := TextInput {
            width: parent.visible-width;
            height: max(parent.visible-height, self.preferred-height);
            single-line: false;
            wrap: word-wrap;
            text <=> root.text;
            font-size: 13px;
            color: #111111;
            selection-background-color: #e8edff;
            selection-foreground-color: #111111;

            edited => {
                root.edited(self.text, self.cursor-position-byte-offset,
                            self.anchor-position-byte-offset);
            }
            key-pressed(event) => {
                if ((event.modifiers.control || event.modifiers.meta) && event.text == Key.Z) {
                    if (event.modifiers.shift) {
                        root.redo-requested();
                    } else {
                        root.undo-requested();
                    }
                    accept
                } else if (event.modifiers.control && event.text == Key.Y) {
                    root.redo-requested();
                    accept
                } else {
                    reject
                }
            }
            cursor-position-changed(position) => {
                root.anchor-offset = self.anchor-position-byte-offset;
                root.focus-offset = self.cursor-position-byte-offset;
                root.selection-changed(self.cursor-position-byte-offset,
                                       self.anchor-position-byte-offset);
            }
        }
    }
}

component CommandPanel inherits Rectangle {
    in-out property <string> command-input;
    in-out property <string> command-output;
    in-out property <bool> command-running: false;
    callback run-command();
    callback cancel-command();

    border-radius: 5px;
    background: #ffffff;
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        Text { text: "ARCHIVE COMMAND"; color: #111111; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                placeholder-text: "Enter a Tutorux command, for example: session list";
                text <=> root.command-input;
                accepted => { root.run-command(); }
            }
            Button { text: "Run"; clicked => { root.run-command(); } }
            if root.command-running: Button { text: "Cancel"; clicked => { root.cancel-command(); } }
        }
        ScrollView {
            height: 132px;
            Text { text: root.command-output; color: #111111; font-size: 11px; wrap: word-wrap; }
        }
    }
}

