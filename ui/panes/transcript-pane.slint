// Transcript tab: segment list, correction editor, and honest provenance.
import { Button, ComboBox, LineEdit, ScrollArea, ScrollText, TextArea, Theme } from "../theme.slint";
import { Field, FormWrap } from "../components/page-parts.slint";

export component TranscriptPane inherits Rectangle {
    in property <[string]> options: [];
    in property <[string]> revision-options: [];
    in property <[string]> evidence-options: [];
    in property <string> provenance;
    in property <string> command-output;
    in property <string> evidence-output;
    in property <[string]> evidence-edge-options: [];
    in property <bool> writable: true;
    in property <bool> has-session: false;
    in-out property <string> selected-segment;
    in-out property <string> selected-evidence;
    in-out property <string> selected-evidence-target;
    in-out property <string> selected-evidence-edge;
    in-out property <string> evidence-title;
    in-out property <string> evidence-type: "concept";
    in-out property <string> evidence-content;
    in-out property <string> evidence-relationship: "supports";
    in-out property <string> edit-text;
    in-out property <string> speaker-name;
    in-out property <string> start-time;
    in-out property <string> end-time;
    in-out property <string> selected-revision;
    in-out property <string> reject-reason;
    in-out property <string> import-path;
    in-out property <string> split-before;
    in-out property <string> split-after;
    in-out property <string> merge-target;

    callback load-segments();
    callback browse-import();
    callback load-segment();
    callback play();
    callback stop-playback();
    callback save();
    callback save-speaker(string, bool);
    callback save-timestamps(string, string);
    callback restore-revision(string);
    callback open-console();
    callback evidence(string, string, string, string, string);
    callback import-transcript(string);
    callback split-segment(string, string, string);
    callback merge-segments(string, string);
    callback remove-segment(string);

    horizontal-stretch: 1;
    vertical-stretch: 1;
    clip: true;
    background: Theme.surface;

    ScrollArea {
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, page.preferred-height);
        vertical-scrollbar-policy: as-needed;

        page := VerticalLayout {
            x: max(0px, (root.width - self.width) / 2);
            width: min(root.width - 14px, 867px);
            padding-left: 48px;
            padding-right: 48px;
            padding-top: 26px;
            padding-bottom: 64px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Transcript";
                    color: Theme.ink;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { }
                Button {
                    text: "Load segments";
                    enabled: root.has-session && root.writable;
                    clicked => { root.load-segments(); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "Transcript file path (.txt, .srt, .vtt)";
                    text <=> root.import-path;
                    enabled: root.writable;
                }
                Button {
                    text: "Browse…";
                    clicked => { root.browse-import(); }
                }
                Button {
                    text: "Import";
                    enabled: root.has-session && root.import-path != "" && root.writable;
                    clicked => { root.import-transcript(root.import-path); }
                }
            }

            Rectangle { height: 1px; background: Theme.line; }

            Text {
                text: root.provenance;
                color: Theme.muted;
                font-size: 12px;
                line-height-factor: 1.4;
                wrap: word-wrap;
            }

            if root.options.length > 0 : VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Segment"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                        ComboBox {
                            model: root.options;
                            current-value <=> root.selected-segment;
                        }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: " "; color: Theme.faint; font-size: 12px; }
                        Button {
                            text: "Load segment";
                            enabled: root.selected-segment != "";
                            clicked => { root.load-segment(); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        text: "Play from timestamp";
                        enabled: root.selected-segment != "";
                        clicked => { root.play(); }
                    }
                    Button {
                        text: "Stop audio";
                        clicked => { root.stop-playback(); }
                    }
                    Rectangle { }
                }

                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Text before split";
                        text <=> root.split-before;
                        enabled: root.writable;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Text after split";
                        text <=> root.split-after;
                        enabled: root.writable;
                    }
                    Button {
                        text: "Split";
                        enabled: root.has-session && root.selected-segment != "" &&
                                 root.split-before != "" && root.split-after != "" && root.writable;
                        clicked => {
                            root.split-segment(root.selected-segment,
                                               root.split-before, root.split-after);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.options;
                        current-value <=> root.merge-target;
                    }
                    Button {
                        text: "Merge with selected";
                        enabled: root.selected-segment != "" && root.merge-target != "" &&
                                 root.merge-target != root.selected-segment && root.writable;
                        clicked => { root.merge-segments(root.selected-segment, root.merge-target); }
                    }
                    Button {
                        text: "Move to Trash";
                        variant: "danger";
                        enabled: root.selected-segment != "" && root.writable;
                        clicked => { root.remove-segment(root.selected-segment); }
                    }
                }

                Text { text: "Corrected text"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Speaker name";
                        text <=> root.speaker-name;
                        enabled: root.writable;
                    }
                    Button {
                        text: "Save speaker";
                        enabled: root.has-session && root.selected-segment != "" && root.writable;
                        clicked => { root.save-speaker(root.speaker-name, false); }
                    }
                    Button {
                        text: "Mark unknown";
                        enabled: root.has-session && root.selected-segment != "" && root.writable;
                        clicked => { root.save-speaker("", true); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Start (HH:MM:SS.mmm)";
                        text <=> root.start-time;
                        enabled: root.writable;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "End (HH:MM:SS.mmm)";
                        text <=> root.end-time;
                        enabled: root.writable;
                    }
                    Button {
                        text: "Save times";
                        enabled: root.has-session && root.selected-segment != "" && root.writable;
                        clicked => { root.save-timestamps(root.start-time, root.end-time); }
                    }
                }
                TextArea {
                    height: 300px;
                    text <=> root.edit-text;
                    placeholder-text: "Correct the selected transcript segment…";
                    font-size: 14px;
                    enabled: root.writable;
                }

                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: "Save correction";
                        variant: "primary";
                        enabled: root.has-session && root.selected-segment != "" &&
                                 root.edit-text != "" && root.writable;
                        clicked => { root.save(); }
                    }
                    Rectangle { }
                }
                if root.revision-options.length > 0 : HorizontalLayout {
                    spacing: 8px;
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.revision-options;
                        current-value <=> root.selected-revision;
                    }
                    Button {
                        text: "Restore selected version";
                        variant: "ghost";
                        enabled: root.selected-revision != "" && root.writable;
                        clicked => { root.restore-revision(root.selected-revision); }
                    }
                }
            }

            if root.options.length == 0 : VerticalLayout {
                spacing: 10px;
                Text {
                    text: "No transcript segments are loaded for this session.";
                    color: Theme.body;
                    font-size: 14px;
                }
                Text {
                    text: "Import a transcript file above, or load segments after transcription.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: 1px; background: Theme.line; }
            Text { text: "Evidence"; color: Theme.ink; font-size: 18px; font-weight: 700; }
            Text {
                text: "Create session evidence, correct extracted details, review it, and connect related items.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: "Extract from session";
                    enabled: root.has-session && root.writable;
                    clicked => { root.evidence("extract", "", "", "", ""); }
                }
                Button {
                    text: "Refresh evidence";
                    enabled: root.has-session;
                    clicked => { root.evidence("list", "", "", "", ""); }
                }
                Button {
                    text: "Show";
                    enabled: root.selected-evidence != "";
                    clicked => { root.evidence("show", "", "", "", ""); }
                }
                Button {
                    text: "Approve";
                    enabled: root.selected-evidence != "" && root.writable;
                    clicked => { root.evidence("approve", "", "", "", ""); }
                }
                Button {
                    text: "Verify";
                    enabled: root.selected-evidence != "";
                    clicked => { root.evidence("verify", "", "", "", ""); }
                }
                Rectangle { }
            }
            if root.evidence-options.length > 0 : ComboBox {
                model: root.evidence-options;
                current-value <=> root.selected-evidence;
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    placeholder-text: "Rejection reason (optional)";
                    text <=> root.reject-reason;
                }
                Button {
                    text: "Reject";
                    variant: "danger";
                    enabled: root.selected-evidence != "" && root.writable;
                    clicked => { root.evidence("reject", root.reject-reason, "", "", ""); }
                }
                Rectangle { }
            }
            FormWrap {
                Field { label: "Title"; LineEdit { text <=> root.evidence-title; enabled: root.writable; } }
                Field { label: "Type"; LineEdit { text <=> root.evidence-type; enabled: root.writable; } }
                Field {
                    label: "Content";
                    TextArea { height: 108px; text <=> root.evidence-content; enabled: root.writable; }
                }
            }
            Text {
                text: root.selected-segment == "" ?
                    "Select a transcript segment above to attach it as the evidence source." :
                    "Source: the selected transcript segment. Its revision is recorded with this item.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Create evidence";
                    variant: "primary";
                    enabled: root.writable && root.has-session && root.selected-segment != "" &&
                             root.evidence-title != "" && root.evidence-content != "";
                    clicked => { root.evidence("create", "", "", "", root.selected-segment); }
                }
                Button {
                    text: "Save edits";
                    enabled: root.writable && root.selected-evidence != "" && root.evidence-title != "" && root.evidence-content != "";
                    clicked => { root.evidence("update", "", "", "", ""); }
                }
                Button {
                    text: "Move to Trash";
                    variant: "danger";
                    enabled: root.writable && root.selected-evidence != "";
                    clicked => { root.evidence("delete", "", "", "", ""); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                ComboBox {
                    model: root.evidence-options;
                    current-value <=> root.selected-evidence-target;
                    horizontal-stretch: 1;
                }
                ComboBox {
                    model: ["supports", "explains", "corrects", "demonstrates", "contradicts",
                            "references", "depends-on", "reinforces", "recommends", "derived-from"];
                    current-value <=> root.evidence-relationship;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Link selected items";
                    enabled: root.writable && root.selected-evidence != "" &&
                             root.selected-evidence-target != "" &&
                             root.selected-evidence != root.selected-evidence-target;
                    clicked => { root.evidence("link", "", root.selected-evidence-target, root.evidence-relationship, ""); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                ComboBox {
                    model: root.evidence-edge-options;
                    current-value <=> root.selected-evidence-edge;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Refresh links";
                    enabled: root.has-session;
                    clicked => { root.evidence("edges", "", "", "", ""); }
                }
                Button {
                    text: "Remove link";
                    variant: "danger";
                    enabled: root.writable && root.selected-evidence-edge != "";
                    clicked => { root.evidence("unlink", "", root.selected-evidence-edge, "", ""); }
                }
            }
            ScrollText {
                height: 160px;
                text: root.evidence-output;
                text-color: Theme.body;
                font-size: 12px;
            }

            Text { text: "Command output"; color: Theme.faint; font-size: 12px; font-weight: 600; }
            ScrollText {
                height: 180px;
                text: root.command-output;
                text-color: Theme.body;
                font-size: 12px;
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
            }
        }
    }
}
