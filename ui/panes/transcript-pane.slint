// Transcript tab: segment list, correction editor, and honest provenance.
import { Button, ComboBox, LineEdit, ScrollArea, ScrollText, Theme } from "../theme.slint";

export component TranscriptPane inherits Rectangle {
    in property <[string]> options: [];
    in property <[string]> evidence-options: [];
    in property <string> provenance;
    in property <string> command-output;
    in property <string> evidence-output;
    in property <bool> writable: true;
    in property <bool> has-session: false;
    in-out property <string> selected-segment;
    in-out property <string> selected-evidence;
    in-out property <string> edit-text;
    in-out property <string> reject-reason;

    callback load-segments();
    callback load-segment();
    callback play();
    callback stop-playback();
    callback save();
    callback open-console();
    callback evidence(string, string);

    horizontal-stretch: 1;
    vertical-stretch: 1;
    clip: true;
    background: Theme.surface;

    ScrollArea {
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, page.preferred-height);
        vertical-scrollbar-policy: as-needed;

        page := VerticalLayout {
            x: max(0px, (root.width - self.width) / 2);
            width: min(root.width - 14px, 867px);
            padding-left: 48px;
            padding-right: 48px;
            padding-top: 26px;
            padding-bottom: 64px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Transcript";
                    color: Theme.ink;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { }
                Button {
                    text: "Load segments";
                    enabled: root.has-session;
                    clicked => { root.load-segments(); }
                }
            }

            Rectangle { height: 1px; background: Theme.line; }

            Text {
                text: root.provenance;
                color: Theme.muted;
                font-size: 12px;
                line-height-factor: 1.4;
                wrap: word-wrap;
            }

            if root.options.length > 0 : VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Segment"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                        ComboBox {
                            model: root.options;
                            current-value <=> root.selected-segment;
                        }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: " "; color: Theme.faint; font-size: 12px; }
                        Button {
                            text: "Load segment";
                            enabled: root.selected-segment != "";
                            clicked => { root.load-segment(); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        text: "Play from timestamp";
                        enabled: root.selected-segment != "";
                        clicked => { root.play(); }
                    }
                    Button {
                        text: "Stop audio";
                        clicked => { root.stop-playback(); }
                    }
                    Rectangle { }
                }

                Text { text: "Corrected text"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                TextInput {
                    height: 300px;
                    single-line: false;
                    wrap: word-wrap;
                    text <=> root.edit-text;
                    font-size: 14px;
                    color: Theme.body;
                }

                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: "Save correction";
                        variant: "primary";
                        enabled: root.has-session && root.selected-segment != "" &&
                                 root.edit-text != "" && root.writable;
                        clicked => { root.save(); }
                    }
                    Rectangle { }
                }
            }

            if root.options.length == 0 : VerticalLayout {
                spacing: 10px;
                Text {
                    text: "No transcript segments are loaded for this session.";
                    color: Theme.body;
                    font-size: 14px;
                }
                Text {
                    text: "Load segments after transcription, or import a transcript through the command console.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: "Open command console";
                        clicked => { root.open-console(); }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.line; }
            Text { text: "Evidence review"; color: Theme.ink; font-size: 14px; font-weight: 700; }
            Text {
                text: "Evidence is attached to the selected session. Approvals and rejections are recorded in the archive.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: "Extract";
                    enabled: root.has-session;
                    clicked => { root.evidence("extract", ""); }
                }
                Button {
                    text: "List";
                    enabled: root.has-session;
                    clicked => { root.evidence("list", ""); }
                }
                Button {
                    text: "Show";
                    enabled: root.selected-evidence != "";
                    clicked => { root.evidence("show", ""); }
                }
                Button {
                    text: "Approve";
                    enabled: root.selected-evidence != "";
                    clicked => { root.evidence("approve", ""); }
                }
                Button {
                    text: "Verify";
                    enabled: root.selected-evidence != "";
                    clicked => { root.evidence("verify", ""); }
                }
                Rectangle { }
            }
            if root.evidence-options.length > 0 : ComboBox {
                model: root.evidence-options;
                current-value <=> root.selected-evidence;
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    placeholder-text: "Rejection reason (optional)";
                    text <=> root.reject-reason;
                }
                Button {
                    text: "Reject";
                    variant: "danger";
                    enabled: root.selected-evidence != "";
                    clicked => { root.evidence("reject", root.reject-reason); }
                }
                Rectangle { }
            }
            ScrollText {
                height: 160px;
                text: root.evidence-output;
                text-color: Theme.body;
                font-size: 12px;
            }

            Text { text: "Command output"; color: Theme.faint; font-size: 12px; font-weight: 600; }
            ScrollText {
                height: 180px;
                text: root.command-output;
                text-color: Theme.body;
                font-size: 12px;
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
            }
        }
    }
}
