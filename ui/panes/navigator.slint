// Left navigator: scopes, filtering, session/student/material lists, archive
// footer. All rows come from the controller; nothing here is sample data.
import { IconButton, LineEdit, ScrollArea, TabButton, Theme } from "../theme.slint";
import { MaterialRow, SessionRow, StudentRow } from "../models.slint";

export component Navigator inherits Rectangle {
    in property <string> archive-path;
    in property <string> archive-name;
    in property <string> archive-status;
    in property <bool> archive-busy: false;
    in property <bool> archive-writable: true;
    in property <[SessionRow]> session-rows: [];
    in property <[StudentRow]> student-rows: [];
    in property <[MaterialRow]> material-rows: [];
    in property <string> selected-session;
    in property <string> selected-student;
    in property <string> selected-asset;

    in-out property <string> scope: "sessions";
    in-out property <string> query;
    in-out property <bool> menu-open: false;

    callback select-session(string, string);
    callback select-student(string);
    callback preview-material(string);
    callback scope-changed(string);
    callback new-session();
    callback open-archive();
    callback open-settings();

    pure function matches(text: string, query: string) -> bool {
        if (query == "") {
            return true;
        }
        return text.to-lowercase().replace-all(query.to-lowercase(), "") != text.to-lowercase();
    }

    public function focus-search-input() {
        search-input.focus-input();
    }

    width: Theme.navigator-width;
    height: 100%;
    background: Theme.sidebar;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.sidebar-line;
    }

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: 62px;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.sidebar-line;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 14px;
                spacing: 4px;

                Text {
                    text: "Sessions";
                    color: Theme.ink;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle { }

                IconButton {
                    icon: @image-url("../assets/icons/plus.svg");
                    label: "New session";
                    enabled: root.archive-path != "";
                    clicked => { root.new-session(); }
                }

                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 5px;
                    background: more-touch.has-hover ? Theme.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Session actions";

                    Text {
                        text: "···";
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: Theme.muted;
                        font-size: 17px;
                        font-weight: 700;
                        accessible-role: none;
                    }

                    more-touch := TouchArea {
                        clicked => { root.menu-open = !root.menu-open; }
                    }
                }
            }
        }

        // Scope tabs
        Rectangle {
            height: 48px;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.sidebar-line;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                TabButton {
                    text: "Sessions";
                    selected: root.scope == "sessions";
                    clicked => { root.scope = "sessions"; root.scope-changed("sessions"); }
                }
                TabButton {
                    text: "Students";
                    selected: root.scope == "students";
                    clicked => { root.scope = "students"; root.scope-changed("students"); }
                }
                TabButton {
                    text: "Materials";
                    selected: root.scope == "materials";
                    clicked => { root.scope = "materials"; root.scope-changed("materials"); }
                }
            }
        }

        // Search
        Rectangle {
            height: 58px;
            visible: root.archive-path != "";

            search-input := LineEdit {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                height: 34px;
                placeholder-text: root.scope == "sessions" ? "Find a session" :
                                  root.scope == "students" ? "Find a student" : "Find material";
                text <=> root.query;
            }
        }

        // List
        ScrollArea {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: max(self.visible-height, nav-list.preferred-height);
            vertical-scrollbar-policy: as-needed;

            nav-list := VerticalLayout {
                width: parent.visible-width;
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 16px;
                spacing: 2px;

                if root.scope == "sessions" : VerticalLayout {
                    spacing: 2px;

                    for row[i] in root.session-rows : Rectangle {
                        visible: root.matches(row.title + " " + row.meta, root.query);
                        height: row.group-start && root.query == "" ? 74px : 54px;
                        border-radius: 5px;
                        background: root.selected-session == row.choice ? Theme.accent-soft :
                                    row-touch.has-hover ? Theme.surface-hover : transparent;

                        if row.group-start && root.query == "" : Text {
                            x: 12px;
                            y: 6px;
                            width: parent.width - 24px;
                            height: 16px;
                            vertical-alignment: center;
                            text: row.group;
                            color: Theme.faint;
                            font-size: 11px;
                            font-weight: 600;
                        }

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            padding-top: (row.group-start && root.query == "") ? 26px : 9px;
                            padding-bottom: 8px;
                            spacing: 2px;

                            Text {
                                text: row.title;
                                color: Theme.ink;
                                font-size: 13.5px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: row.meta;
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        if root.selected-session == row.choice : Rectangle {
                            x: 0px;
                            y: 8px;
                            width: 2px;
                            height: 38px;
                            background: Theme.accent;
                        }

                        if row.state == "recording" : Rectangle {
                            x: parent.width - 20px;
                            y: 22px;
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.recording;
                        }

                        row-touch := TouchArea {
                            clicked => { root.select-session(row.id, row.choice); }
                        }

                        forward-focus: row-focus;
                        accessible-role: button;
                        accessible-label: row.title;

                        row-focus := FocusScope {
                            x: 0;
                            width: 0;
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    root.select-session(row.id, row.choice);
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }

                        if row-focus.has-focus : Rectangle {
                            width: 100%;
                            height: 100%;
                            border-width: 2px;
                            border-color: Theme.focus-ring;
                            border-radius: 5px;
                        }
                    }

                    if root.session-rows.length == 0 : Rectangle {
                        height: empty-session-text.preferred-height + 18px;
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            empty-session-text := Text {
                                text: root.archive-path == "" ?
                                    "Open an existing archive or create a new one to see sessions, students, and materials here." :
                                    root.query == "" ? "No sessions yet. Create a session to start the journal." :
                                                       "No sessions match this search.";
                                color: Theme.muted;
                                font-size: 12px;
                                line-height-factor: 1.35;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.scope == "students" : VerticalLayout {
                    spacing: 2px;

                    for row[i] in root.student-rows : Rectangle {
                        visible: root.matches(row.title + " " + row.meta, root.query);
                        height: 50px;
                        border-radius: 5px;
                        background: root.selected-student == row.choice ? Theme.accent-soft :
                                    student-touch.has-hover ? Theme.surface-hover : transparent;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 2px;
                            Text {
                                text: row.title;
                                color: Theme.ink;
                                font-size: 13.5px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: row.meta;
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        if root.selected-student == row.choice : Rectangle {
                            x: 0px;
                            y: 7px;
                            width: 2px;
                            height: 36px;
                            background: Theme.accent;
                        }

                        student-touch := TouchArea {
                            clicked => { root.select-student(row.choice); }
                        }

                        forward-focus: student-focus;
                        accessible-role: button;
                        accessible-label: row.title;

                        student-focus := FocusScope {
                            x: 0;
                            width: 0;
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    root.select-student(row.choice);
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }

                        if student-focus.has-focus : Rectangle {
                            width: 100%;
                            height: 100%;
                            border-width: 2px;
                            border-color: Theme.focus-ring;
                            border-radius: 5px;
                        }
                    }

                    if root.student-rows.length == 0 : Rectangle {
                        height: empty-student-text.preferred-height + 18px;
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            empty-student-text := Text {
                                text: root.archive-path == "" ? "Open an archive to see its student records." :
                                      root.query == "" ? "No students in this archive yet." :
                                                         "No students match this search.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.scope == "materials" : VerticalLayout {
                    spacing: 2px;

                    for row[i] in root.material-rows : Rectangle {
                        visible: root.matches(row.title + " " + row.meta, root.query);
                        height: 50px;
                        border-radius: 5px;
                        background: root.selected-asset == row.choice ? Theme.accent-soft :
                                    material-touch.has-hover ? Theme.surface-hover : transparent;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 2px;
                            Text {
                                text: row.title;
                                color: Theme.ink;
                                font-size: 13.5px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: row.meta;
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        if root.selected-asset == row.choice : Rectangle {
                            x: 0px;
                            y: 7px;
                            width: 2px;
                            height: 36px;
                            background: Theme.accent;
                        }

                        material-touch := TouchArea {
                            clicked => { root.preview-material(row.choice); }
                        }

                        forward-focus: material-focus;
                        accessible-role: button;
                        accessible-label: row.title;

                        material-focus := FocusScope {
                            x: 0;
                            width: 0;
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    root.preview-material(row.choice);
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }

                        if material-focus.has-focus : Rectangle {
                            width: 100%;
                            height: 100%;
                            border-width: 2px;
                            border-color: Theme.focus-ring;
                            border-radius: 5px;
                        }
                    }

                    if root.material-rows.length == 0 : Rectangle {
                        height: empty-material-text.preferred-height + 18px;
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            empty-material-text := Text {
                                text: root.archive-path == "" ? "Open an archive to see its materials." :
                                      root.selected-session == "" ? "Select a session to see its materials." :
                                      root.query == "" ? "No materials are linked to this session." :
                                                         "No materials match this search.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // Footer
        Rectangle {
            height: 68px;

            Rectangle {
                width: 100%;
                height: 1px;
                background: Theme.sidebar-line;
            }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                spacing: 10px;

                VerticalLayout {
                    spacing: 3px;
                    padding-top: 14px;
                    Text {
                        text: root.archive-path == "" ? "No archive open" : root.archive-name;
                        color: Theme.ink;
                        font-size: 12.5px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3px;
                            background: root.archive-writable ? Theme.success : Theme.warning;
                            visible: root.archive-path != "";
                        }
                        Text {
                            text: root.archive-path == "" ? "Portable .tux workspace" :
                                  root.archive-busy ? "Saving…" :
                                  root.archive-writable ? "All changes saved to this archive" :
                                                          "Read-only archive";
                            color: Theme.muted;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }

                Rectangle { }

                TouchArea {
                    clicked => { root.menu-open = !root.menu-open; }
                }
            }
        }
    }

    // Archive menu
    if root.menu-open : Rectangle {
        x: 12px;
        y: 54px;
        width: 240px;
        height: self.preferred-height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 5px;
        z: 50;

        VerticalLayout {
            padding: 7px;
            spacing: 2px;

            Rectangle {
                height: 32px;
                border-radius: 5px;
                background: open-touch.has-hover ? Theme.surface-hover : transparent;
                Text {
                    x: 9px;
                    width: parent.width - 18px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: "Open or create archive…";
                    color: Theme.ink;
                    font-size: 12.5px;
                }
                open-touch := TouchArea {
                    clicked => { root.menu-open = false; root.open-archive(); }
                }
            }
            Rectangle {
                height: 32px;
                border-radius: 5px;
                background: ops-touch.has-hover ? Theme.surface-hover : transparent;
                Text {
                    x: 9px;
                    width: parent.width - 18px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: "Archive operations…";
                    color: Theme.ink;
                    font-size: 12.5px;
                }
                ops-touch := TouchArea {
                    clicked => { root.menu-open = false; root.open-archive(); }
                }
            }
            Rectangle {
                height: 32px;
                border-radius: 5px;
                background: settings-touch.has-hover ? Theme.surface-hover : transparent;
                Text {
                    x: 9px;
                    width: parent.width - 18px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: "Settings…";
                    color: Theme.ink;
                    font-size: 12.5px;
                }
                settings-touch := TouchArea {
                    clicked => { root.menu-open = false; root.open-settings(); }
                }
            }
        }
    }
}
