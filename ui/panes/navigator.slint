// Left navigator: scopes, filtering, session/student/material lists, archive
// footer. All rows come from the controller; nothing here is sample data.
import { Button, IconButton, LineEdit, ScrollArea, TabButton, Theme } from "../theme.slint";
import { ListView } from "std-widgets.slint";
import { MaterialRow, SessionRow, StudentRow } from "../models.slint";

export component Navigator inherits Rectangle {
    in property <string> archive-path;
    in property <string> archive-name;
    in property <string> archive-status;
    in property <bool> archive-busy: false;
    in property <bool> archive-writable: true;
    in property <bool> compact: false;
    in property <[SessionRow]> session-rows: [];
    in property <[StudentRow]> student-rows: [];
    in property <[MaterialRow]> material-rows: [];
    in property <[string]> journal-options: [];
    in property <[string]> guide-options: [];
    in property <string> selected-session;
    in property <string> selected-student;
    in property <string> selected-asset;
    in property <string> selected-journal-entry;
    in property <string> selected-guide;

    in-out property <string> scope: "sessions";
    in-out property <string> query;
    in-out property <bool> menu-open: false;

    callback select-session(string, string);
    callback select-student(string);
    callback preview-material(string);
    callback select-journal-entry(string);
    callback select-guide(string);
    callback scope-changed(string);
    callback new-session();
    callback open-archive();
    callback open-settings();

    pure function matches(text: string, query: string) -> bool {
        if (query == "") {
            return true;
        }
        return text.to-lowercase().replace-all(query.to-lowercase(), "") != text.to-lowercase();
    }

    public function focus-search-input() {
        search-input.focus-input();
    }

    width: root.compact ? 208px : Theme.navigator-width;
    height: 100%;
    background: Theme.sidebar;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.sidebar-line;
    }

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: 62px;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.sidebar-line;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 14px;
                spacing: 8px;

                Image {
                    source: @image-url("../assets/logo.svg");
                    width: 24px;
                    height: 24px;
                    image-fit: contain;
                    accessible-role: image;
                    accessible-label: "Tutorux";
                }

                Text {
                    text: root.scope == "journal" ? "Journal" :
                          root.scope == "students" ? "Students" :
                          root.scope == "materials" ? "Materials" :
                          root.scope == "guides" ? "Guides" :
                          root.scope == "trash" ? "Trash" :
                          root.scope == "settings" ? "Settings" : "Sessions";
                    // Use actual sidebar width so the label cannot flash or clip
                    // while the window breakpoint updates on the event loop.
                    visible: root.width >= 240px;
                    color: Theme.ink;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle { }

                IconButton {
                    icon: @image-url("../assets/icons/plus.svg");
                    label: root.scope == "journal" ? "New entry" :
                           root.scope == "students" ? "New student" : "New session";
                    visible: root.scope == "sessions" || root.scope == "students" ||
                             root.scope == "journal";
                    enabled: root.archive-path != "";
                    clicked => { root.new-session(); }
                }

                Button {
                    width: 34px;
                    button-min-width: 34px;
                    button-min-height: 34px;
                    horizontal-padding: 0px;
                    variant: "ghost";
                    text: "···";
                    accessible-label: "Workspace menu";
                    clicked => { root.menu-open = !root.menu-open; }
                }
            }
        }

        // Primary and recovery areas remain reachable at the compact width.
        Rectangle {
            height: 92px;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.sidebar-line;
            }

            VerticalLayout {
                width: 100%;
                height: 100%;
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 2px;

                HorizontalLayout {
                    spacing: 2px;
                    TabButton {
                        text: "Journal";
                        font-size: root.compact ? 11px : 12px;
                        min-width: 0px;
                        height: 26px;
                        horizontal-stretch: 1;
                        selected: root.scope == "journal";
                        clicked => { root.scope = "journal"; root.scope-changed("journal"); }
                    }
                    TabButton {
                        text: "Sessions";
                        font-size: root.compact ? 11px : 12px;
                        min-width: 0px;
                        height: 26px;
                        horizontal-stretch: 1;
                        selected: root.scope == "sessions";
                        clicked => { root.scope = "sessions"; root.scope-changed("sessions"); }
                    }
                    TabButton {
                        text: "Students";
                        font-size: root.compact ? 11px : 12px;
                        min-width: 0px;
                        height: 26px;
                        horizontal-stretch: 1;
                        selected: root.scope == "students";
                        clicked => { root.scope = "students"; root.scope-changed("students"); }
                    }
                }
                HorizontalLayout {
                    spacing: 2px;
                    TabButton {
                        text: "Materials";
                        font-size: root.compact ? 11px : 12px;
                        min-width: 0px;
                        height: 26px;
                        horizontal-stretch: 1;
                        selected: root.scope == "materials";
                        clicked => { root.scope = "materials"; root.scope-changed("materials"); }
                    }
                    TabButton {
                        text: "Guides";
                        font-size: root.compact ? 11px : 12px;
                        min-width: 0px;
                        height: 26px;
                        horizontal-stretch: 1;
                        selected: root.scope == "guides";
                        clicked => { root.scope = "guides"; root.scope-changed("guides"); }
                    }
                    TabButton {
                        text: "Settings";
                        font-size: root.compact ? 11px : 12px;
                        min-width: 0px;
                        height: 26px;
                        horizontal-stretch: 1;
                        selected: root.scope == "settings";
                        clicked => { root.scope = "settings"; root.scope-changed("settings"); }
                    }
                }
                HorizontalLayout {
                    spacing: 2px;
                    TabButton {
                        text: "Trash";
                        font-size: root.compact ? 11px : 12px;
                        min-width: 0px;
                        height: 26px;
                        horizontal-stretch: 1;
                        selected: root.scope == "trash";
                        clicked => { root.scope = "trash"; root.scope-changed("trash"); }
                    }
                    Rectangle { horizontal-stretch: 2; }
                }
            }
        }

        // Search
        Rectangle {
            height: root.scope == "settings" || root.scope == "trash" ? 0px : 58px;
            visible: root.archive-path != "" && root.scope != "settings" && root.scope != "trash";

            search-input := LineEdit {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                height: 34px;
                placeholder-text: root.scope == "sessions" ? "Find a session" :
                                  root.scope == "students" ? "Find a student" :
                                  root.scope == "materials" ? "Find material" :
                                  root.scope == "journal" ? "Find an entry" :
                                  root.scope == "guides" ? "Find a guide" : "Search";
                visible: root.scope != "settings" && root.scope != "trash";
                text <=> root.query;
            }
        }

        // Long lists are virtualized: only visible rows are instantiated.
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            if root.scope == "sessions" : ListView {
                width: 100%;
                height: 100%;

                for row in root.session-rows : Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: !root.matches(row.title + " " + row.meta, root.query) ? 0px :
                            (row.group-start && root.query == "" ? 74px : 54px);
                    border-radius: 5px;
                    background: root.selected-session == row.choice ? Theme.accent-soft :
                                row-touch.has-hover ? Theme.surface-hover : transparent;

                    if row.group-start && root.query == "" : Text {
                        x: 12px;
                        y: 6px;
                        width: parent.width - 24px;
                        height: 16px;
                        vertical-alignment: center;
                        text: row.group;
                        color: Theme.faint;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: (row.group-start && root.query == "") ? 26px : 9px;
                        padding-bottom: 8px;
                        spacing: 2px;

                        Text {
                            text: row.title;
                            color: Theme.ink;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: row.meta;
                            color: Theme.muted;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }

                    if root.selected-session == row.choice : Rectangle {
                        x: 0px;
                        y: (row.group-start && root.query == "") ? 28px : 8px;
                        width: 2px;
                        height: 38px;
                        background: Theme.accent;
                    }

                    if row.state == "recording" : Rectangle {
                        x: parent.width - 20px;
                        y: (row.group-start && root.query == "") ? 42px : 22px;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.recording;
                    }

                    row-touch := TouchArea {
                        clicked => { root.select-session(row.id, row.choice); }
                    }

                    forward-focus: row-focus;
                    accessible-role: button;
                    accessible-label: row.title;

                    row-focus := FocusScope {
                        x: 0;
                        width: 0;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                root.select-session(row.id, row.choice);
                                accept
                            } else {
                                reject
                            }
                        }
                    }

                    if row-focus.has-focus : Rectangle {
                        width: 100%;
                        height: 100%;
                        border-width: 2px;
                        border-color: Theme.focus-ring;
                        border-radius: 5px;
                    }
                }
            }

            if root.scope == "students" : ListView {
                width: 100%;
                height: 100%;

                for row in root.student-rows : Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: !root.matches(row.title + " " + row.meta, root.query) ? 0px : 50px;
                    border-radius: 5px;
                    background: root.selected-student == row.choice ? Theme.accent-soft :
                                student-touch.has-hover ? Theme.surface-hover : transparent;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        spacing: 2px;
                        Text {
                            text: row.title;
                            color: Theme.ink;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: row.meta;
                            color: Theme.muted;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }

                    if root.selected-student == row.choice : Rectangle {
                        x: 0px;
                        y: 7px;
                        width: 2px;
                        height: 36px;
                        background: Theme.accent;
                    }

                    student-touch := TouchArea {
                        clicked => { root.select-student(row.choice); }
                    }

                    forward-focus: student-focus;
                    accessible-role: button;
                    accessible-label: row.title;

                    student-focus := FocusScope {
                        x: 0;
                        width: 0;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                root.select-student(row.choice);
                                accept
                            } else {
                                reject
                            }
                        }
                    }

                    if student-focus.has-focus : Rectangle {
                        width: 100%;
                        height: 100%;
                        border-width: 2px;
                        border-color: Theme.focus-ring;
                        border-radius: 5px;
                    }
                }
            }

            if root.scope == "materials" : ListView {
                width: 100%;
                height: 100%;

                for row in root.material-rows : Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: !root.matches(row.title + " " + row.meta, root.query) ? 0px : 50px;
                    border-radius: 5px;
                    background: root.selected-asset == row.choice ? Theme.accent-soft :
                                material-touch.has-hover ? Theme.surface-hover : transparent;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        spacing: 2px;
                        Text {
                            text: row.title;
                            color: Theme.ink;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: row.meta;
                            color: Theme.muted;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }

                    if root.selected-asset == row.choice : Rectangle {
                        x: 0px;
                        y: 7px;
                        width: 2px;
                        height: 36px;
                        background: Theme.accent;
                    }

                    material-touch := TouchArea {
                        clicked => { root.preview-material(row.choice); }
                    }

                    forward-focus: material-focus;
                    accessible-role: button;
                    accessible-label: row.title;

                    material-focus := FocusScope {
                        x: 0;
                        width: 0;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                root.preview-material(row.choice);
                                accept
                            } else {
                                reject
                            }
                        }
                    }

                    if material-focus.has-focus : Rectangle {
                        width: 100%;
                        height: 100%;
                        border-width: 2px;
                        border-color: Theme.focus-ring;
                        border-radius: 5px;
                    }
                }
            }

            if root.scope == "journal" : ListView {
                width: 100%;
                height: 100%;

                for entry in root.journal-options : Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: !root.matches(entry, root.query) ? 0px : 50px;
                    border-radius: 5px;
                    background: root.selected-journal-entry == entry ? Theme.accent-soft :
                                journal-touch.has-hover ? Theme.surface-hover : transparent;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        Text {
                            text: entry;
                            color: Theme.ink;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }

                    if root.selected-journal-entry == entry : Rectangle {
                        x: 0px;
                        y: 7px;
                        width: 2px;
                        height: 36px;
                        background: Theme.accent;
                    }

                    journal-touch := TouchArea {
                        clicked => { root.select-journal-entry(entry); }
                    }

                    forward-focus: journal-focus;
                    accessible-role: button;
                    accessible-label: entry;

                    journal-focus := FocusScope {
                        x: 0;
                        width: 0;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                root.select-journal-entry(entry);
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                }
            }

            if root.scope == "guides" : ListView {
                width: 100%;
                height: 100%;

                for guide in root.guide-options : Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: !root.matches(guide, root.query) ? 0px : 50px;
                    border-radius: 5px;
                    background: root.selected-guide == guide ? Theme.accent-soft :
                                guide-touch.has-hover ? Theme.surface-hover : transparent;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        Text {
                            text: guide;
                            color: Theme.ink;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }

                    if root.selected-guide == guide : Rectangle {
                        x: 0px;
                        y: 7px;
                        width: 2px;
                        height: 36px;
                        background: Theme.accent;
                    }

                    guide-touch := TouchArea {
                        clicked => { root.select-guide(guide); }
                    }

                    forward-focus: guide-focus;
                    accessible-role: button;
                    accessible-label: guide;

                    guide-focus := FocusScope {
                        x: 0;
                        width: 0;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                root.select-guide(guide);
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                }
            }

            if root.scope == "journal" && root.journal-options.length == 0 : Rectangle {
                x: 0;
                y: 0;
                height: empty-journal-text.preferred-height + 18px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 8px;
                    empty-journal-text := Text {
                        text: root.archive-path == "" ? "Open an archive to see journal entries." :
                              root.query == "" ? "No journal entries yet." :
                                                 "No entries match this search.";
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            if root.scope == "guides" && root.guide-options.length == 0 : Rectangle {
                x: 0;
                y: 0;
                height: empty-guide-text.preferred-height + 18px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 8px;
                    empty-guide-text := Text {
                        text: root.archive-path == "" ? "Open an archive to see study guides." :
                              root.query == "" ? "No study guides yet." :
                                                 "No guides match this search.";
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            if root.scope == "sessions" && root.session-rows.length == 0 : Rectangle {
                x: 0;
                y: 0;
                height: empty-session-text.preferred-height + 18px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 8px;
                    empty-session-text := Text {
                        text: root.archive-path == "" ?
                            "Open an existing archive or create a new one to see sessions, students, and materials here." :
                            root.query == "" ? "No sessions yet. Create a session to start the journal." :
                                               "No sessions match this search.";
                        color: Theme.muted;
                        font-size: 12px;
                        line-height-factor: 1.35;
                        wrap: word-wrap;
                    }
                }
            }

            if root.scope == "students" && root.student-rows.length == 0 : Rectangle {
                x: 0;
                y: 0;
                height: empty-student-text.preferred-height + 18px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 8px;
                    empty-student-text := Text {
                        text: root.archive-path == "" ? "Open an archive to see its student records." :
                              root.query == "" ? "No students in this archive yet." :
                                                 "No students match this search.";
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            if root.scope == "materials" && root.material-rows.length == 0 : Rectangle {
                x: 0;
                y: 0;
                height: empty-material-text.preferred-height + 18px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 8px;
                    empty-material-text := Text {
                        text: root.archive-path == "" ? "Open an archive to see its materials." :
                              root.selected-session == "" ? "Select a session to see its materials." :
                              root.query == "" ? "No materials are linked to this session." :
                                                 "No materials match this search.";
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
        // Footer
        Rectangle {
            height: 68px;

            Rectangle {
                width: 100%;
                height: 1px;
                background: Theme.sidebar-line;
            }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                spacing: 10px;

                VerticalLayout {
                    spacing: 3px;
                    padding-top: 14px;
                    Text {
                        text: root.archive-path == "" ? "No archive open" : root.archive-name;
                        color: Theme.ink;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3px;
                            background: root.archive-writable ? Theme.success : Theme.warning;
                            visible: root.archive-path != "";
                        }
                        Text {
                            text: root.archive-path == "" ? "Portable .tux workspace" :
                                  root.archive-busy ? "Saving…" :
                                  root.archive-writable ? "All changes saved to this archive" :
                                                          "Read-only archive";
                            color: Theme.muted;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                }

                Rectangle { }

                TouchArea {
                    clicked => { root.menu-open = !root.menu-open; }
                }
            }
        }
    }

    // Archive menu
    if root.menu-open : Rectangle {
        x: 12px;
        y: 54px;
        width: 240px;
        height: self.preferred-height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 5px;
        z: 50;

        VerticalLayout {
            padding: 7px;
            spacing: 2px;

            Button {
                width: 100%;
                fill: true;
                button-min-height: 32px;
                horizontal-padding: 9px;
                label-left-aligned: true;
                variant: "ghost";
                text: "Open or create archive…";
                clicked => { root.menu-open = false; root.open-archive(); }
            }
            Button {
                width: 100%;
                fill: true;
                button-min-height: 32px;
                horizontal-padding: 9px;
                label-left-aligned: true;
                variant: "ghost";
                text: "Archive operations…";
                clicked => { root.menu-open = false; root.open-archive(); }
            }
            Button {
                width: 100%;
                fill: true;
                button-min-height: 32px;
                horizontal-padding: 9px;
                label-left-aligned: true;
                variant: "ghost";
                text: "Settings…";
                clicked => { root.menu-open = false; root.open-settings(); }
            }
        }
    }
}
