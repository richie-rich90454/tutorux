import { Button, ComboBox, LineEdit, TextArea, Theme } from "../theme.slint";
import { ActionWrap, Field, FormWrap } from "../components/page-parts.slint";
import { PanelShell } from "../overlays/panel-shell.slint";

export component GuideTemplateManager inherits Rectangle {
    in property <[string]> options: [];
    in property <string> output;
    in property <bool> writable: true;
    in-out property <string> selected-template;
    in-out property <string> name;
    in-out property <string> subject;
    in-out property <string> description;
    in-out property <string> sections;
    in-out property <string> body;
    in-out property <string> path;
    in-out property <bool> delete-armed: false;

    callback close();
    callback action(string);
    callback browse();

    width: 100%;
    height: 100%;
    background: transparent;

    PanelShell {
        available-width: root.width;
        available-height: root.height;
        heading: "Guide templates";
        detail: "Reusable lesson structure saved in this archive";
        close => { root.close(); }

        VerticalLayout {
            spacing: 12px;

            Text {
                text: root.output;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }

            FormWrap {
                Field {
                    label: "Saved template";
                    ComboBox {
                        model: root.options;
                        current-value <=> root.selected-template;
                        selected(value) => { root.action("show"); }
                    }
                }
                Field { label: "Name"; LineEdit { text <=> root.name; enabled: root.writable; } }
                Field { label: "Subject"; LineEdit { text <=> root.subject; enabled: root.writable; } }
                Field { label: "Description"; TextArea { height: 76px; text <=> root.description; enabled: root.writable; } }
                Field { label: "Sections (one heading per line)"; TextArea { height: 108px; text <=> root.sections; enabled: root.writable; } }
                Field { label: "Template body"; TextArea { height: 220px; text <=> root.body; enabled: root.writable; } }
            }

            ActionWrap {
                Button { text: "Refresh list"; clicked => { root.action("list"); } }
                Button {
                    text: "Load selected";
                    enabled: root.selected-template != "";
                    clicked => { root.action("show"); }
                }
                Button {
                    text: "Save as new template";
                    variant: "primary";
                    enabled: root.writable && root.name != "";
                    clicked => { root.action("create"); }
                }
                Button {
                    text: "Save changes";
                    enabled: root.writable && root.selected-template != "";
                    clicked => { root.action("update"); }
                }
                Button {
                    text: "Duplicate";
                    enabled: root.writable && root.selected-template != "";
                    clicked => { root.action("duplicate"); }
                }
                Button {
                    text: root.delete-armed ? "Confirm move to Trash" : "Move to Trash";
                    variant: "danger";
                    enabled: root.writable && root.selected-template != "";
                    clicked => {
                        if root.delete-armed {
                            root.delete-armed = false;
                            root.action("delete");
                        } else {
                            root.delete-armed = true;
                        }
                    }
                }
                if root.delete-armed : Button {
                    text: "Cancel";
                    clicked => { root.delete-armed = false; }
                }
            }

            Rectangle { height: 1px; background: Theme.line; }

            FormWrap {
                Field {
                    label: "Import or export template JSON";
                    LineEdit { placeholder-text: "Template file path"; text <=> root.path; }
                }
            }
            ActionWrap {
                Button { text: "Browse…"; clicked => { root.browse(); } }
                Button { text: "Import"; enabled: root.writable && root.path != ""; clicked => { root.action("import"); } }
                Button { text: "Export selected"; enabled: root.selected-template != "" && root.path != ""; clicked => { root.action("export"); } }
            }
        }
    }
}
