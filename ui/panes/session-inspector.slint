import { Button, ComboBox, LineEdit, ScrollArea, Theme } from "../theme.slint";
import { MarkerRow } from "../models.slint";

export component SessionInspector inherits Rectangle {
    in property <string> student;
    in property <string> subject;
    in property <string> started;
    in property <string> microphone;
    in property <string> source;
    in property <string> student-choice;
    in property <bool> writable: true;
    in-out property <string> details-save-state: "idle";
    in property <string> elapsed-label;
    in property <[string]> student-options: [];
    in property <[MarkerRow]> markers: [];
    in-out property <string> selected-marker;
    in-out property <string> marker-time;
    in-out property <string> marker-note;
    in-out property <string> marker-kind: "Concept";

    callback update-details(string, string);
    callback open-recording();
    callback play-marker(int);
    callback mark(string);
    callback edit-marker(string, string, string);
    callback remove-marker(string);

    pure function marker-type() -> string {
        if root.marker-kind == "Mistake" { return "student-mistake"; }
        if root.marker-kind == "Correction" { return "tutor-correction"; }
        if root.marker-kind == "Instruction" { return "explicit-instruction"; }
        if root.marker-kind == "Example" { return "worked-example"; }
        if root.marker-kind == "Follow-up" { return "follow-up-priority"; }
        if root.marker-kind == "Note" { return "general-note"; }
        return "important-concept";
    }

    width: Theme.inspector-width;
    height: 100%;
    min-height: 0px;
    horizontal-stretch: 0;
    vertical-stretch: 1;
    clip: true;
    background: Theme.surface;

    property <bool> editing: false;
    property <string> draft-student;
    property <string> draft-subject;

    changed details-save-state => {
        if (root.details-save-state == "saved") {
            root.editing = false;
        }
    }

    Rectangle {
        width: 1px;
        height: 100%;
        background: Theme.line;
    }

    ScrollArea {
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        vertical-scrollbar-policy: as-needed;

        body := VerticalLayout {
            width: parent.visible-width;
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 20px;
            padding-bottom: 20px;
            spacing: 0px;
            alignment: start;

            VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    Text {
                        text: "Session details";
                        color: Theme.ink;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        accessible-label: "Session inspector heading";
                    }
                    Button {
                        text: root.editing ? "Cancel" : "Edit";
                        variant: "ghost";
                        enabled: (root.editing || root.writable) &&
                            root.details-save-state != "saving";
                        accessible-label: root.editing ? "Cancel session edit" : "Edit session details";
                        clicked => {
                            if root.editing {
                                root.editing = false;
                                root.details-save-state = "idle";
                            } else {
                                root.draft-student = root.student-choice;
                                root.draft-subject = root.subject;
                                root.details-save-state = "idle";
                                root.editing = true;
                            }
                        }
                    }
                }
                Button {
                    text: "Manage recordings";
                    variant: "ghost";
                    fill: true;
                    accessible-label: "Manage session recordings";
                    clicked => { root.open-recording(); }
                }
            }

            Rectangle { height: 12px; }

            if !root.editing : VerticalLayout {
                spacing: 10px;
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Student"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                    Text {
                        width: 100%;
                        text: root.student == "" ? "Not assigned" : root.student;
                        color: Theme.ink;
                        font-size: 14px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Subject"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                    Text {
                        width: 100%;
                        text: root.subject == "" ? "Not recorded" : root.subject;
                        color: Theme.ink;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Started"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                    Text {
                        width: 100%;
                        text: root.started == "" ? "Not started" : root.started;
                        color: Theme.ink;
                        font-size: 14px;
                        overflow: elide;
                    }
                }
            }

            if root.editing : VerticalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Student"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                    ComboBox {
                        enabled: root.writable;
                        model: root.student-options;
                        current-value <=> root.draft-student;
                        accessible-label: "Session student";
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Subject"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                    LineEdit {
                        text <=> root.draft-subject;
                        enabled: root.writable;
                        accessible-label: "Session subject";
                    }
                }
                Button {
                    text: root.details-save-state == "saving" ? "Saving…" :
                          root.details-save-state == "failed" ? "Retry save" : "Save details";
                    variant: "primary";
                    fill: true;
                    enabled: root.writable && root.details-save-state != "saving";
                    accessible-label: "Save session details";
                    clicked => {
                        root.update-details(root.draft-student, root.draft-subject);
                    }
                }
                if root.details-save-state == "failed" : Text {
                    width: 100%;
                    text: "The save failed. Your edits are still here; retry or cancel.";
                    color: Theme.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Button {
                    text: "Unassign student";
                    variant: "ghost";
                    fill: true;
                    clicked => { root.draft-student = "Anonymous session"; }
                }
            }

            Rectangle { height: 10px; }
            Rectangle { height: 1px; background: Theme.line; }
            Rectangle { height: 10px; }

            Text { text: "Audio capture"; color: Theme.ink; font-size: 12px; font-weight: 700; }
            Rectangle { height: 10px; }

            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    Text { text: "Microphone"; color: Theme.muted; font-size: 12px; }
                    Text {
                        text: root.microphone == "" ? "Default input" : root.microphone;
                        color: Theme.ink;
                        font-size: 12px;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    Text { text: "System audio"; color: Theme.muted; font-size: 12px; }
                    Text {
                        text: root.source == "system-audio" || root.source == "both" ? "On" : "Off";
                        color: Theme.ink;
                        font-size: 12px;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                    }
                }
            }

            Rectangle { height: 10px; }
            Rectangle { height: 1px; background: Theme.line; }
            Rectangle { height: 10px; }

            Text { text: "Add marker"; color: Theme.ink; font-size: 12px; font-weight: 700; }
            Rectangle { height: 6px; }

            VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        placeholder-text: "00:00:00";
                        text <=> root.marker-time;
                    enabled: root.writable;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        accessible-label: "Session marker time";
                    }
                    Button {
                        text: "Now";
                        variant: "ghost";
                        clicked => { root.marker-time = root.elapsed-label; }
                        accessible-label: "Use current recording time";
                    }
                }
                LineEdit {
                    placeholder-text: "Optional marker note";
                    text <=> root.marker-note;
                    enabled: root.writable;
                    accessible-label: "Session marker note";
                }
                ComboBox {
                    model: ["Concept", "Mistake", "Correction", "Instruction",
                            "Example", "Follow-up", "Note"];
                    enabled: root.writable;
                    current-value <=> root.marker-kind;
                    accessible-label: "Session marker type";
                }
                Button {
                    text: "Add marker";
                    variant: "primary";
                    fill: true;
                    enabled: root.writable;
                    clicked => { root.mark(root.marker-type()); }
                    accessible-label: "Add session marker";
                }
            }

            Rectangle { height: 16px; }
            Text { text: "Markers"; color: Theme.ink; font-size: 12px; font-weight: 700; }
            Rectangle { height: 10px; }

            if root.markers.length == 0 : Text {
                text: "No markers yet.";
                color: Theme.faint;
                font-size: 12px;
            }

            for marker[i] in root.markers : Rectangle {
                height: 38px;
                width: 100%;
                Button {
                    width: 100%;
                    fill: true;
                    button-min-width: 0px;
                    button-min-height: 38px;
                    horizontal-padding: 9px;
                    label-left-aligned: true;
                    variant: "ghost";
                    text: marker.time + " · " + marker.label;
                    accessible-label: "Play marker at " + marker.time +
                        (marker.label == "" ? "" : ": " + marker.label);
                    border-radius: 4px;
                    background: root.selected-marker == marker.id ? Theme.surface-hover : transparent;
                    clicked => {
                        root.selected-marker = marker.id;
                        root.marker-time = marker.time;
                        root.marker-note = marker.label;
                        root.play-marker(marker.start-seconds);
                    }
                }
            }

            if root.markers.length > 0 : HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Save marker";
                    enabled: root.writable && root.selected-marker != "";
                    clicked => {
                        root.edit-marker(root.selected-marker, root.marker-time, root.marker-note);
                    }
                }
                Button {
                    text: "Remove";
                    variant: "danger";
                    enabled: root.writable && root.selected-marker != "";
                    clicked => {
                        root.remove-marker(root.selected-marker);
                        root.selected-marker = "";
                    }
                }
            }
        }
    }
}
