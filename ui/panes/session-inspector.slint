// Session inspector: factual details, audio source state, and real markers.
import { Button, ComboBox, LineEdit, ScrollArea, Theme } from "../theme.slint";
import { MarkerRow } from "../models.slint";

export component SessionInspector inherits Rectangle {
    in property <string> student;
    in property <string> subject;
    in property <string> started;
    in property <string> microphone;
    in property <string> source;
    in property <string> student-choice;
    in property <[string]> student-options: [];
    in property <[MarkerRow]> markers: [];

    callback update-details(string, string);
    callback open-recording();
    callback play-marker(int);

    width: Theme.inspector-width;
    height: 100%;
    background: Theme.surface;

    property <bool> editing: false;
    property <string> draft-student;
    property <string> draft-subject;

    Rectangle {
        width: 1px;
        height: 100%;
        background: Theme.line;
    }

    ScrollArea {
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        vertical-scrollbar-policy: as-needed;

        body := VerticalLayout {
            width: parent.visible-width;
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 26px;
            padding-bottom: 32px;
            spacing: 0px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Session details";
                    color: Theme.ink;
                    font-size: 12.5px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { }
                Button {
                    text: root.editing ? "Cancel" : "Edit";
                    variant: "ghost";
                    clicked => {
                        if root.editing {
                            root.editing = false;
                        } else {
                            root.draft-student = root.student-choice;
                            root.draft-subject = root.subject;
                            root.editing = true;
                        }
                    }
                }
            }

            Rectangle { height: 16px; }

            if !root.editing : VerticalLayout {
                spacing: 14px;
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Student"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    Text { text: root.student == "" ? "Not assigned" : root.student; color: Theme.ink; font-size: 13px; }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Subject"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    Text { text: root.subject == "" ? "Not recorded" : root.subject; color: Theme.ink; font-size: 13px; wrap: word-wrap; }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Started"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    Text { text: root.started == "" ? "Not started" : root.started; color: Theme.ink; font-size: 13px; }
                }
            }

            if root.editing : VerticalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Student"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    ComboBox {
                        model: root.student-options;
                        current-value <=> root.draft-student;
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Subject"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    LineEdit { text <=> root.draft-subject; }
                }
                Button {
                    text: "Save details";
                    variant: "primary";
                    clicked => {
                        root.update-details(root.draft-student, root.draft-subject);
                        root.editing = false;
                    }
                }
            }

            Rectangle { height: 20px; }
            Rectangle { height: 1px; background: Theme.line; }
            Rectangle { height: 20px; }

            Text { text: "Audio capture"; color: Theme.ink; font-size: 12.5px; font-weight: 700; }
            Rectangle { height: 12px; }

            VerticalLayout {
                spacing: 9px;
                HorizontalLayout {
                    Text { text: "Microphone"; color: Theme.muted; font-size: 12px; }
                    Rectangle { }
                    Text {
                        text: root.microphone == "" ? "Default input" : root.microphone;
                        color: Theme.ink;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    Text { text: "System audio"; color: Theme.muted; font-size: 12px; }
                    Rectangle { }
                    Text {
                        text: root.source == "system-audio" || root.source == "both" ? "On" : "Off";
                        color: Theme.ink;
                        font-size: 12px;
                    }
                }
                Button {
                    text: "Configure audio →";
                    variant: "ghost";
                    clicked => { root.open-recording(); }
                }
            }

            Rectangle { height: 20px; }
            Rectangle { height: 1px; background: Theme.line; }
            Rectangle { height: 20px; }

            Text { text: "Markers"; color: Theme.ink; font-size: 12.5px; font-weight: 700; }
            Rectangle { height: 10px; }

            if root.markers.length == 0 : Text {
                text: "No markers yet.";
                color: Theme.faint;
                font-size: 11.5px;
            }

            for marker[i] in root.markers : HorizontalLayout {
                height: 30px;
                spacing: 10px;
                marker-touch := TouchArea {
                    clicked => { root.play-marker(marker.start-seconds); }
                }
                Text {
                    text: marker.time;
                    color: Theme.accent;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }
                Text {
                    text: marker.label;
                    color: Theme.body;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
