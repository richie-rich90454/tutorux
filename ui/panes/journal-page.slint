import { Button, CheckBox, ComboBox, LineEdit, ScrollArea, ScrollText, TextArea, Theme } from "../theme.slint";
import { ActionWrap, Card, Field, FormWrap } from "../components/page-parts.slint";

export component JournalPage inherits Rectangle {
    in property <bool> writable: true;
    in-out property <string> query;
    in-out property <string> sort: "Newest first";
    in-out property <[string]> collection-options;
    in-out property <string> collection-filter: "All collections";
    in-out property <[string]> tag-options;
    in-out property <string> tag-filter: "All tags";
    in-out property <string> date-from;
    in-out property <string> date-to;
    in-out property <string> session-filter: "all";
    in-out property <string> list-output;
    in-out property <[string]> entry-options;
    in-out property <string> selected-entry;

    in-out property <bool> advanced-open;
    in-out property <bool> entry-create-open;
    in-out property <string> entry-title;
    in-out property <string> entry-date;
    in-out property <string> entry-collection: "All collections";
    in-out property <string> entry-tag: "All tags";
    in-out property <bool> entry-delete-confirmed;
    in-out property <string> entry-id;

    in-out property <string> timeline-output;
    in-out property <[string]> session-options;
    in-out property <string> selected-session;
    in-out property <string> timeline-date;
    in-out property <bool> session-expanded;
    in-out property <string> session-detail-output;
    in-out property <[string]> session-student-options;
    in-out property <string> session-student: "Anonymous session";
    in-out property <string> session-new-student-name;
    in-out property <string> session-new-student-grade;
    in-out property <string> session-language: "auto";
    in-out property <string> session-recording-source: "microphone";
    in-out property <[string]> guide-template-options;
    in-out property <string> session-template: "Use recommended template";
    in-out property <string> guide-output;
    in-out property <string> session-title;
    in-out property <string> session-subject;
    in-out property <string> session-objectives;
    in-out property <string> session-type: "notes-only";
    in-out property <string> session-id;
    in-out property <bool> session-delete-confirmed;
    in-out property <bool> session-delete-scope-reviewed;
    in-out property <string> session-delete-preview-id;
    in-out property <string> session-delete-scope-token;
    in-out property <string> session-delete-scope-output;

    in-out property <string> document-id;
    in property <string> document-removed-block-id;
    in-out property <string> document-text;
    in-out property <[string]> note-block-options;
    in-out property <string> selected-note-block;
    in-out property <string> document-block-text;
    in-out property <string> document-block-kind: "Paragraph";
    in-out property <int> document-block-anchor-offset: 0;
    in-out property <int> document-block-focus-offset: 0;
    in-out property <int> document-block-index: -1;
    in-out property <int> document-block-count: 0;
    in-out property <string> document-new-block-text;
    in-out property <bool> document-show-preview;

    in-out property <string> item-name;
    in-out property <string> item-id;
    in-out property <string> item-collection: "All collections";
    in-out property <string> item-tag: "All tags";
    in-out property <bool> item-delete-confirmed;
    in-out property <string> item-description;
    in-out property <string> item-color;

    callback action(string, string, string, string, string, string, string);
    callback create-session(string, string, string, string, string, string, string, string, string, string, string);
    callback open-session(string);
    callback review-transcript(string);
    callback search();
    callback open-guides();
    callback open-recording-controls(string);

    property <bool> inline-format-enabled:
        root.document-block-count > 0 && root.document-block-kind != "Code";

    pure function selected-session-id() -> string {
        return root.session-id == "" ? root.selected-session : root.session-id;
    }

    pure function collection-choice() -> string {
        return root.item-collection != "All collections" ? root.item-collection : root.item-id;
    }

    pure function tag-choice() -> string {
        return root.item-tag != "All tags" ? root.item-tag : root.item-id;
    }

    background: Theme.surface;

    ScrollArea {
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        vertical-scrollbar-policy: as-needed;

        body := VerticalLayout {
            width: parent.visible-width;
            padding: 24px;
            spacing: 16px;
            alignment: start;

            FlexboxLayout {
                flex-wrap: wrap;
                alignment: space-between;
                cross-axis-alignment: center;
                spacing: 12px;

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "JOURNAL";
                        color: Theme.ink;
                        font-size: 12px;
                        font-weight: 700;
                        letter-spacing: 1.2px;
                    }
                    Text {
                        text: "Teaching journal";
                        color: Theme.ink;
                        font-size: 28px;
                        font-weight: 700;
                    }
                }

                ActionWrap {
                    CheckBox {
                        text: "Advanced IDs";
                        checked <=> root.advanced-open;
                    }
                    Button {
                        text: "+ New entry";
                        variant: "primary";
                        clicked => {
                            root.entry-title = "";
                            root.entry-date = "";
                            root.entry-collection = "All collections";
                            root.entry-tag = "All tags";
                            root.entry-create-open = true;
                        }
                    }
                }
            }

            Text {
                text: "Keep observations and progress across lessons here. A session represents one lesson and owns its notes, audio, and follow-up.";
                color: Theme.muted;
                font-size: 13px;
                line-height-factor: 1.4;
                wrap: word-wrap;
            }

            if root.entry-create-open : Card {
                heading: "New journal entry";

                FormWrap {
                    Field {
                        label: "Title";
                        LineEdit {
                            placeholder-text: "Entry title";
                            text <=> root.entry-title;
                            accessible-label: "New journal entry title";
                        }
                    }
                    Field {
                        label: "Date";
                        LineEdit {
                            placeholder-text: "YYYY-MM-DD";
                            text <=> root.entry-date;
                            accessible-label: "New journal entry date";
                        }
                    }
                }
                ActionWrap {
                    Button {
                        text: "Create entry";
                        variant: "primary";
                        enabled: root.entry-title != "";
                        clicked => {
                            root.action("entry-create", root.entry-title, root.entry-date,
                                        root.entry-collection, root.entry-tag, "", "");
                        }
                    }
                    Button {
                        text: "Cancel";
                        clicked => { root.entry-create-open = false; }
                    }
                }
            }

            find-card := Card {
                heading: "Find an entry";

                Field {
                    label: "Search";
                    max-width: 100000px;
                    LineEdit {
                        placeholder-text: "Search titles, notes, transcripts, and guides";
                        text <=> root.query;
                        accepted => { root.search(); }
                        accessible-label: "Search journal entries";
                    }
                }
                FormWrap {
                    Field {
                        label: "Sessions";
                        max-width: 260px;
                        ComboBox {
                            model: ["all", "with sessions", "without sessions"];
                            current-value <=> root.session-filter;
                            accessible-label: "Filter entries by session presence";
                        }
                    }
                    Field {
                        label: "Sort";
                        max-width: 260px;
                        ComboBox {
                            model: ["Newest first", "Oldest first", "Title"];
                            current-value <=> root.sort;
                            accessible-label: "Sort journal entries";
                        }
                    }
                    Field {
                        label: "Collection";
                        max-width: 260px;
                        ComboBox {
                            model: root.collection-options;
                            current-value <=> root.collection-filter;
                            accessible-label: "Filter entries by collection";
                        }
                    }
                    Field {
                        label: "Tag";
                        max-width: 260px;
                        ComboBox {
                            model: root.tag-options;
                            current-value <=> root.tag-filter;
                            accessible-label: "Filter entries by tag";
                        }
                    }
                    Field {
                        label: "From";
                        max-width: 260px;
                        LineEdit {
                            placeholder-text: "YYYY-MM-DD";
                            text <=> root.date-from;
                            accessible-label: "Filter entries from date";
                        }
                    }
                    Field {
                        label: "To";
                        max-width: 260px;
                        LineEdit {
                            placeholder-text: "YYYY-MM-DD";
                            text <=> root.date-to;
                            accessible-label: "Filter entries through date";
                        }
                    }
                }

                ActionWrap {
                    Button {
                        text: "Search";
                        variant: "primary";
                        clicked => { root.search(); }
                        accessible-label: "Search journal entries";
                    }
                    Button {
                        text: "Collections";
                        clicked => { root.action("collection-list", "", "", "", "", "", ""); }
                        accessible-label: "Manage journal collections";
                    }
                    Button {
                        text: "Tags";
                        clicked => { root.action("tag-list", "", "", "", "", "", ""); }
                        accessible-label: "Manage journal tags";
                    }
                }

                if root.list-output != "" : Text {
                    text: root.list-output;
                    color: Theme.muted;
                    font-size: 12px;
                    line-height-factor: 1.4;
                    wrap: word-wrap;
                    accessible-live-region: AccessibleLiveness.polite;
                }
            }

            entry-workspace-card := Card {
                heading: "Journal entry";
                detail: root.selected-entry == "" ? "No entry selected." : root.selected-entry;

                ActionWrap {
                    Button {
                        text: "Open entry";
                        enabled: root.entry-id != "";
                        clicked => { root.action("entry-show", root.entry-id, "", "", "", "", ""); }
                    }
                    Button {
                        text: "Update entry";
                        enabled: root.entry-id != "";
                        clicked => {
                            root.action("entry-update", root.entry-id, root.entry-title,
                                        root.entry-date, root.entry-collection, root.entry-tag, "");
                        }
                    }
                    Button {
                        text: "Clear date";
                        enabled: root.entry-id != "";
                        clicked => {
                            root.entry-date = "";
                            root.action("entry-clear-date", root.entry-id, "", "", "", "", "");
                        }
                    }
                    Button {
                        text: "Delete entry";
                        variant: "danger";
                        enabled: root.entry-delete-confirmed && root.entry-id != "";
                        clicked => { root.action("entry-delete", root.entry-id, "", "", "", "", ""); }
                    }
                }

                CheckBox {
                    text: "Confirm deletion of this entry";
                    checked <=> root.entry-delete-confirmed;
                }

                FormWrap {
                    Field {
                        label: "Title";
                        LineEdit {
                            placeholder-text: "Title";
                            text <=> root.entry-title;
                            accessible-label: "Journal entry title";
                        }
                    }
                    Field {
                        label: "Date";
                        LineEdit {
                            placeholder-text: "YYYY-MM-DD";
                            text <=> root.entry-date;
                            accessible-label: "Journal entry date";
                        }
                    }
                    Field {
                        label: "Collection";
                        ComboBox {
                            model: root.collection-options;
                            current-value <=> root.entry-collection;
                            accessible-label: "Entry collection";
                        }
                    }
                    Field {
                        label: "Tag";
                        ComboBox {
                            model: root.tag-options;
                            current-value <=> root.entry-tag;
                            accessible-label: "Entry tag";
                        }
                    }
                }
            }

            session-card := Card {
                heading: "Lessons linked to this entry";
                detail: "Each lesson has its own session notes and recordings.";

                FormWrap {
                    Field {
                        label: "Date";
                        max-width: 260px;
                        LineEdit {
                            placeholder-text: "YYYY-MM-DD";
                            text <=> root.timeline-date;
                            accessible-label: "Session timeline date";
                        }
                    }
                }
                ActionWrap {
                    Button {
                        text: "Jump to date";
                        clicked => {
                            root.action("session-list", root.entry-id, root.timeline-date,
                                        root.timeline-date, "", "", "");
                        }
                    }
                    Button {
                        text: "All dates";
                        clicked => {
                            root.timeline-date = "";
                            root.action("session-list", root.entry-id, "", "", "", "", "");
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.line; }

                Text { text: "New session"; color: Theme.ink; font-size: 14px; font-weight: 700; }
                FormWrap {
                    Field {
                        label: "Title";
                        LineEdit {
                            placeholder-text: "Session title";
                            text <=> root.session-title;
                            accessible-label: "Session title";
                        }
                    }
                    Field {
                        label: "Mode";
                        max-width: 260px;
                        ComboBox {
                            model: ["notes-only", "record-audio", "import-recording"];
                            current-value <=> root.session-type;
                            accessible-label: "New session mode";
                        }
                    }
                    Field {
                        label: "Student";
                        ComboBox {
                            model: root.session-student-options;
                            current-value <=> root.session-student;
                            accessible-label: "Student for the new session";
                        }
                    }
                    Field {
                        label: "Language";
                        max-width: 180px;
                        LineEdit {
                            placeholder-text: "auto";
                            text <=> root.session-language;
                            accessible-label: "Session language code";
                        }
                    }
                    Field {
                        label: "Subject";
                        LineEdit {
                            placeholder-text: "Subject";
                            text <=> root.session-subject;
                        }
                    }
                    Field {
                        label: "Learning objectives";
                        LineEdit {
                            placeholder-text: "Learning objectives";
                            text <=> root.session-objectives;
                        }
                    }
                    Field {
                        label: "Guide template";
                        ComboBox {
                            model: root.guide-template-options;
                            current-value <=> root.session-template;
                            accessible-label: "Guide template for the new session";
                        }
                    }
                    Field {
                        label: "Capture source";
                        max-width: 260px;
                        ComboBox {
                            model: root.session-type == "record-audio" ?
                                   ["microphone", "system-audio", "both", "application"] :
                                   root.session-type == "import-recording" ?
                                   ["imported-file"] : ["none"];
                            current-value <=> root.session-recording-source;
                            accessible-label: "Audio capture source for the new session";
                        }
                    }
                }

                if root.session-student == "Create a new student" : FormWrap {
                    Field {
                        label: "New student";
                        LineEdit {
                            placeholder-text: "Student name";
                            text <=> root.session-new-student-name;
                            accessible-label: "New student name";
                        }
                    }
                    Field {
                        label: "Grade or level";
                        max-width: 260px;
                        LineEdit {
                            placeholder-text: "Grade or level";
                            text <=> root.session-new-student-grade;
                            accessible-label: "New student grade or level";
                        }
                    }
                }

                if root.advanced-open : Field {
                    label: "Session ID";
                    LineEdit {
                        placeholder-text: "Session UUID";
                        text <=> root.session-id;
                        accessible-label: "Session identifier";
                    }
                }

                ActionWrap {
                    Button {
                        text: "New session";
                        variant: "primary";
                        clicked => {
                            root.create-session(root.entry-id, root.session-type,
                                root.session-title, root.session-student, root.session-subject,
                                root.session-objectives, root.session-language,
                                root.session-template, root.session-new-student-name,
                                root.session-new-student-grade, root.session-recording-source);
                        }
                        accessible-label: "Create a new session in this journal entry";
                    }
                    Button {
                        text: "Show timeline";
                        clicked => {
                            root.action("session-list", root.entry-id, root.timeline-date,
                                        root.timeline-date, "", "", "");
                        }
                    }
                    Button {
                        text: "Open session";
                        enabled: root.selected-session-id() != "";
                        clicked => { root.open-session("Session · " + root.selected-session-id()); }
                    }
                    Button {
                        text: "Review transcript";
                        enabled: root.selected-session-id() != "";
                        clicked => { root.review-transcript("Session · " + root.selected-session-id()); }
                    }
                    Button {
                        text: "Recording / import controls";
                        enabled: root.selected-session-id() != "";
                        clicked => { root.open-recording-controls(root.selected-session-id()); }
                    }
                }

                ActionWrap {
                    Button {
                        text: "Resume session";
                        enabled: root.selected-session-id() != "";
                        clicked => {
                            root.action("session-resume", root.selected-session-id(),
                                        "", "", "", "", "");
                        }
                    }
                    Button {
                        text: "Complete session";
                        enabled: root.selected-session-id() != "";
                        clicked => {
                            root.action("session-complete", root.selected-session-id(),
                                        "", "", "", "", "");
                        }
                    }
                    Button {
                        text: "Mark reviewed";
                        enabled: root.selected-session-id() != "";
                        clicked => {
                            root.action("session-review", root.selected-session-id(),
                                        "", "", "", "", "");
                        }
                    }
                }

                if root.session-options.length == 0 : Text {
                    text: "No sessions are linked to this entry yet.";
                    color: Theme.ink;
                    font-size: 12px;
                }

                if root.session-options.length > 0 : VerticalLayout {
                    spacing: 8px;
                    for session in root.session-options : Rectangle {
                        border-width: 1px;
                        border-color: root.selected-session == session ? Theme.accent : Theme.line;
                        border-radius: Theme.radius-card;
                        background: root.selected-session == session ? Theme.accent-soft : Theme.surface;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Button {
                                text: session;
                                variant: "ghost";
                                fill: true;
                                clicked => { root.selected-session = session; }
                                accessible-label: "Select session " + session;
                            }
                            if root.selected-session == session : ActionWrap {
                                Button {
                                    text: root.session-expanded ? "Hide details" : "Show details";
                                    clicked => {
                                        root.session-expanded = !root.session-expanded;
                                        if root.session-expanded {
                                            root.action("session-show", session, "", "", "", "", "");
                                        }
                                    }
                                }
                                Button {
                                    text: "Open session";
                                    clicked => { root.open-session("Session · " + session); }
                                }
                                Button {
                                    text: "Review transcript";
                                    clicked => { root.review-transcript("Session · " + session); }
                                }
                                Button {
                                    text: "Recording controls";
                                    clicked => { root.open-recording-controls(session); }
                                }
                            }
                            if root.selected-session == session && root.session-expanded : Text {
                                text: root.session-detail-output;
                                color: Theme.ink;
                                font-size: 12px;
                                wrap: word-wrap;
                                accessible-live-region: AccessibleLiveness.polite;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.line; }

                Text { text: "Delete selected session"; color: Theme.ink; font-size: 14px; font-weight: 700; }
                if root.selected-session-id() == "" : Text {
                    text: "Select a session in the timeline before reviewing deletion.";
                    color: Theme.faint;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if root.selected-session-id() != "" : VerticalLayout {
                    spacing: 8px;
                    ScrollText {
                        height: 84px;
                        text: root.session-delete-scope-output;
                        text-color: Theme.ink;
                    }
                    CheckBox {
                        text: "I reviewed the deletion scope and want to remove this session.";
                        checked <=> root.session-delete-confirmed;
                        enabled: root.session-delete-scope-reviewed &&
                                  root.selected-session-id() == root.session-delete-preview-id;
                    }
                    ActionWrap {
                        Button {
                            text: "Review deletion scope";
                            clicked => {
                                root.session-delete-confirmed = false;
                                root.session-delete-scope-reviewed = false;
                                root.session-delete-preview-id = "";
                                root.action("session-delete-preview", root.selected-session-id(),
                                            "", "", "", "", "");
                            }
                        }
                        Button {
                            text: "Confirm session deletion";
                            variant: "danger";
                            enabled: root.session-delete-confirmed &&
                                      root.session-delete-scope-reviewed &&
                                      root.selected-session-id() == root.session-delete-preview-id;
                            clicked => {
                                root.action("session-delete-confirm", root.selected-session-id(),
                                            root.session-delete-scope-token, "", "", "", "");
                                root.session-delete-confirmed = false;
                            }
                        }
                    }
                }

                Text {
                    text: "Audio starts only after microphone access, input level, and consent are confirmed.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.timeline-output;
                    color: Theme.ink;
                    font-size: 12px;
                    wrap: word-wrap;
                    accessible-live-region: AccessibleLiveness.polite;
                }
            }

            notes-card := Card {
                heading: "Entry notes";
                Text {
                    text: "Notes are edited as separate blocks, so each block keeps its type and identity.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                ActionWrap {
                    if root.advanced-open : LineEdit {
                        placeholder-text: "Notes document ID";
                        text <=> root.document-id;
                        enabled: root.entry-id != "";
                        min-width: 280px;
                    }
                    Button {
                        text: "Load notes";
                        enabled: root.document-id != "";
                        clicked => { root.action("document-show", root.document-id, "", "", "", "", ""); }
                    }
                }

                FormWrap {
                    Field {
                        label: "Block";
                        ComboBox {
                            model: root.note-block-options;
                            current-value <=> root.selected-note-block;
                            enabled: root.document-block-count > 0;
                        }
                    }
                    Field {
                        label: "Type";
                        max-width: 220px;
                        ComboBox {
                            model: ["Paragraph", "Heading", "Bulleted list",
                                    "Numbered list", "Checklist", "Quote", "Code"];
                            current-value <=> root.document-block-kind;
                            enabled: root.document-block-count > 0;
                        }
                    }
                }

                ActionWrap {
                    Button {
                        text: "Bold";
                        enabled: root.inline-format-enabled;
                        clicked => {
                            root.action("document-block-format", root.document-id,
                                        root.selected-note-block, "bold", "", "", "");
                        }
                    }
                    Button {
                        text: "Italic";
                        enabled: root.inline-format-enabled;
                        clicked => {
                            root.action("document-block-format", root.document-id,
                                        root.selected-note-block, "italic", "", "", "");
                        }
                    }
                    Button {
                        text: "Strike";
                        enabled: root.inline-format-enabled;
                        clicked => {
                            root.action("document-block-format", root.document-id,
                                        root.selected-note-block, "strike", "", "", "");
                        }
                    }
                    Button {
                        text: "Code";
                        enabled: root.inline-format-enabled;
                        clicked => {
                            root.action("document-block-format", root.document-id,
                                        root.selected-note-block, "code", "", "", "");
                        }
                    }
                    Button {
                        text: "Link";
                        enabled: root.inline-format-enabled;
                        clicked => {
                            root.action("document-block-format", root.document-id,
                                        root.selected-note-block, "link", "", "", "");
                        }
                    }
                }

                Text {
                    text: "Select text to format, or place the cursor to insert a span. Formatting uses portable Markdown; Ctrl+B, Ctrl+I, and Ctrl+K also work.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 176px;
                    border-width: 1px;
                    border-color: Theme.line;
                    border-radius: Theme.radius-input;
                    background: Theme.surface;

                    TextInput {
                        x: 9px;
                        y: 8px;
                        width: parent.width - 18px;
                        height: 160px;
                        single-line: false;
                        wrap: word-wrap;
                        text <=> root.document-block-text;
                        font-size: 14px;
                        color: Theme.ink;
                        enabled: root.document-block-count > 0;
                        edited => { root.document-block-text = self.text; }
                        cursor-position-changed(position) => {
                            root.document-block-anchor-offset = self.anchor-position-byte-offset;
                            root.document-block-focus-offset = self.cursor-position-byte-offset;
                        }
                        key-pressed(event) => {
                            if (root.inline-format-enabled &&
                                (event.modifiers.control || event.modifiers.meta) &&
                                event.text == Key.B) {
                                root.action("document-block-format", root.document-id,
                                            root.selected-note-block, "bold", "", "", "");
                                accept
                            } else if (root.inline-format-enabled &&
                                       (event.modifiers.control || event.modifiers.meta) &&
                                       event.text == Key.I) {
                                root.action("document-block-format", root.document-id,
                                            root.selected-note-block, "italic", "", "", "");
                                accept
                            } else if (root.inline-format-enabled &&
                                       (event.modifiers.control || event.modifiers.meta) &&
                                       event.text == Key.K) {
                                root.action("document-block-format", root.document-id,
                                            root.selected-note-block, "link", "", "", "");
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                }

                ActionWrap {
                    Button {
                        text: "Save block";
                        enabled: root.document-id != "" && root.selected-note-block != "";
                        clicked => {
                            root.action("document-block-update", root.document-id,
                                        root.selected-note-block, root.document-block-kind,
                                        root.document-block-text, "", "");
                        }
                    }
                    Button {
                        text: "Move up";
                        enabled: root.document-block-index > 0;
                        clicked => {
                            root.action("document-block-move", root.document-id,
                                        root.selected-note-block, "up", "", "", "");
                        }
                    }
                    Button {
                        text: "Move down";
                        enabled: root.document-block-index >= 0 &&
                                  root.document-block-index + 1 < root.document-block-count;
                        clicked => {
                            root.action("document-block-move", root.document-id,
                                        root.selected-note-block, "down", "", "", "");
                        }
                    }
                    Button {
                        text: "Remove block";
                        variant: "danger";
                        enabled: root.document-id != "" && root.selected-note-block != "";
                        clicked => {
                            root.action("document-block-remove", root.document-id,
                                        root.selected-note-block, "", "", "", "");
                        }
                    }
                    if root.document-removed-block-id != "" : Button {
                        text: "Undo remove";
                        enabled: root.writable;
                        clicked => {
                            root.action("document-block-restore", root.document-id,
                                        root.document-removed-block-id, "", "", "", "");
                        }
                    }
                }

                TextArea {
                    height: 90px;
                    text <=> root.document-new-block-text;
                    placeholder-text: "Write a new note block…";
                    font-size: 14px;
                    enabled: root.document-id != "";
                }
                ActionWrap {
                    Button {
                        text: "Add block";
                        enabled: root.document-id != "" && root.document-new-block-text != "";
                        clicked => {
                            root.action("document-block-add", root.document-id,
                                        root.document-block-kind, root.document-new-block-text,
                                        root.selected-note-block, "", "");
                        }
                    }
                }

                CheckBox {
                    text: "Show saved notes as a whole document";
                    checked <=> root.document-show-preview;
                }
                if root.document-show-preview : ScrollText {
                    height: 100px;
                    text: root.document-text;
                    text-color: Theme.ink;
                }
            }

            Card {
                heading: "Journal guide";

                ActionWrap {
                    Button {
                        text: "Generate guide from this entry";
                        enabled: root.entry-id != "";
                        clicked => {
                            root.action("guide-generate-entry", root.entry-id, "", "", "", "", "");
                        }
                    }
                    Button {
                        text: "Open study guides";
                        clicked => { root.open-guides(); }
                    }
                }
                Text {
                    text: root.guide-output;
                    color: Theme.ink;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            organize-card := Card {
                heading: "Organize this journal";

                FormWrap {
                    Field {
                        label: "Collection";
                        ComboBox {
                            model: root.collection-options;
                            current-value <=> root.item-collection;
                            accessible-label: "Collection to update or delete";
                        }
                    }
                    Field {
                        label: "Tag";
                        ComboBox {
                            model: root.tag-options;
                            current-value <=> root.item-tag;
                            accessible-label: "Tag to update or delete";
                        }
                    }
                }

                if root.advanced-open : Field {
                    label: "Collection or tag ID";
                    LineEdit { placeholder-text: "UUID"; text <=> root.item-id; }
                }

                FormWrap {
                    Field {
                        label: "Name";
                        LineEdit { placeholder-text: "Collection or tag name"; text <=> root.item-name; }
                    }
                    Field {
                        label: "Description";
                        LineEdit { placeholder-text: "Description"; text <=> root.item-description; }
                    }
                    Field {
                        label: "Color";
                        max-width: 220px;
                        LineEdit { placeholder-text: "Optional"; text <=> root.item-color; }
                    }
                }

                ActionWrap {
                    Button {
                        text: "Add collection";
                        clicked => {
                            root.action("collection-create", root.item-name,
                                        root.item-description, root.item-color, "", "", "");
                        }
                    }
                    Button {
                        text: "Add tag";
                        clicked => {
                            root.action("tag-create", root.item-name,
                                        root.item-description, root.item-color, "", "", "");
                        }
                    }
                    Button {
                        text: "Update collection";
                        clicked => {
                            root.action("collection-update", root.collection-choice(),
                                        root.item-name, root.item-description, root.item-color,
                                        "", "");
                        }
                    }
                    Button {
                        text: "Update tag";
                        clicked => {
                            root.action("tag-update", root.tag-choice(),
                                        root.item-name, root.item-description, root.item-color,
                                        "", "");
                        }
                    }
                }

                CheckBox {
                    text: "Confirm deleting the selected collection or tag";
                    checked <=> root.item-delete-confirmed;
                }
                ActionWrap {
                    Button {
                        text: "Delete collection";
                        variant: "danger";
                        enabled: root.item-delete-confirmed;
                        clicked => {
                            root.action("collection-delete", root.collection-choice(),
                                        "", "", "", "", "");
                        }
                    }
                    Button {
                        text: "Delete tag";
                        variant: "danger";
                        enabled: root.item-delete-confirmed;
                        clicked => {
                            root.action("tag-delete", root.tag-choice(), "", "", "", "", "");
                        }
                    }
                }
            }
        }
    }
}
