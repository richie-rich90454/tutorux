// Top command bar: breadcrumb plus the small set of contextual commands.
import { Button, Theme } from "../theme.slint";

export component CommandBar inherits Rectangle {
    in property <string> archive-path;
    in property <string> archive-name;
    in property <string> session-title;
    in property <bool> inspector-open: true;
    in-out property <bool> menu-open: false;

    callback action(string);

    height: Theme.toolbar-height;
    background: Theme.surface;

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.line;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 14px;
        spacing: 4px;
        cross-axis-alignment: center;

        Image {
            width: 17px;
            height: 17px;
            source: @image-url("../assets/icons/archive.svg");
            colorize: Theme.muted;
            accessible-role: none;
        }

        Text {
            text: root.archive-path == "" ? "No archive open" :
                  root.session-title != "" ? root.archive-name + "  /  " + root.session-title :
                                              root.archive-name;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Button {
            text: "Search";
            variant: "ghost";
            enabled: root.archive-path != "";
            clicked => { root.action("focus-search"); }
        }
        Button {
            text: "Commands";
            variant: "ghost";
            clicked => { root.action("command-palette"); }
        }
        Rectangle {
            width: 1px;
            height: 20px;
            background: Theme.line;
            cross-axis-self-alignment: center;
        }
        Button {
            text: root.inspector-open ? "Hide details" : "Details";
            variant: "ghost";
            enabled: root.session-title != "";
            clicked => { root.action("toggle-details"); }
        }
        Button {
            text: "Export";
            variant: "ghost";
            enabled: root.archive-path != "" && root.session-title != "";
            clicked => { root.action("export"); }
        }

        Button {
            width: 34px;
            button-min-width: 34px;
            button-min-height: 34px;
            horizontal-padding: 0px;
            variant: "ghost";
            text: "···";
            accessible-label: "More actions";
            clicked => { root.menu-open = !root.menu-open; }
        }
    }

    if root.menu-open : Rectangle {
        x: parent.width - 274px;
        y: 54px;
        width: 256px;
        height: self.preferred-height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 5px;
        z: 50;

        VerticalLayout {
            padding: 7px;
            spacing: 2px;

            Button {
                width: 100%;
                fill: true;
                button-min-height: 32px;
                horizontal-padding: 9px;
                label-left-aligned: true;
                variant: "ghost";
                text: "Journal…";
                clicked => { root.menu-open = false; root.action("journal-tools"); }
            }
            Button {
                width: 100%;
                fill: true;
                button-min-height: 32px;
                horizontal-padding: 9px;
                label-left-aligned: true;
                variant: "ghost";
                text: "Guide editor…";
                clicked => { root.menu-open = false; root.action("guide-editor"); }
            }
            Button {
                width: 100%;
                fill: true;
                button-min-height: 32px;
                horizontal-padding: 9px;
                label-left-aligned: true;
                variant: "ghost";
                text: "Configure audio…";
                clicked => { root.menu-open = false; root.action("configure-audio"); }
            }
            Button {
                width: 100%;
                fill: true;
                button-min-height: 32px;
                horizontal-padding: 9px;
                label-left-aligned: true;
                variant: "ghost";
                text: "Study guides…";
                clicked => { root.menu-open = false; root.action("guide-tools"); }
            }
            Button {
                width: 100%;
                fill: true;
                button-min-height: 32px;
                horizontal-padding: 9px;
                label-left-aligned: true;
                variant: "ghost";
                text: "AI actions…";
                clicked => { root.menu-open = false; root.action("ai"); }
            }
            Button {
                width: 100%;
                fill: true;
                button-min-height: 32px;
                horizontal-padding: 9px;
                label-left-aligned: true;
                variant: "ghost";
                text: "Command console…";
                clicked => { root.menu-open = false; root.action("console"); }
            }
            Button {
                width: 100%;
                fill: true;
                button-min-height: 32px;
                horizontal-padding: 9px;
                label-left-aligned: true;
                variant: "ghost";
                text: "Settings…";
                clicked => { root.menu-open = false; root.action("settings"); }
            }
        }
    }
}
