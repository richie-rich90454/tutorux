// Notebook: virtualized structured notes with inline editing and truthful save state.
import { Button, ComboBox, LineEdit, Theme } from "../theme.slint";
import { ListView } from "std-widgets.slint";
import { AppEmptyState } from "../components/app-states.slint";
import { NoteRow } from "../models.slint";

export component Notebook inherits Rectangle {
    in property <[NoteRow]> rows: [];
    in property <string> document-id;
    in-out property <string> selected-block;
    in-out property <string> block-text;
    in-out property <string> block-kind: "Paragraph";
    in property <bool> inline-format-enabled: false;
    in property <bool> writable: true;
    in-out property <string> save-state: "saved";
    in-out property <string> new-block-text;

    // action: remove | add | format
    callback action(string, string);
    callback save-block(string, string, string);
    callback open-journal-tools();

    horizontal-stretch: 1;
    vertical-stretch: 1;
    clip: true;
    background: Theme.surface;
    property <bool> composer-open: false;
    property <string> pending-block;
    property <string> pending-text;
    property <string> pending-kind;

    public function flush-pending() {
        if (root.pending-block != "" && root.writable) {
            root.save-state = "saving";
            root.save-block(root.pending-block, root.pending-text, root.pending-kind);
        }
    }

    save-timer := Timer {
        interval: 900ms;
        running: false;
        triggered() => { root.flush-pending(); }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        Rectangle {
            height: 52px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                Text {
                    text: "Working notebook";
                    color: Theme.ink;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { }
                Rectangle {
                    width: 6px;
                    height: 6px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: root.save-state == "failed" ? Theme.danger :
                                root.save-state == "saving" ? Theme.warning : Theme.success;
                }
                Text {
                    text: root.save-state == "failed" ? "Save failed — retry" :
                          root.save-state == "saving" ? "Saving…" :
                          root.save-state == "unsaved" ? "Not saved" :
                          root.writable ? "Saved to archive" : "Archive read-only";
                    color: root.save-state == "failed" ? Theme.danger : Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.save-state == "failed" : Button {
                    text: "Retry";
                    variant: "ghost";
                    enabled: root.writable && root.selected-block != "";
                    clicked => {
                        if (root.pending-block != "") {
                            root.flush-pending();
                        } else {
                            root.save-state = "saving";
                            root.save-block(root.selected-block, root.block-text, root.block-kind);
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }

        if root.rows.length == 0 : AppEmptyState {
            vertical-stretch: 1;
            title: "Start writing.";
            body: "Add the first note block to this session. Notes are stored in the portable archive as structured blocks.";
            action-label: root.writable ? "Add note" : "";
            action-enabled: root.writable;
            action => { root.composer-open = true; }
        }

        if root.rows.length > 0 : Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: Theme.surface;
            ListView {
                x: max(0px, (parent.width - 819px) / 2);
                width: min(parent.width, 819px);
                height: 100%;
                for note in root.rows : Rectangle {
                    width: parent.width;
                    height: note-layout.preferred-height + 14px;
                    background: root.selected-block == note.choice ? Theme.surface-hover : transparent;
                    border-radius: 5px;

                    note-layout := VerticalLayout {
                        x: 10px;
                        width: parent.width - 20px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        spacing: 4px;

                        if root.selected-block == note.choice : Rectangle {
                            border-width: 1px;
                            border-color: Theme.focus-ring;
                            border-radius: 5px;
                            background: Theme.surface;

                            VerticalLayout {
                                padding: 6px;
                                note-editor := TextInput {
                                    text <=> root.block-text;
                                    single-line: false;
                                    wrap: word-wrap;
                                    font-size: note.kind == "Heading" ? 28px : 14px;
                                    font-weight: note.kind == "Heading" ? 700 : 400;
                                    color: Theme.ink;
                                    height: max(28px, self.preferred-height);
                                    selection-background-color: Theme.accent;
                                    selection-foreground-color: Theme.on-accent;
                                    edited => {
                                        root.block-text = self.text;
                                        root.pending-block = root.selected-block;
                                        root.pending-text = self.text;
                                        root.pending-kind = root.block-kind;
                                        root.save-state = "unsaved";
                                        save-timer.restart();
                                    }
                                }
                            }
                        }
                        if root.selected-block != note.choice : Text {
                            text: note.text;
                            color: note.kind == "Quote" ? Theme.muted : Theme.body;
                            font-size: note.kind == "Heading" ? 28px : 14px;
                            font-weight: note.kind == "Heading" ? 700 : 400;
                            line-height-factor: note.kind == "Heading" ? 1.45 : 1.32;
                            wrap: word-wrap;
                        }
                    }

                    TouchArea {
                        clicked => {
                            if (root.selected-block != note.choice) {
                                root.flush-pending();
                                root.selected-block = note.choice;
                                root.block-text = note.text;
                            }
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }

        Rectangle {
            height: 58px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 8px;
                Button {
                    text: root.composer-open ? "Close composer" : "Add note";
                    enabled: root.writable;
                    visible: root.rows.length > 0;
                    clicked => { root.composer-open = !root.composer-open; }
                }
                Button {
                    text: "Journal tools";
                    clicked => { root.open-journal-tools(); }
                }
                if root.selected-block != "" : ComboBox {
                    model: ["Paragraph", "Heading", "Bulleted list", "Numbered list",
                            "Checklist", "Quote", "Code"];
                    current-value <=> root.block-kind;
                    width: 150px;
                    horizontal-stretch: 0;
                    selected(value) => {
                        if (root.pending-block != "") {
                            root.pending-kind = value;
                            root.pending-text = root.block-text;
                        }
                    }
                }
                Rectangle { }
                if root.selected-block != "" : Button {
                    text: "Remove";
                    variant: "danger";
                    enabled: root.writable;
                    clicked => { root.action("remove", ""); }
                }
            }
        }

        if root.selected-block != "" && !root.composer-open : Rectangle {
            height: 46px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 4px;
                Text {
                    text: "Format";
                    width: 48px;
                    color: Theme.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Button { text: "Bold"; variant: "ghost"; enabled: root.inline-format-enabled; clicked => { root.action("format", "bold"); } }
                Button { text: "Italic"; variant: "ghost"; enabled: root.inline-format-enabled; clicked => { root.action("format", "italic"); } }
                Button { text: "Strike"; variant: "ghost"; enabled: root.inline-format-enabled; clicked => { root.action("format", "strike"); } }
                Button { text: "Code"; variant: "ghost"; enabled: root.inline-format-enabled; clicked => { root.action("format", "code"); } }
                Button { text: "Link"; variant: "ghost"; enabled: root.inline-format-enabled; clicked => { root.action("format", "link"); } }
                Rectangle { }
            }
        }

        if root.composer-open : Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 5px;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;
                Text { text: "New note block"; color: Theme.ink; font-size: 14px; font-weight: 600; }
                LineEdit {
                    placeholder-text: "Write the note…";
                    text <=> root.new-block-text;
                }
                HorizontalLayout {
                    spacing: 8px;
                    ComboBox {
                        model: ["Paragraph", "Heading", "Bulleted list", "Numbered list",
                                "Checklist", "Quote", "Code"];
                        current-value <=> root.block-kind;
                        width: 150px;
                        horizontal-stretch: 0;
                    }
                    Button {
                        text: "Add block";
                        variant: "primary";
                        enabled: root.document-id != "" && root.new-block-text != "" && root.writable;
                        clicked => {
                            root.save-state = "saving";
                            root.action("add", "");
                            root.composer-open = false;
                        }
                    }
                    Rectangle { }
                    Button {
                        text: "Cancel";
                        variant: "ghost";
                        clicked => { root.composer-open = false; }
                    }
                }
            }
        }
    }
}
