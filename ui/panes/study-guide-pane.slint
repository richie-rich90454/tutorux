import { Button, ComboBox, ScrollArea, TextArea, Theme } from "../theme.slint";
import { ActionWrap, Field, FormWrap } from "../components/page-parts.slint";

export component StudyGuidePane inherits Rectangle {
    in property <[string]> guide-options: [];
    in property <[string]> block-options: [];
    in property <string> output;
    in property <bool> writable: true;
    in-out property <string> selected-guide;
    in-out property <string> selected-block;
    in-out property <string> edit-text;
    in-out property <bool> tools-open: false;
    in-out property <bool> delete-armed: false;

    callback load-block();
    callback save-block();
    callback action(string);
    callback open-ai();
    callback open-full-editor();
    callback manage-templates();
    callback guide-changed(string);

    horizontal-stretch: 1;
    vertical-stretch: 1;
    clip: true;
    background: Theme.surface;

    changed selected-guide => {
        root.delete-armed = false;
        if (root.selected-guide != "") {
            root.guide-changed(root.selected-guide);
        }
    }

    ScrollArea {
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, page.preferred-height);
        vertical-scrollbar-policy: as-needed;

        page := VerticalLayout {
            width: min(root.width - 16px, 1000px);
            x: max(0px, (root.width - self.width) / 2);
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 24px;
            padding-bottom: 40px;
            spacing: 14px;
            alignment: start;

            ActionWrap {
                Text {
                    text: "Study guide";
                    color: Theme.ink;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Button {
                    text: root.tools-open ? "Hide guide tools" : "Guide tools";
                    clicked => { root.tools-open = !root.tools-open; }
                }
                Button {
                    text: "AI actions";
                    clicked => { root.open-ai(); }
                }
                Button {
                    text: "Full editor";
                    clicked => { root.open-full-editor(); }
                }
                Button {
                    text: "Manage templates";
                    clicked => { root.manage-templates(); }
                }
            }

            Rectangle { height: 1px; background: Theme.line; }

            FormWrap {
                Field {
                    label: "Guide";
                    ComboBox {
                        model: root.guide-options;
                        current-value <=> root.selected-guide;
                    }
                }
                Field {
                    label: "Block";
                    ComboBox {
                        model: root.block-options;
                        current-value <=> root.selected-block;
                    }
                }
                Button {
                    text: "Load block";
                    enabled: root.selected-guide != "" && root.selected-block != "";
                    clicked => { root.load-block(); }
                }
            }

            if root.tools-open : VerticalLayout {
                spacing: 10px;
                ActionWrap {
                    Button { text: "Validate"; enabled: root.selected-guide != ""; clicked => { root.action("validate"); } }
                    Button { text: "Approve"; enabled: root.selected-guide != "" && root.writable; clicked => { root.action("approve"); } }
                    Button { text: "Regenerate section"; enabled: root.selected-guide != "" && root.writable; clicked => { root.action("regenerate-section"); } }
                    Button { text: "Add example"; enabled: root.selected-guide != "" && root.writable; clicked => { root.action("add-example"); } }
                    Button { text: "Move section up"; enabled: root.selected-guide != "" && root.writable; clicked => { root.action("move-section-up"); } }
                    Button { text: "Move section down"; enabled: root.selected-guide != "" && root.writable; clicked => { root.action("move-section-down"); } }
                    Button { text: "Compare with prior"; enabled: root.selected-guide != ""; clicked => { root.action("compare"); } }
                    Button { text: "Duplicate guide"; enabled: root.selected-guide != "" && root.writable; clicked => { root.action("duplicate"); } }
                    Button {
                        text: root.delete-armed ? "Confirm move to Trash" : "Move guide to Trash";
                        variant: "danger";
                        enabled: root.selected-guide != "" && root.writable;
                        clicked => {
                            if root.delete-armed {
                                root.delete-armed = false;
                                root.action("delete");
                            } else {
                                root.delete-armed = true;
                            }
                        }
                    }
                    if root.delete-armed : Button { text: "Cancel"; clicked => { root.delete-armed = false; } }
                    Button { text: "Remove block"; variant: "danger"; enabled: root.selected-guide != "" && root.writable; clicked => { root.action("remove-block"); } }
                }
            }

            if root.selected-block != "" : VerticalLayout {
                spacing: 8px;
                Text { text: "Block text"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                TextArea {
                    height: 280px;
                    text <=> root.edit-text;
                    placeholder-text: "Write the selected guide block…";
                    font-size: 14px;
                    enabled: root.writable;
                }
                ActionWrap {
                    Button {
                        text: "Save block";
                        variant: "primary";
                        enabled: root.selected-guide != "" && root.selected-block != "" && root.writable;
                        clicked => { root.save-block(); }
                    }
                }
            }

            Text {
                text: root.output;
                color: Theme.muted;
                font-size: 12px;
                line-height-factor: 1.45;
                wrap: word-wrap;
            }

            if root.selected-guide == "" : VerticalLayout {
                spacing: 10px;
                Text {
                    text: "No study guide yet.";
                    color: Theme.ink;
                    font-size: 28px;
                    font-weight: 700;
                }
                Text {
                    text: "Generate a guide with AI actions or import one through the command console.";
                    color: Theme.body;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                ActionWrap {
                    Button {
                        text: "AI actions";
                        variant: "primary";
                        clicked => { root.open-ai(); }
                    }
                }
            }
        }
    }
}
