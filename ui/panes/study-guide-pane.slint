// Study guide tab: guide selection, block editing, review actions, export route.
import { Button, ComboBox, ScrollArea, Theme } from "../theme.slint";

export component StudyGuidePane inherits Rectangle {
    in property <[string]> guide-options: [];
    in property <[string]> block-options: [];
    in property <string> output;
    in property <bool> writable: true;
    in-out property <string> selected-guide;
    in-out property <string> selected-block;
    in-out property <string> edit-text;
    in-out property <bool> tools-open: false;

    callback load-block();
    callback save-block();
    callback action(string);
    callback open-ai();
    callback open-full-editor();

    horizontal-stretch: 1;
    vertical-stretch: 1;
    clip: true;
    background: Theme.surface;

    ScrollArea {
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, page.preferred-height);
        vertical-scrollbar-policy: as-needed;

        page := VerticalLayout {
            x: max(0px, (root.width - self.width) / 2);
            width: min(root.width - 14px, 867px);
            padding-left: 48px;
            padding-right: 48px;
            padding-top: 26px;
            padding-bottom: 64px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Study guide";
                    color: Theme.ink;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { }
                Button {
                    text: root.tools-open ? "Hide guide tools" : "Guide tools";
                    clicked => { root.tools-open = !root.tools-open; }
                }
                Button {
                    text: "AI actions";
                    clicked => { root.open-ai(); }
                }
                Button {
                    text: "Full editor";
                    clicked => { root.open-full-editor(); }
                }
            }

            Rectangle { height: 1px; background: Theme.line; }

            if root.tools-open : VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Guide"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                        ComboBox {
                            model: root.guide-options;
                            current-value <=> root.selected-guide;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 2;
                        spacing: 5px;
                        Text { text: "Block"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                        ComboBox {
                            model: root.block-options;
                            current-value <=> root.selected-block;
                        }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: " "; color: Theme.faint; font-size: 12px; }
                        Button {
                            text: "Load block";
                            enabled: root.selected-guide != "" && root.selected-block != "";
                            clicked => { root.load-block(); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "Validate"; enabled: root.selected-guide != ""; clicked => { root.action("validate"); } }
                    Button { text: "Approve"; enabled: root.selected-guide != ""; clicked => { root.action("approve"); } }
                    Button { text: "Regenerate section"; enabled: root.selected-guide != ""; clicked => { root.action("regenerate-section"); } }
                    Button { text: "Add example"; enabled: root.selected-guide != ""; clicked => { root.action("add-example"); } }
                    Rectangle { }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "Move section up"; enabled: root.selected-guide != ""; clicked => { root.action("move-section-up"); } }
                    Button { text: "Move section down"; enabled: root.selected-guide != ""; clicked => { root.action("move-section-down"); } }
                    Button { text: "Compare with prior"; enabled: root.selected-guide != ""; clicked => { root.action("compare"); } }
                    Button { text: "Remove block"; variant: "danger"; enabled: root.selected-guide != ""; clicked => { root.action("remove-block"); } }
                    Rectangle { }
                }
            }

            if root.selected-block != "" : VerticalLayout {
                spacing: 8px;
                Text { text: "Block text"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                TextInput {
                    height: 280px;
                    single-line: false;
                    wrap: word-wrap;
                    text <=> root.edit-text;
                    font-size: 14px;
                    color: Theme.body;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Save block";
                        variant: "primary";
                        enabled: root.selected-guide != "" && root.selected-block != "" && root.writable;
                        clicked => { root.save-block(); }
                    }
                    Rectangle { }
                }
            }

            Text {
                text: root.output;
                color: Theme.muted;
                font-size: 12px;
                line-height-factor: 1.45;
                wrap: word-wrap;
            }

            if root.selected-guide == "" : VerticalLayout {
                spacing: 10px;
                Text {
                    text: "No study guide yet.";
                    color: Theme.ink;
                    font-size: 28px;
                    font-weight: 700;
                }
                Text {
                    text: "Generate a guide with AI actions or import one through the command console.";
                    color: Theme.body;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: "AI actions";
                        variant: "primary";
                        clicked => { root.open-ai(); }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
            }
        }
    }
}
