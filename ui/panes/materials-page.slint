import { Button, LineEdit, ScrollArea, ScrollText, Theme } from "../theme.slint";
import { ActionWrap, Field, FormWrap } from "../components/page-parts.slint";
import { WaveformBucketRow } from "../models.slint";
import { WaveformView } from "../components/waveform-view.slint";

export component MaterialsPage inherits Rectangle {
    in property <string> session-title;
    in property <string> preview-kind: "message";
    in property <string> preview-description;
    in property <string> preview-body;
    in property <[WaveformBucketRow]> preview-waveform-buckets: [];
    in property <string> preview-waveform-state: "empty";
    in property <int> preview-waveform-duration-seconds: 0;
    in property <bool> preview-playing: false;
    in property <string> preview-playback-status;
    in property <string> command-output;
    in property <bool> writable: true;
    in property <image> preview-image;
    in-out property <string> input-path;
    in-out property <string> selected-asset;
    in property <string> undo-asset-id;

    callback import-file(string);
    callback import-folder(string);
    callback browse-import();
    callback browse-folder();
    callback list-materials();
    callback preview(string);
    callback play-audio(string);
    callback stop-audio(string);
    callback remove-file(string);
    callback restore-file(string);

    horizontal-stretch: 1;
    vertical-stretch: 1;
    clip: true;
    background: Theme.surface;

    ScrollArea {
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, page.preferred-height);

        page := VerticalLayout {
            x: max(0px, (root.width - self.width) / 2);
            width: min(root.width - 16px, 1040px);
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 24px;
            padding-bottom: 40px;
            spacing: 14px;
            alignment: start;

            Text { text: "Materials"; color: Theme.ink; font-size: 28px; font-weight: 700; }
            Text {
                text: root.session-title == "" ? "Select a session to see the files archived with it." :
                      "Files archived with " + root.session-title + ".";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }

            FormWrap {
                width: 100%;
                Field {
                    label: "Import";
                    width: 100%;
                    min-width: 0px;
                    max-width: 720px;
                    LineEdit {
                        width: 100%;
                        placeholder-text: "File path to import into this session";
                        text <=> root.input-path;
                        enabled: root.writable;
                    }
                }
            }
            ActionWrap {
                width: 100%;
                Button {
                    text: "Browse file…";
                    enabled: root.writable;
                    clicked => { root.browse-import(); }
                }
                Button {
                    text: "Import";
                    enabled: root.writable && root.session-title != "" && root.input-path != "";
                    clicked => { root.import-file(root.input-path); }
                }
                Button {
                    text: "Browse folder…";
                    enabled: root.writable;
                    clicked => { root.browse-folder(); }
                }
                Button {
                    text: "Import folder";
                    enabled: root.writable && root.session-title != "" && root.input-path != "";
                    clicked => { root.import-folder(root.input-path); }
                }
                Button {
                    text: "List materials";
                    enabled: root.session-title != "";
                    clicked => { root.list-materials(); }
                }
                Button {
                    text: "Preview selected";
                    enabled: root.selected-asset != "";
                    clicked => { root.preview(root.selected-asset); }
                }
                Button {
                    text: "Move to Trash";
                    variant: "danger";
                    enabled: root.writable && root.selected-asset != "";
                    clicked => { root.remove-file(root.selected-asset); }
                }
                Button {
                    text: "Undo remove";
                    visible: root.undo-asset-id != "";
                    enabled: root.writable;
                    clicked => { root.restore-file(root.undo-asset-id); }
                }
            }

            Rectangle { height: 1px; background: Theme.line; }
            Text {
                text: root.preview-description;
                color: Theme.body;
                font-size: 14px;
                line-height-factor: 1.45;
                wrap: word-wrap;
            }
            if root.preview-kind == "image" : Image {
                source: root.preview-image;
                width: min(parent.width, 720px);
                height: min(parent.width * 0.62, 460px);
                image-fit: contain;
            }
            if root.preview-body != "" : ScrollText {
                height: 320px;
                text: root.preview-body;
                text-color: Theme.body;
            }
            if root.preview-kind == "audio" : VerticalLayout {
                spacing: 8px;
                Text { text: "Audio waveform"; color: Theme.ink; font-size: 13px; font-weight: 600; }
                ActionWrap {
                    Button {
                        text: "Play audio";
                        enabled: !root.preview-playing;
                        clicked => { root.play-audio(root.selected-asset); }
                    }
                    Button {
                        text: "Stop";
                        enabled: root.preview-playing;
                        clicked => { root.stop-audio(root.selected-asset); }
                    }
                    Text {
                        text: root.preview-playback-status;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                WaveformView {
                    height: 104px;
                    buckets: root.preview-waveform-buckets;
                    duration-seconds: root.preview-waveform-duration-seconds;
                    duration-label: "";
                    playhead-label: "";
                    state: root.preview-waveform-state;
                    message: root.preview-waveform-state == "silent" ? "This audio is silent." :
                            "Waveform data is unavailable for this file.";
                    seek-enabled: false;
                }
            }

            if root.command-output != "" : VerticalLayout {
                spacing: 6px;
                Text { text: "Status"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                ScrollText {
                    height: min(96px, self.preferred-height);
                    text: root.command-output;
                    text-color: Theme.body;
                    font-size: 12px;
                }
            }
        }
    }
}
