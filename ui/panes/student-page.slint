import { Button, CheckBox, ComboBox, LineEdit, ScrollArea, ScrollText, Theme } from "../theme.slint";
import { ActionWrap, Field, FormWrap } from "../components/page-parts.slint";

export component StudentPage inherits Rectangle {
    in property <string> selected-student;
    in property <string> progress-output;
    in property <bool> writable: true;
    in-out property <bool> advanced: false;

    in-out property <string> name;
    in-out property <string> grade;
    in-out property <string> subjects;
    in-out property <string> objectives;
    in-out property <string> difficulties;
    in-out property <string> improvements;
    in-out property <string> template;
    in-out property <string> notes;

    in-out property <string> review-skill;
    in-out property <string> review-classification;
    in-out property <string> review-evidence;
    in-out property <string> review-reviewer;
    in-out property <string> review-note;

    callback save-profile();
    callback review-progress();
    callback load-history();
    callback new-student();

    horizontal-stretch: 1;
    vertical-stretch: 1;
    clip: true;
    background: Theme.surface;

    ScrollArea {
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, page.preferred-height);

        page := VerticalLayout {
            x: max(0px, (root.width - self.width) / 2);
            width: min(root.width - 14px, 920px);
            padding-left: 48px;
            padding-right: 48px;
            padding-top: 36px;
            padding-bottom: 56px;
            spacing: 22px;
            alignment: start;

            FlexboxLayout {
                flex-wrap: wrap;
                alignment: space-between;
                cross-axis-alignment: center;
                spacing: 12px;

                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Student record"; color: Theme.faint; font-size: 12px; font-weight: 600; }
                    Text {
                        text: root.name == "" ? "Select a student" : root.name;
                        color: Theme.ink;
                        font-size: 28px;
                        font-weight: 700;
                        line-height-factor: 1.3;
                    }
                    Text {
                        text: root.grade == "" ? "No grade recorded" : root.grade;
                        color: Theme.muted;
                        font-size: 12px;
                    }
                }

                ActionWrap {
                    CheckBox {
                        text: "Advanced IDs";
                        checked <=> root.advanced;
                    }
                    Button {
                        text: "New student";
                        enabled: root.writable;
                        clicked => { root.new-student(); }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.line; }

            if root.name == "" : Text {
                text: "Choose a student in the navigator to review their profile, session chronology, and learning history.";
                color: Theme.body;
                font-size: 14px;
                line-height-factor: 1.45;
                wrap: word-wrap;
            }

            if root.name != "" : VerticalLayout {
                spacing: 16px;

                Text { text: "Profile"; color: Theme.ink; font-size: 16px; font-weight: 700; }
                FormWrap {
                    Field { label: "Name"; LineEdit { text <=> root.name; } }
                    Field { label: "Grade or level"; LineEdit { text <=> root.grade; } }
                    Field { label: "Subjects"; LineEdit { text <=> root.subjects; } }
                    Field { label: "Learning objectives"; LineEdit { text <=> root.objectives; } }
                    Field { label: "Known difficulties"; LineEdit { text <=> root.difficulties; } }
                    Field { label: "Demonstrated improvements"; LineEdit { text <=> root.improvements; } }
                    Field { label: "Preferred guide template"; LineEdit { text <=> root.template; } }
                    Field { label: "Tutor notes"; LineEdit { text <=> root.notes; } }
                }
                ActionWrap {
                    Button {
                        text: "Save profile";
                        variant: "primary";
                        enabled: root.selected-student != "" && root.writable;
                        clicked => { root.save-profile(); }
                    }
                    Button {
                        text: "Load learning history";
                        enabled: root.selected-student != "";
                        clicked => { root.load-history(); }
                    }
                }

                Rectangle { height: 1px; background: Theme.line; }

                Text { text: "Learning history"; color: Theme.ink; font-size: 16px; font-weight: 700; }
                ScrollText {
                    height: 300px;
                    text: root.progress-output;
                    text-color: Theme.body;
                }

                Rectangle { height: 1px; background: Theme.line; }

                Text { text: "Tutor review"; color: Theme.ink; font-size: 16px; font-weight: 700; }
                Text {
                    text: "Classifications require source evidence from this student's archive. Mastery requires human-verified evidence.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                FormWrap {
                    Field { label: "Skill"; LineEdit { text <=> root.review-skill; } }
                    Field {
                        label: "Classification";
                        max-width: 280px;
                        ComboBox {
                            model: ["newly-observed", "recurring", "partial-improvement",
                                    "demonstrated-mastery", "unverified-improvement", "not-revisited"];
                            current-value <=> root.review-classification;
                        }
                    }
                    if root.advanced : Field {
                        label: "Evidence node IDs";
                        LineEdit { text <=> root.review-evidence; }
                    }
                    Field { label: "Reviewed by"; LineEdit { text <=> root.review-reviewer; } }
                    Field { label: "Review note"; LineEdit { text <=> root.review-note; } }
                }
                ActionWrap {
                    Button {
                        text: "Save reviewed progress";
                        variant: "primary";
                        enabled: root.selected-student != "" && root.writable;
                        clicked => { root.review-progress(); }
                    }
                }
            }
        }
    }
}
