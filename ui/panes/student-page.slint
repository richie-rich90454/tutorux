// Students scope: profile, learning history, and tutor-reviewed progress.
import { Button, ComboBox, LineEdit, ScrollArea, ScrollText, Theme } from "../theme.slint";

export component StudentPage inherits Rectangle {
    in property <string> selected-student;
    in property <string> progress-output;
    in property <bool> writable: true;

    in-out property <string> name;
    in-out property <string> grade;
    in-out property <string> subjects;
    in-out property <string> objectives;
    in-out property <string> difficulties;
    in-out property <string> improvements;
    in-out property <string> template;
    in-out property <string> notes;

    in-out property <string> review-skill;
    in-out property <string> review-classification;
    in-out property <string> review-evidence;
    in-out property <string> review-reviewer;
    in-out property <string> review-note;

    callback save-profile();
    callback review-progress();
    callback load-history();
    callback new-student();

    horizontal-stretch: 1;
    vertical-stretch: 1;
    clip: true;
    background: Theme.surface;

    ScrollArea {
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, page.preferred-height);

        page := VerticalLayout {
            x: max(0px, (root.width - self.width) / 2);
            width: min(root.width - 14px, 920px);
            padding-left: 48px;
            padding-right: 48px;
            padding-top: 36px;
            padding-bottom: 56px;
            spacing: 22px;

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Student record"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                    Text {
                        text: root.name == "" ? "Select a student" : root.name;
                        color: Theme.ink;
                        font-size: 30px;
                        font-weight: 700;
                        line-height-factor: 1.3;
                    }
                    Text {
                        text: root.grade == "" ? "No grade recorded" : root.grade;
                        color: Theme.muted;
                        font-size: 12.5px;
                    }
                }
                Rectangle { }
                Button {
                    text: "New student";
                    enabled: root.writable;
                    clicked => { root.new-student(); }
                }
            }

            Rectangle { height: 1px; background: Theme.line; }

            if root.name == "" : Text {
                text: "Choose a student in the navigator to review their profile, session chronology, and learning history.";
                color: Theme.body;
                font-size: 14px;
                line-height-factor: 1.45;
                wrap: word-wrap;
            }

            if root.name != "" : VerticalLayout {
                spacing: 16px;

                Text { text: "Profile"; color: Theme.ink; font-size: 17px; font-weight: 700; }

                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Name"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.name; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Grade or level"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.grade; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Subjects"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.subjects; }
                    }
                }
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Learning objectives"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.objectives; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Known difficulties"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.difficulties; }
                    }
                }
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Demonstrated improvements"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.improvements; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Preferred guide template"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.template; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Tutor notes"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.notes; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: "Save profile";
                        variant: "primary";
                        enabled: root.selected-student != "" && root.writable;
                        clicked => { root.save-profile(); }
                    }
                    Button {
                        text: "Load learning history";
                        enabled: root.selected-student != "";
                        clicked => { root.load-history(); }
                    }
                    Rectangle { }
                }

                Rectangle { height: 1px; background: Theme.line; }

                Text { text: "Learning history"; color: Theme.ink; font-size: 17px; font-weight: 700; }
                ScrollText {
                    height: 300px;
                    text: root.progress-output;
                    text-color: Theme.body;
                }

                Rectangle { height: 1px; background: Theme.line; }

                Text { text: "Tutor review"; color: Theme.ink; font-size: 17px; font-weight: 700; }
                Text {
                    text: "Classifications require source evidence from this student's archive. Mastery requires human-verified evidence.";
                    color: Theme.muted;
                    font-size: 11.5px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Skill"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.review-skill; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Classification"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        ComboBox {
                            model: ["newly-observed", "recurring", "partial-improvement",
                                    "demonstrated-mastery", "unverified-improvement", "not-revisited"];
                            current-value <=> root.review-classification;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Evidence node IDs"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.review-evidence; }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Reviewed by"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.review-reviewer; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: "Review note"; color: Theme.faint; font-size: 11px; font-weight: 600; }
                        LineEdit { text <=> root.review-note; }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: " "; color: Theme.faint; font-size: 11px; }
                        Button {
                            text: "Save reviewed progress";
                            variant: "primary";
                            enabled: root.selected-student != "" && root.writable;
                            clicked => { root.review-progress(); }
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
            }
        }
    }
}
