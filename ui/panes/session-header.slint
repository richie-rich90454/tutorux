// Session heading and document tabs. The heading stays aligned with the
// notebook column; the tab rule spans the available width.
import { TabButton, Theme } from "../theme.slint";

export component SessionHeader inherits Rectangle {
    in property <string> title;
    in property <string> student;
    in property <string> started;
    in property <string> state;
    in property <string> recording-state: "not-started";
    in-out property <string> tab: "notebook";

    callback rename(string);
    callback tab-changed(string);

    background: Theme.surface;
    property <bool> editing: false;
    property <string> draft;

    VerticalLayout {
        padding-left: max(40px, (parent.width - Theme.page-max-width) / 2);
        padding-right: max(40px, (parent.width - Theme.page-max-width) / 2);
        padding-top: 28px;
        spacing: 0px;

        HorizontalLayout {
            spacing: 10px;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                if root.editing : TextInput {
                    text <=> root.draft;
                    font-size: 30px;
                    font-weight: 700;
                    color: Theme.ink;
                    height: 40px;
                    vertical-alignment: center;
                    accepted => {
                        root.rename(root.draft);
                        root.editing = false;
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.editing = false;
                            root.draft = root.title;
                            accept
                        } else {
                            reject
                        }
                    }
                }

                if !root.editing : Text {
                    text: root.title;
                    color: Theme.ink;
                    font-size: 30px;
                    font-weight: 700;
                    line-height-factor: 1.3;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 8px;
                    height: 20px;
                    Text {
                        text: root.student == "" ? "No student assigned" : root.student;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text { text: "·"; color: Theme.faint; font-size: 12px; }
                    Text {
                        text: root.started == "" ? "Not started" : root.started;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if root.recording-state == "recording" : Rectangle {
                        width: 6px;
                        height: 6px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: Theme.recording;
                    }
                    if root.recording-state == "recording" : Text {
                        text: "Recording now";
                        color: Theme.ink;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if root.recording-state == "paused" : Text {
                        text: "Recording paused";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if root.recording-state != "recording" && root.recording-state != "paused" : Text {
                        text: root.state;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { }

            if !root.editing : Rectangle {
                width: 64px;
                height: 34px;
                border-radius: 5px;
                background: edit-touch.has-hover ? Theme.surface-hover : transparent;

                Text {
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "Edit";
                    color: Theme.accent;
                    font-size: 12.5px;
                    font-weight: 600;
                }

                edit-touch := TouchArea {
                    clicked => {
                        root.draft = root.title;
                        root.editing = true;
                    }
                }
            }
        }

        Rectangle { height: 24px; }

        Rectangle {
            height: Theme.tab-height;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                spacing: 28px;
                TabButton {
                    text: "Notebook";
                    selected: root.tab == "notebook";
                    clicked => { root.tab = "notebook"; root.tab-changed("notebook"); }
                }
                TabButton {
                    text: "Transcript";
                    selected: root.tab == "transcript";
                    clicked => { root.tab = "transcript"; root.tab-changed("transcript"); }
                }
                TabButton {
                    text: "Study guide";
                    selected: root.tab == "guide";
                    clicked => { root.tab = "guide"; root.tab-changed("guide"); }
                }
                Rectangle { }
            }
        }
    }
}
