// Tutorux design system: tokens plus the widget set used across the app.
//
// These widgets intentionally replace most std-widgets ones: the standard
// fluent widgets follow the OS color scheme, and on a light application
// surface the dark scheme made scrollbar thumbs, placeholder text and
// control borders invisible. Everything here is scheme-independent.
import { TextEdit } from "std-widgets.slint";

export global Theme {
    // "light" | "dark". MainWindow writes this from its theme-mode property.
    in-out property <string> mode: "light";

    // Archive-paper surfaces follow the green folio mark; red marks recording.
    out property <color> canvas: Theme.mode == "dark" ? #101713 : #f7f8f5;
    out property <color> surface: Theme.mode == "dark" ? #171f19 : #ffffff;
    out property <color> surface-inset: Theme.mode == "dark" ? #121a15 : #f0f3ef;
    out property <color> surface-hover: Theme.mode == "dark" ? #1d2921 : #edf2ee;

    // Text
    out property <color> ink: Theme.mode == "dark" ? #f1f5f1 : #18211b;
    out property <color> body: Theme.mode == "dark" ? #d1dbd3 : #35443a;
    out property <color> muted: Theme.mode == "dark" ? #a5b5a9 : #637267;
    out property <color> faint: Theme.mode == "dark" ? #87968b : #839087;

    // Hairlines
    out property <color> line: Theme.mode == "dark" ? #2a3830 : #dfe6df;
    out property <color> line-subtle: Theme.mode == "dark" ? #23302874 : #edf1ed;
    out property <color> line-strong: Theme.mode == "dark" ? #405147 : #c5d0c6;

    // Archival green from logo.svg, with quieter leafy tints for selected and
    // focus states. Red is reserved for capture and destructive feedback.
    out property <color> accent: #315b4a;
    out property <color> accent-hover: Theme.mode == "dark" ? #3e705a : #294e3e;
    out property <color> accent-press: Theme.mode == "dark" ? #355f4c : #203f32;
    out property <color> accent-soft: Theme.mode == "dark" ? #22372b : #eaf0eb;
    out property <color> accent-bright: #9bc8aa;
    out property <color> accent-text: Theme.mode == "dark" ? #a8d4b6 : #315b4a;
    out property <color> focus-ring: Theme.mode == "dark" ? #9bc8aa99 : #315b4a66;

    // Semantic
    out property <color> danger: Theme.mode == "dark" ? #ff8278 : #b83d36;
    out property <color> danger-soft: Theme.mode == "dark" ? #351f1d : #faeeec;
    out property <color> danger-soft-hover: Theme.mode == "dark" ? #462522 : #f5dfdc;
    out property <color> danger-line: Theme.mode == "dark" ? #884841 : #e6b4ae;
    out property <color> success: Theme.mode == "dark" ? #a8d4b6 : #315b4a;
    out property <color> warning: Theme.danger;
    out property <color> recording: #e34d47;
    out property <color> waveform-background: Theme.mode == "dark" ? #142019 : #f1f5f1;
    out property <color> waveform-baseline: Theme.mode == "dark" ? #3b4c40 : #c8d4ca;
    out property <color> waveform-ink: Theme.mode == "dark" ? #9bc8aa : #315b4a;
    out property <color> waveform-gap: Theme.mode == "dark" ? #58302e : #f3dfdc;
    out property <color> waveform-playhead: Theme.mode == "dark" ? #e6f1e8 : #244736;
    out property <color> on-accent: #ffffff;
    out property <color> on-danger: #ffffff;
    out property <color> on-surface: Theme.ink;
    out property <color> disabled-text: Theme.mode == "dark" ? #707e74 : #9ba59d;
    out property <color> disabled-surface: Theme.mode == "dark" ? #151c17 : #f2f5f1;
    out property <color> disabled-line: Theme.mode == "dark" ? #2a3830 : #e2e8e1;

    // Navigator
    out property <color> sidebar: Theme.mode == "dark" ? #101713 : #f9faf8;
    out property <color> sidebar-hover: Theme.mode == "dark" ? #1b271f : #edf2ee;
    out property <color> sidebar-active: Theme.mode == "dark" ? #22372b : #eaf0eb;
    out property <color> sidebar-line: Theme.mode == "dark" ? #2a3830 : #dfe6df;
    out property <color> sidebar-card: Theme.mode == "dark" ? #171f19 : #ffffff;
    out property <color> sidebar-ink: Theme.mode == "dark" ? #f1f5f1 : #18211b;
    out property <color> sidebar-muted: Theme.mode == "dark" ? #a5b5a9 : #637267;
    out property <color> sidebar-faint: Theme.mode == "dark" ? #87968b : #839087;

    // Active capture uses the folio green rather than a generic black strip.
    out property <color> transport: #244638;
    out property <color> transport-text: #ffffff;
    out property <color> transport-muted: #c0d0c4;
    out property <color> transport-wave: #a8d4b6;
    out property <color> transport-quiet: #a9beb0;
    out property <color> transport-line: #496757;
    out property <color> transport-hover: #315b4a;
    out property <color> scrim: #0000002e;

    // Command console: intentionally dark in both modes.
    out property <color> console-bg: Theme.mode == "dark" ? #0d1510 : #122019;
    out property <color> console-line: Theme.mode == "dark" ? #26372c : #315442;
    out property <color> console-ink: Theme.mode == "dark" ? #d3e3d7 : #d8e9dd;

    // Scrollbars. Kept visible against white surfaces.
    out property <color> scrollbar: Theme.mode == "dark" ? #405247 : #c8d3ca;
    out property <color> scrollbar-hover: Theme.mode == "dark" ? #5d7163 : #9aaa9d;

    // Geometry (exactly 5 px on every rounded surface)
    out property <length> radius-card: 5px;
    out property <length> radius-input: 5px;
    out property <length> radius-pill: 5px;
    out property <length> control-height: 36px;
    out property <length> navigator-width: 264px;
    out property <length> inspector-width: 284px;
    out property <length> toolbar-height: 62px;
    out property <length> tab-height: 52px;
    out property <length> transport-height: 132px;
    out property <length> page-max-width: 819px;

    // Motion tokens. Content never animates its layout, only color/opacity.
    out property <duration> motion-hover: 120ms;
    out property <duration> motion-press: 80ms;
    out property <duration> motion-selection: 160ms;
    out property <duration> motion-expander: 180ms;
    out property <duration> motion-overlay: 180ms;
}

// Accent halo drawn on the focused control.
export component FocusRing inherits Rectangle {
    in property <length> radius: Theme.radius-input;

    width: 100%;
    height: 100%;
    border-width: 2px;
    border-color: Theme.focus-ring;
    border-radius: root.radius;
    accessible-role: none;
}

export component Button inherits Rectangle {
    in property <string> text;
    // "primary" | "secondary" | "ghost" | "danger"
    in property <string> variant: "secondary";
    in property <bool> enabled: true;
    in property <bool> busy: false;
    in property <bool> fill: false;
    out property <bool> has-focus: i-focus-scope.has-focus;
    out property <bool> pressed: self.enabled && !self.busy && i-touch-area.pressed;

    callback clicked;

    pure function resting-color() -> brush {
        if (root.variant == "primary") {
            return Theme.accent;
        }
        if (root.variant == "danger") {
            return Theme.danger-soft;
        }
        if (root.variant == "ghost") {
            return transparent;
        }
        return Theme.surface;
    }

    pure function hover-color() -> brush {
        if (root.variant == "primary") {
            return Theme.accent-hover;
        }
        if (root.variant == "danger") {
            return Theme.danger-soft-hover;
        }
        if (root.variant == "ghost") {
            return Theme.ink.with-alpha(0.06);
        }
        return Theme.surface-hover;
    }

    pure function press-color() -> brush {
        if (root.variant == "primary") {
            return Theme.accent-press;
        }
        if (root.variant == "danger") {
            return Theme.danger-line;
        }
        if (root.variant == "ghost") {
            return Theme.ink.with-alpha(0.1);
        }
        return Theme.surface-inset;
    }

    pure function label-color() -> brush {
        if (root.variant == "primary") {
            return Theme.on-accent;
        }
        if (root.variant == "danger") {
            return Theme.danger;
        }
        if (root.variant == "ghost") {
            return Theme.muted;
        }
        return Theme.ink;
    }

    min-width: 60px;
    max-width: root.fill ? 100000px : max(60px, i-layout.preferred-width);
    preferred-width: max(60px, i-layout.preferred-width);
    height: max(36px, i-layout.preferred-height);
    horizontal-stretch: root.fill ? 1 : 0;
    vertical-stretch: 0;
    forward-focus: i-focus-scope;

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { i-touch-area.clicked(); }

    states [
        disabled when !root.enabled || root.busy : {
            i-background.background: root.variant == "ghost" ? transparent : Theme.disabled-surface;
            i-background.border-color: root.variant == "ghost" ? transparent : Theme.disabled-line;
            i-label.color: Theme.disabled-text;
        }
        pressed when root.pressed : {
            i-background.background: root.press-color();
            i-label.color: root.label-color();
        }
        hover when root.enabled && !root.busy && i-touch-area.has-hover : {
            i-background.background: root.hover-color();
        }
    ]

    i-background := Rectangle {
        border-radius: Theme.radius-input;
        background: root.resting-color();
        border-width: root.variant == "ghost" ? 0px : 1px;
        border-color: root.variant == "primary" ? transparent :
                      root.variant == "danger" ? Theme.danger-line : Theme.line;

        animate background, border-color { duration: Theme.motion-hover; }

        i-layout := HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 6px;

            i-label := Text {
                horizontal-alignment: center;
                vertical-alignment: center;
                text: root.text;
                color: root.label-color();
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                accessible-role: none;
                animate color { duration: Theme.motion-hover; }
            }
        }
    }

    i-touch-area := TouchArea {
        enabled: root.enabled && !root.busy;
        clicked => { root.clicked(); }
    }

    i-focus-scope := FocusScope {
        x: 0;
        width: 0; // Keyboard focus only; clicks are handled by the touch area.
        enabled <=> root.enabled;

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                i-touch-area.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.has-focus && root.enabled : FocusRing { }
}

export component LineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <InputType> input-type <=> input.input-type;
    in property <bool> read-only <=> input.read-only;
    out property <bool> has-focus: input.has-focus;
    in property <bool> enabled <=> input.enabled;

    callback accepted(text: string);
    callback edited(text: string);

    public function focus-input() {
        input.focus();
    }

    min-width: 90px;
    min-height: max(Theme.control-height, input.preferred-height);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.radius-input;
    border-width: 1px;
    border-color: input.has-focus && root.enabled ? Theme.accent : Theme.line;
    background: root.enabled ? Theme.surface : Theme.surface-inset;
    clip: true;
    forward-focus: input;

    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-read-only: root.read-only;

    animate border-color { duration: 120ms; }

    placeholder := Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: left;
        text: (root.text == "" && input.preedit-text == "") ? root.placeholder-text : "";
        color: Theme.faint;
        overflow: elide;
        accessible-role: none;
    }

    field := Rectangle {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;

        input := TextInput {
            property <length> computed-x;

            x: min(0px, max(parent.width - self.width - self.text-cursor-width,
                            self.computed-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            vertical-alignment: center;
            single-line: true;
            color: root.enabled ? Theme.ink : Theme.disabled-text;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            // The widget root exposes the accessibility information.
            accessible-role: none;

            cursor-position-changed(cursor-position) => {
                if (cursor-position.x + self.computed_x < 2px) {
                    self.computed_x = -cursor-position.x + 2px;
                } else if (cursor-position.x + self.computed_x >
                           parent.width - 2px - self.text-cursor-width) {
                    self.computed_x =
                        parent.width - cursor-position.x - 2px - self.text-cursor-width;
                }
            }

            accepted => {
                root.accepted(input.text);
            }

            edited => {
                root.edited(input.text);
            }
        }
    }

    if input.has-focus && root.enabled : FocusRing { radius: Theme.radius-input; }
}

export component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> enabled <=> touch-area.enabled;
    in property <length> font-size;
    in property <int> font-weight;
    out property <bool> has-focus: focus-scope.has-focus;
    in-out property <bool> checked;

    callback toggled;

    private property <color> text-color: root.enabled ? Theme.ink : Theme.disabled-text;

    min-height: 22px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: focus-scope;

    accessible-checkable: true;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-checked <=> root.checked;
    accessible-role: checkbox;
    accessible-action-default => {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    states [
        disabled when !root.enabled : {
            background.background: Theme.disabled-surface;
            background.border-color: Theme.disabled-line;
            icon.colorize: Theme.disabled-text;
        }
        pressed when root.enabled && touch-area.pressed : {
            background.background: root.checked ? Theme.accent-press : Theme.surface-hover;
        }
        hover when root.enabled && touch-area.has-hover : {
            background.background: root.checked ? Theme.accent-hover : Theme.accent-soft;
        }
    ]

    animate text-color { duration: Theme.motion-hover; }

    layout := HorizontalLayout {
        spacing: 9px;

        background := Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            background: root.checked ? Theme.accent : Theme.surface;
            border-width: root.checked ? 0px : 1px;
            border-color: Theme.line-strong;
            border-radius: 5px;
            accessible-role: none;

            animate background, border-color { duration: 150ms; }

            icon := Image {
                image-fit: contain;
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                visible: root.checked;
                source: @image-url("assets/icons/check.svg");
                colorize: Theme.on-accent;
                accessible-role: none;
            }
        }

        if root.text != "" : Text {
            text: root.text;
            color: root.text-color;
            font-size: root.font-size;
            font-weight: root.font-weight;
            vertical-alignment: center;
            horizontal-alignment: left;
            wrap: word-wrap;
            horizontal-stretch: 1;
            accessible-role: none;
        }
    }

    touch-area := TouchArea {
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled();
            }
        }
    }

    focus-scope := FocusScope {
        x: 0;
        width: 0;
        enabled <=> root.enabled;

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch-area.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.has-focus && root.enabled : FocusRing { radius: 5px; }
}

// Scrollbar replicating the std-widgets geometry, with our own visuals so the
// thumb stays visible on light surfaces regardless of the OS color scheme.
component ScrollBar inherits Rectangle {
    in property <ScrollBarPolicy> policy: ScrollBarPolicy.as-needed;
    in property <bool> horizontal: false;
    in property <bool> enabled: true;
    in-out property <length> maximum;
    in-out property <length> page-size;
    in-out property <length> value;

    callback scrolled();

    clip: true;
    visible: (root.policy == ScrollBarPolicy.always-on) ||
             (root.policy == ScrollBarPolicy.as-needed && root.maximum > 0);

    property <length> inset: 4px;
    property <length> track-size:
        root.horizontal ? root.width - 2 * root.inset : root.height - 2 * root.inset;
    property <length> step-size: 24px;

    thumb := Rectangle {
        width: root.horizontal ?
            (root.maximum <= 0px ? 0px : max(min(24px, root.width),
                root.track-size * root.page-size / (root.maximum + root.page-size))) : 6px;
        height: root.horizontal ? 6px :
            (root.maximum <= 0px ? 0px : max(min(24px, root.height),
                root.track-size * root.page-size / (root.maximum + root.page-size)));
        x: root.horizontal ?
            (root.inset + (root.track-size - self.width) * (-root.value / root.maximum)) :
            (root.width - self.width) / 2;
        y: root.horizontal ? (root.height - self.height) / 2 :
            (root.inset + (root.track-size - self.height) * (-root.value / root.maximum));
        border-radius: 5px;
        background: i-touch-area.has-hover || i-touch-area.pressed ?
            Theme.scrollbar-hover : Theme.scrollbar;
        accessible-role: none;

        animate background { duration: 120ms; }
    }

    i-touch-area := TouchArea {
        width: 100%;
        height: 100%;

        property <{ pressed-value: length, maximum: length, x: length, y: length }> saved-values;

        function update-saved-values() {
            self.saved-values = { pressed-value: -root.value, maximum: root.maximum,
                                  x: self.mouse-x, y: self.mouse-y };
        }

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.update-saved-values();
            }
        }

        moved => {
            if (self.enabled && self.pressed) {
                // Re-anchor when the content size changes mid-drag to avoid jumps.
                if (self.saved-values.maximum != root.maximum) {
                    self.update-saved-values();
                }

                root.value = -max(0px, min(root.maximum, self.saved-values.pressed-value +
                    (root.horizontal ?
                        (self.mouse-x - self.saved-values.x) *
                            (root.maximum / (root.track-size - thumb.width)) :
                        (self.mouse-y - self.saved-values.y) *
                            (root.maximum / (root.track-size - thumb.height)))));
                root.scrolled();
            }
        }

        scroll-event(event) => {
            if (root.horizontal && event.delta-x != 0) {
                root.value = max(-root.maximum, min(0px, root.value + event.delta-x));
                return accept;
            } else if (!root.horizontal && event.delta-y != 0) {
                root.value = max(-root.maximum, min(0px, root.value + event.delta-y));
                return accept;
            }
            reject
        }
    }
}

export component ScrollArea inherits Rectangle {
    in property <bool> enabled: true;
    in property <ScrollBarPolicy> vertical-scrollbar-policy <=> vbar.policy;
    in property <ScrollBarPolicy> horizontal-scrollbar-policy <=> hbar.policy;
    in property <bool> mouse-drag-pan-enabled <=> flick.mouse-drag-pan-enabled;

    out property <length> visible-width <=> flick.width;
    out property <length> visible-height <=> flick.height;
    in-out property <length> content-width <=> flick.content-width;
    in-out property <length> content-height <=> flick.content-height;
    in-out property <length> content-x <=> flick.content-x;
    in-out property <length> content-y <=> flick.content-y;
    // Kept for API parity with the standard ScrollView (used by list views).
    in-out property <bool> has-focus;

    callback scrolled <=> flick.flicked;

    // As in the standard ScrollView: the default content size follows the
    // preferred size of the child layouts, so most usages need no bindings.
    min-height: 50px;
    min-width: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    flick := Flickable {
        mouse-drag-pan-enabled: false;
        content-y <=> vbar.value;
        content-x <=> hbar.value;
        width: parent.width;
        height: parent.height;

        @children
    }

    vbar := ScrollBar {
        enabled: root.enabled;
        width: 14px;
        x: flick.width + flick.x - self.width;
        y: flick.y;
        height: hbar.visible ? parent.height - hbar.height : parent.height;
        horizontal: false;
        maximum: flick.content-height - flick.height;
        page-size: flick.height;

        scrolled => { root.scrolled(); }
    }

    hbar := ScrollBar {
        enabled: root.enabled;
        width: vbar.visible ? parent.width - vbar.width : parent.width;
        height: 14px;
        y: flick.height + flick.y - self.height;
        x: flick.x;
        horizontal: true;
        maximum: flick.content-width - flick.width;
        page-size: flick.width;

        scrolled => { root.scrolled(); }
    }
}

// Scrollable block of wrapped, selectable text. Read-only text stays in a real
// text editor so users can select and copy output in both themes.
export component ScrollText inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.muted;
    in property <length> font-size: 12px;
    in property <string> font-family;

    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    ScrollArea {
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        vertical-scrollbar-policy: as-needed;

        body := TextInput {
            width: parent.visible-width - 14px;
            text: root.text;
            read-only: true;
            single-line: false;
            wrap: word-wrap;
            color: root.text-color;
            font-size: root.font-size;
            font-family: root.font-family;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            accessible-role: AccessibleRole.text;
            accessible-label: root.text;
        }
    }
}

// Multi-line editor surface with a visible border, internal scrolling, and the
// same focus ring as the other controls.
export component TextArea inherits Rectangle {
    in-out property <string> text <=> editor.text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <length> font-size: 14px;
    out property <bool> has-focus: editor.has-focus;

    height: 120px;
    border-width: 1px;
    border-color: editor.has-focus ? Theme.focus-ring : Theme.line;
    border-radius: Theme.radius-input;
    background: root.read-only ? Theme.surface-inset : Theme.surface;
    clip: true;

    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    ScrollArea {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        content-width: self.visible-width;
        content-height: max(self.visible-height, editor.preferred-height + 16px);
        vertical-scrollbar-policy: as-needed;

        editor := TextInput {
            x: 9px;
            y: 8px;
            width: parent.visible-width - 18px;
            height: max(parent.visible-height - 16px, self.preferred-height);
            single-line: false;
            wrap: word-wrap;
            color: root.read-only ? Theme.muted : Theme.ink;
            font-size: root.font-size;
            enabled: root.enabled;
            read-only: root.read-only;
            selection-background-color: Theme.accent-soft;
            selection-foreground-color: Theme.ink;
            accessible-role: AccessibleRole.text;
            accessible-label: root.placeholder-text;
        }
    }

    if root.text == "" && !root.read-only : Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        background: transparent;

        Text {
            x: 10px;
            y: 9px;
            width: parent.width - 20px;
            text: root.placeholder-text;
            color: Theme.faint;
            font-size: root.font-size;
            wrap: word-wrap;
            accessible-role: none;
        }

        TouchArea {
            clicked => { editor.focus(); }
        }
    }
}

export component ComboBox inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    out property <bool> has-focus:
        (i-focus-scope.has-focus || popup.is-open) && root.enabled;
    in-out property <int> current-index: 0;
    in-out property <string> current-value:
        root.model.length > 0 ? root.model[root.current-index] : "";

    callback selected(current-value: string);
    callback show-popup();
    callback close-popup();

    show-popup => {
        if root.enabled && root.model.length > 0 {
            popup.show();
        }
    }
    close-popup => { popup.close(); }

    property <length> item-height: 34px;
    property <length> popup-padding: 5px;
    property <int> visible-items: min(8, root.model.length);
    property <length> popup-scroll-y:
        -max(0, root.current-index - root.visible-items + 1) * root.item-height;

    public function select(index: int) {
        if (!root.enabled || index < 0 || index >= root.model.length) {
            return;
        }
        root.current-index = index;
        if root.current-value != root.model[index] {
            root.current-value = root.model[index];
        }
        root.selected(root.current-value);
    }

    public function move-selection-up() {
        root.select(max(root.current-index - 1, 0));
    }

    public function move-selection-down() {
        root.select(min(root.current-index + 1, root.model.length - 1));
    }

    function reset-current() {
        if (root.model.length == 0) {
            root.current-index = 0;
        } else {
            root.current-index = root.current-index.clamp(0, root.model.length - 1);
        }
    }

    function sync-current-index() {
        if root.model.index-of(root.current-value) >= 0 {
            root.current-index = root.model.index-of(root.current-value);
        }
    }

    // `current-value` is the state the host reads and writes; `current-index`
    // is only the navigation cursor. The popup highlights the row whose value
    // matches `current-value`, so an externally set value always shows
    // correctly even when its index is unknown.
    changed current-value => { root.sync-current-index(); }
    changed model => {
        root.reset-current();
        root.sync-current-index();
    }

    min-width: 110px;
    min-height: max(Theme.control-height, i-layout.min-height);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.radius-input;
    border-width: 1px;
    border-color: i-focus-scope.has-focus && root.enabled ? Theme.accent : Theme.line;
    background: root.enabled ? Theme.surface : Theme.disabled-surface;
    forward-focus: i-focus-scope;

    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: root.enabled && root.model.length > 0;
    accessible-expanded: popup.is-open;
    accessible-value <=> root.current-value;
    accessible-action-expand => { root.show-popup(); }

    animate border-color { duration: 120ms; }

    i-layout := HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;

        i-value := Text {
            horizontal-stretch: 1;
            horizontal-alignment: left;
            vertical-alignment: center;
            color: root.enabled ? Theme.ink : Theme.disabled-text;
            text: root.current-value;
            overflow: elide;
            accessible-role: none;
        }

        i-chevron := Image {
            width: 14px;
            height: 14px;
            vertical-alignment: center;
            source: @image-url("assets/icons/chevron-down.svg");
            colorize: Theme.faint;
            accessible-role: none;
        }
    }

    i-focus-scope := FocusScope {
        key-pressed(event) => {
            if (!self.enabled) {
                return reject;
            }
            if (event.text == Key.UpArrow) {
                root.move-selection-up();
                return accept;
            } else if (event.text == Key.DownArrow) {
                root.move-selection-down();
                return accept;
            } else if (event.text == Key.Return) {
                root.show-popup();
                return accept;
            }
            return reject;
        }

        i-touch-area := TouchArea {
            enabled: root.enabled;

            clicked => {
                root.focus();
                root.show-popup();
            }

            scroll-event(event) => {
                if (!root.has-focus) {
                    return reject;
                }
                if (event.delta-y < -2px) {
                    root.move-selection-down();
                    return accept;
                }
                if (event.delta-y > 2px) {
                    root.move-selection-up();
                    return accept;
                }
                reject
            }
        }
    }

    if i-focus-scope.has-focus && root.enabled : FocusRing { radius: Theme.radius-input; }

    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        height: root.visible-items * root.item-height + 2 * root.popup-padding;
        close-policy: close-on-click-outside;
        forward-focus: inner-focus;

        inner-focus := FocusScope {
            width: 100%;
            height: 100%;

            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.move-selection-up();
                    return accept;
                } else if (event.text == Key.DownArrow) {
                    root.move-selection-down();
                    return accept;
                } else if (event.text == Key.Return || event.text == Key.Escape) {
                    root.close-popup();
                    return accept;
                }
                return reject;
            }

            panel := Rectangle {
                width: 100%;
                height: 100%;
                border-radius: Theme.radius-card;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.line-strong;
                clip: true;

                ScrollArea {
                    width: 100%;
                    height: 100%;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, options.preferred-height);
                    content-y: root.popup-scroll-y;

                    options := VerticalLayout {
                        width: parent.visible-width;
                        padding: root.popup-padding;

                        for value[index] in root.model : Rectangle {
                            height: root.item-height;
                            border-radius: 5px;
                            background: value == root.current-value ? Theme.accent-soft :
                                        option-touch.has-hover ? Theme.surface-hover : transparent;

                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                                text: value;
                                color: value == root.current-value ? Theme.accent-text : Theme.ink;
                                font-weight: value == root.current-value ? 550 : 400;
                                overflow: elide;
                                accessible-role: none;
                            }

                            option-touch := TouchArea {
                                clicked => {
                                    root.select(index);
                                    popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected: false;
    in property <bool> enabled: true;

    callback clicked;

    height: 38px;
    border-radius: 5px;
    background: transparent;
    forward-focus: i-focus-scope;

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { i-touch-area.clicked(); }

    states [
        disabled when !root.enabled : {
            i-label.color: Theme.sidebar-faint;
            i-icon.colorize: Theme.sidebar-faint;
            i-indicator.background: transparent;
        }
        selected when root.selected : {
            background: Theme.sidebar-active;
            i-indicator.background: Theme.accent-bright;
            i-icon.colorize: Theme.on-accent;
            i-label.color: Theme.sidebar-ink;
        }
        hover when root.enabled && i-touch-area.has-hover : {
            background: Theme.sidebar-hover;
            i-label.color: Theme.sidebar-ink;
        }
    ]

    animate background { duration: 110ms; }

    i-layout := HorizontalLayout {
        padding-left: 9px;
        padding-right: 10px;
        spacing: 10px;

        i-indicator := Rectangle {
            width: 3px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-pill;
            background: transparent;
        }

        i-icon := Image {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: Theme.sidebar-muted;
            accessible-role: none;
        }

        i-label := Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            horizontal-alignment: left;
            text: root.text;
            color: Theme.sidebar-muted;
            font-size: 14px;
            font-weight: root.selected ? 600 : 500;
            overflow: elide;
            accessible-role: none;
        }
    }

    i-touch-area := TouchArea {
        clicked => { root.clicked(); }
    }

    i-focus-scope := FocusScope {
        x: 0;
        width: 0;
        enabled <=> root.enabled;

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                i-touch-area.clicked();
                return accept;
            }
            return reject;
        }
    }
}


// Square icon action used in the navigator and toolbar. 34 px hit area with a
// 16-18 px glyph; the accessible label is mandatory.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    out property <bool> has-focus: i-focus-scope.has-focus;

    callback clicked;

    width: 34px;
    height: 34px;
    border-radius: 5px;
    background: root.selected ? Theme.accent-soft :
                i-touch-area.has-hover && root.enabled ? Theme.surface-hover : transparent;
    forward-focus: i-focus-scope;

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-action-default => { i-touch-area.clicked(); }

    i-glyph := Image {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.enabled ? (root.selected ? Theme.accent : Theme.muted) : Theme.faint;
        accessible-role: none;
    }

    i-touch-area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    i-focus-scope := FocusScope {
        x: 0;
        width: 0;
        enabled <=> root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                i-touch-area.clicked();
                accept
            } else {
                reject
            }
        }
    }

    if i-focus-scope.has-focus && root.enabled : FocusRing { radius: 5px; }
}

// Text tab with a 2 px active underline. Used for navigator scopes and
// document tabs; never rendered as a pill or card.
export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;


    callback clicked;

    height: 100%;
    min-width: 58px;
    horizontal-stretch: 0;
    background: transparent;
    forward-focus: i-focus-scope;

    accessible-role: tab;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { i-touch-area.clicked(); }

    states [
        hover when root.enabled && !root.selected && i-touch-area.has-hover : {
            i-label.color: Theme.ink;
        }
    ]



    i-layout := HorizontalLayout {
        width: 100%;
        padding-left: 2px;
        padding-right: 2px;
        height: parent.height - 2px;

        i-label := Text {
            vertical-alignment: center;
            horizontal-alignment: center;
            text: root.text;
            color: root.enabled ? (root.selected ? Theme.ink : Theme.muted) : Theme.disabled-text;
            font-size: root.font-size;
            font-weight: root.selected ? 700 : root.font-weight;
            overflow: elide;
            accessible-role: none;
            animate color { duration: Theme.motion-hover; }
        }
    }

    i-rule := Rectangle {
        visible: root.selected;
        x: (parent.width - self.width) / 2;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: Theme.accent;
        border-radius: 0px;
        accessible-role: none;
    }

    i-touch-area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    i-focus-scope := FocusScope {
        x: 0;
        width: 0;
        enabled <=> root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                i-touch-area.clicked();
                accept
            } else {
                reject
            }
        }
    }

    if i-focus-scope.has-focus && root.enabled : FocusRing { radius: 2px; }
}
