// Shared empty and error states. One action, sentence case, no sample data.
import { Button, Theme } from "../theme.slint";

export component AppEmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    in property <string> action-label;
    in property <bool> action-enabled: true;

    callback action();

    spacing: 12px;
    padding: 24px;

    Text {
        text: root.title;
        color: Theme.ink;
        font-size: 16px;
        font-weight: 700;
        wrap: word-wrap;
    }
    Text {
        text: root.body;
        color: Theme.muted;
        font-size: 14px;
        wrap: word-wrap;
    }
    if root.action-label != "" : Button {
        text: root.action-label;
        variant: "primary";
        enabled: root.action-enabled;
        clicked => { root.action(); }
    }
}

export component AppErrorState inherits VerticalLayout {
    in property <string> title: "Something went wrong";
    in property <string> body;
    in property <string> retry-label: "Try again";

    callback retry();

    spacing: 12px;
    padding: 24px;

    Text {
        text: root.title;
        color: Theme.danger;
        font-size: 16px;
        font-weight: 700;
        wrap: word-wrap;
    }
    Text {
        text: root.body;
        color: Theme.body;
        font-size: 14px;
        wrap: word-wrap;
    }
    Button {
        text: root.retry-label;
        clicked => { root.retry(); }
    }
}

export component AppSkeleton inherits VerticalLayout {
    in property <int> rows: 4;

    spacing: 10px;
    padding: 24px;

    for index in root.rows : Rectangle {
        height: index == 0 ? 28px : 16px;
        width: index == 0 ? 60% : (Math.mod(index, 2) == 0 ? 92% : 78%);
        border-radius: 5px;
        background: Theme.surface-inset;
        animate opacity { duration: 600ms; }
    }
}
