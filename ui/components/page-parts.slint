import { Theme } from "../theme.slint";

export component Card inherits Rectangle {
    in property <string> heading;
    in property <string> detail;

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: Theme.radius-card;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: start;

        if root.heading != "" : Text {
            text: root.heading;
            color: Theme.ink;
            font-size: 16px;
            font-weight: 600;
        }
        if root.detail != "" : Text {
            text: root.detail;
            color: Theme.muted;
            font-size: 12px;
            line-height-factor: 1.4;
            wrap: word-wrap;
        }
        @children
    }
}

export component FormWrap inherits FlexboxLayout {
    flex-wrap: wrap;
    alignment: start;
    cross-axis-alignment: start;
    spacing: 10px;
}

export component ActionWrap inherits FlexboxLayout {
    flex-wrap: wrap;
    alignment: start;
    cross-axis-alignment: center;
    spacing: 8px;
}

export component Field inherits VerticalLayout {
    in property <string> label;

    min-width: 220px;
    max-width: 460px;
    horizontal-stretch: 1;
    spacing: 5px;

    if root.label != "" : Text {
        text: root.label;
        color: Theme.faint;
        font-size: 12px;
        font-weight: 600;
    }
    @children
}
