// Shared row models for the navigator and workbench panes.
// The C++ controller fills these arrays; the UI never invents rows.

export struct SessionRow {
    id: string,
    choice: string,
    title: string,
    meta: string,
    group: string,
    group-start: bool,
    state: string,
}

export struct StudentRow {
    id: string,
    choice: string,
    title: string,
    meta: string,
}

export struct MaterialRow {
    id: string,
    choice: string,
    title: string,
    meta: string,
}

export struct NoteRow {
    id: string,
    choice: string,
    kind: string,
    text: string,
}

export struct MarkerRow {
    id: string,
    time: string,
    label: string,
    start-seconds: int,
}

export struct WaveformBucketRow {
    position: float,
    width: float,
    start-seconds: float,
    end-seconds: float,
    minimum: float,
    maximum: float,
    contains-gap: bool,
}

export struct TrashRow {
    id: string,
    type-key: string,
    type-label: string,
    title: string,
    detail: string,
    deleted-at: string,
    restores-group: bool,
}
