// Recording transport. The original folio green marks an active capture; a
// quiet page strip stays in the background otherwise.
import { Button, ComboBox, Theme } from "./theme.slint";
import { MarkerRow, WaveformBucketRow } from "./models.slint";
import { WaveformView } from "./components/waveform-view.slint";
import { ActionWrap } from "./components/page-parts.slint";

export component RecordingTransport inherits Rectangle {
    in property <string> state: "not-started";
    in property <string> microphone;
    in property <bool> writable: true;
    in-out property <int> elapsed: 0;
    in property <[string]> take-options;
    in property <[string]> track-options;
    in-out property <string> selected-take-label;
    in-out property <string> selected-track-label;
    in property <[WaveformBucketRow]> waveform-buckets;
    in property <[MarkerRow]> markers: [];
    in property <int> duration-seconds: 0;
    in-out property <float> playback-position: 0;
    in property <int> playback-position-seconds: 0;
    in property <bool> playback-active: false;
    in property <string> waveform-state: "empty";
    in property <string> waveform-message;
    in property <int> live-level: 0;
    in property <[int]> live-peaks: [];
    in-out property <int> zoom-level: 0;
    in-out property <float> viewport-start: 0;

    callback command(string);
    callback mark(string);
    callback take-selected(string);
    callback track-selected(string);
    callback seek(float);
    callback open-consent();
    callback open-config();

    property <bool> active: root.state == "recording" || root.state == "paused" ||
                           root.state == "initializing" || root.state == "finalizing";

    height: root.active ? root.width < 760px ? 184px : Theme.transport-height :
        root.waveform-state == "empty" ? 64px : root.width < 760px ? 180px : 146px;
    background: root.active ? Theme.transport : Theme.surface;

    function pad2(value: int) -> string {
        return (value < 10 ? "0" : "") + (value * 1.0).to-fixed(0);
    }

    function elapsed-label() -> string {
        return pad2(root.elapsed / 3600) + ":" +
               pad2(Math.mod(root.elapsed / 60, 60)) + ":" +
               pad2(Math.mod(root.elapsed, 60));
    }

    function duration-label() -> string {
        return pad2(root.duration-seconds / 3600) + ":" +
               pad2(Math.mod(root.duration-seconds / 60, 60)) + ":" +
               pad2(Math.mod(root.duration-seconds, 60));
    }

    function playback-label() -> string {
        return pad2(root.playback-position-seconds / 3600) + ":" +
               pad2(Math.mod(root.playback-position-seconds / 60, 60)) + ":" +
               pad2(Math.mod(root.playback-position-seconds, 60));
    }

    function zoom-scale() -> float {
        return root.zoom-level == 0 ? 1 : root.zoom-level == 1 ? 2 :
               root.zoom-level == 2 ? 4 : root.zoom-level == 3 ? 8 : 16;
    }

    function zoom-label() -> string {
        return (root.zoom-level == 0 ? "1" : root.zoom-level == 1 ? "2" :
                root.zoom-level == 2 ? "4" : root.zoom-level == 3 ? "8" : "16") + "×";
    }

    tick := Timer {
        interval: 1s;
        running: root.state == "recording";
        triggered() => { root.elapsed += 1; }
    }

    if !root.active : Rectangle {
        width: 100%;
        height: 1px;
        background: Theme.line;
    }

    if !root.active && root.waveform-state == "empty" : HorizontalLayout {
        padding-left: 22px;
        padding-right: 18px;
        spacing: 12px;

        Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.state == "failed" ? Theme.danger : Theme.faint;
        }
        Text {
            text: root.state == "failed" ? "Recording needs attention" :
                  root.state == "completed" ? "Recording complete" :
                  root.state == "partial" ? "Partial recording" : "Ready to record";
            color: Theme.ink;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { }
        Button {
            text: "Configure audio";
            variant: "ghost";
            clicked => { root.open-config(); }
        }
        Button {
            text: "Start recording";
            variant: "primary";
            enabled: root.writable;
            clicked => { root.open-consent(); }
        }
    }

    if !root.active && root.waveform-state != "empty" : VerticalLayout {
        padding-left: 22px;
        padding-right: 18px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 6px;

        HorizontalLayout {
            height: 30px;
            spacing: 10px;
            Text {
                text: "Session audio";
                width: 92px;
                color: Theme.ink;
                font-size: 12px;
                font-weight: 650;
                vertical-alignment: center;
            }
            ComboBox {
                model: root.take-options;
                current-value <=> root.selected-take-label;
                selected(value) => { root.take-selected(value); }
            }
            ComboBox {
                model: root.track-options;
                current-value <=> root.selected-track-label;
                selected(value) => { root.track-selected(value); }
            }
        }
        ActionWrap {
            horizontal-stretch: 1;
            Button {
                text: root.playback-active ? "Stop playback" : "Play";
                enabled: root.waveform-state == "ready";
                clicked => { root.command(root.playback-active ? "stop-playback" : "play"); }
            }
            Button {
                text: "−";
                enabled: root.waveform-state == "ready" && root.zoom-level > 0;
                clicked => {
                    root.zoom-level = max(0, root.zoom-level - 1);
                    root.viewport-start = min(root.viewport-start, 1 - 1 / root.zoom-scale());
                }
            }
            Text {
                text: root.zoom-label();
                color: Theme.muted;
                font-size: 11px;
                vertical-alignment: center;
            }
            Button {
                text: "+";
                enabled: root.waveform-state == "ready" && root.zoom-level < 4;
                clicked => { root.zoom-level = min(4, root.zoom-level + 1); }
            }
            Button {
                text: "‹";
                enabled: root.waveform-state == "ready" && root.zoom-level > 0 &&
                         root.viewport-start > 0;
                clicked => {
                    root.viewport-start = max(0, root.viewport-start - 0.75 / root.zoom-scale());
                }
            }
            Button {
                text: "›";
                enabled: root.waveform-state == "ready" && root.zoom-level > 0 &&
                    root.viewport-start < 1 - 1 / root.zoom-scale();
                clicked => {
                    root.viewport-start = min(1 - 1 / root.zoom-scale(),
                        root.viewport-start + 0.75 / root.zoom-scale());
                }
            }
            Button {
                text: "Track manager";
                variant: "ghost";
                clicked => { root.open-config(); }
            }
            Button {
                text: "Record again";
                variant: "primary";
                enabled: root.writable;
                clicked => { root.open-consent(); }
            }
            Button {
                text: "Recover partial";
                visible: root.state == "partial" || root.state == "interrupted" ||
                         root.state == "failed";
                enabled: root.writable;
                clicked => { root.command("recover"); }
            }
        }
        WaveformView {
            height: 58px;
            buckets: root.waveform-buckets;
            markers: root.markers;
            duration-seconds: root.duration-seconds;
            duration-label: root.duration-label();
            playhead-label: root.playback-label();
            playhead-position: root.playback-position;
            playback-active: root.playback-active;
            zoom-scale: root.zoom-scale();
            viewport-start: root.viewport-start;
            state: root.waveform-state;
            message: root.waveform-message;
            seek(position) => { root.seek(position); }
        }
    }

    if root.active : FlexboxLayout {
        flex-wrap: wrap;
        cross-axis-alignment: center;
        padding-left: 22px;
        padding-right: 18px;
        spacing: 14px;

        VerticalLayout {
            width: 100px;
            spacing: 3px;
            padding-top: 18px;
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: root.state == "paused" ? Theme.transport-muted : Theme.recording;
                }
                Text {
                    text: root.state == "paused" ? "Paused" :
                          root.state == "initializing" ? "Starting" :
                          root.state == "finalizing" ? "Finalizing" : "Recording";
                    color: Theme.transport-text;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.elapsed-label();
                color: Theme.transport-text;
                font-size: 24px;
                font-weight: 600;
                letter-spacing: -0.4px;
            }
        }

        // Quiet region: a baseline and the current playhead only.
        VerticalLayout {
            min-width: 220px;
            horizontal-stretch: 1;
            spacing: 5px;
            HorizontalLayout {
                height: 30px;
                spacing: 8px;
                ComboBox {
                    model: root.take-options;
                    current-value <=> root.selected-take-label;
                    selected(value) => { root.take-selected(value); }
                }
                ComboBox {
                    model: root.track-options;
                    current-value <=> root.selected-track-label;
                    selected(value) => { root.track-selected(value); }
                }
            }
            WaveformView {
                height: 48px;
                buckets: root.waveform-buckets;
                markers: root.markers;
                duration-seconds: root.duration-seconds;
                duration-label: root.elapsed-label();
                playhead-label: root.elapsed-label();
                zoom-scale: 1;
                viewport-start: 0;
                playhead-position: 0;
                state: root.waveform-state;
                message: root.waveform-message;
                live: root.state == "recording" || root.state == "paused";
                live-level: root.live-level;
                live-peaks: root.live-peaks;
                seek-enabled: false;
                seek(position) => { root.seek(position); }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                width: 84px;
                height: 36px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.transport-line;
                background: mark-touch.has-hover ? Theme.transport-hover : transparent;
                Text {
                    text: "Mark";
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.transport-text;
                    font-size: 12px;
                    font-weight: 600;
                }
                mark-touch := TouchArea {
                    clicked => { root.mark(root.elapsed-label()); }
                }
            }
            Rectangle {
                width: 92px;
                height: 36px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.transport-line;
                background: pause-touch.has-hover ? Theme.transport-hover : transparent;
                Text {
                    text: root.state == "paused" ? "Resume" : "Pause";
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.transport-text;
                    font-size: 12px;
                    font-weight: 600;
                }
                pause-touch := TouchArea {
                    clicked => { root.command(root.state == "paused" ? "resume" : "pause"); }
                }
            }
            Rectangle {
                width: 82px;
                height: 36px;
                border-radius: 5px;
                background: stop-touch.has-hover ? Theme.danger : Theme.transport-text;
                Text {
                    text: "Stop";
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: stop-touch.has-hover ? Theme.on-danger : Theme.transport;
                    font-size: 12px;
                    font-weight: 700;
                }
                stop-touch := TouchArea {
                    clicked => { root.command("stop"); }
                }
            }
        }

        Text {
            text: root.microphone == "" ? "Default input" : root.microphone;
            color: Theme.transport-muted;
            font-size: 12px;
            vertical-alignment: center;
            width: 118px;
            overflow: elide;
        }
    }
}
