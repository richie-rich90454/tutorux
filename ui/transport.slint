// Recording transport. Black only while a capture is active; a quiet ready
// strip otherwise. The waveform region never draws future audio.
import { Button, Theme } from "./theme.slint";

export component RecordingTransport inherits Rectangle {
    in property <string> state: "not-started";
    in property <string> microphone;
    in property <bool> writable: true;
    in-out property <int> elapsed: 0;

    callback command(string);
    callback mark(string);
    callback open-consent();
    callback open-config();

    property <bool> active: root.state == "recording" || root.state == "paused" ||
                           root.state == "initializing" || root.state == "finalizing";

    height: root.active ? Theme.transport-height : 64px;
    background: root.active ? Theme.transport : Theme.surface;

    function pad2(value: int) -> string {
        return (value < 10 ? "0" : "") + (value * 1.0).to-fixed(0);
    }

    function elapsed-label() -> string {
        return pad2(root.elapsed / 3600) + ":" +
               pad2(Math.mod(root.elapsed / 60, 60)) + ":" +
               pad2(Math.mod(root.elapsed, 60));
    }

    tick := Timer {
        interval: 1s;
        running: root.state == "recording";
        triggered() => { root.elapsed += 1; }
    }

    if !root.active : Rectangle {
        width: 100%;
        height: 1px;
        background: Theme.line;
    }

    if !root.active : HorizontalLayout {
        padding-left: 22px;
        padding-right: 18px;
        spacing: 12px;

        Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.state == "failed" ? Theme.danger : Theme.faint;
        }
        Text {
            text: root.state == "failed" ? "Recording needs attention" :
                  root.state == "completed" ? "Recording complete" :
                  root.state == "partial" ? "Partial recording" : "Ready to record";
            color: Theme.ink;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { }
        Button {
            text: "Configure audio";
            variant: "ghost";
            clicked => { root.open-config(); }
        }
        Button {
            text: "Start recording";
            variant: "primary";
            enabled: root.writable;
            clicked => { root.open-consent(); }
        }
    }

    if root.active : HorizontalLayout {
        padding-left: 22px;
        padding-right: 18px;
        spacing: 14px;

        VerticalLayout {
            width: 116px;
            spacing: 3px;
            padding-top: 18px;
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: root.state == "paused" ? Theme.transport-muted : Theme.recording;
                }
                Text {
                    text: root.state == "paused" ? "Paused" :
                          root.state == "initializing" ? "Starting" :
                          root.state == "finalizing" ? "Finalizing" : "Recording";
                    color: Theme.transport-text;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.elapsed-label();
                color: Theme.transport-text;
                font-size: 24px;
                font-weight: 600;
                letter-spacing: -0.4px;
            }
        }

        // Quiet region: a baseline and the current playhead only.
        Rectangle {
            horizontal-stretch: 1;
            height: 46px;
            y: (parent.height - self.height) / 2;
            clip: true;

            Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 1px;
                background: Theme.transport-line;
            }
            Rectangle {
                x: max(0px, parent.width - 2px);
                y: 6px;
                width: 2px;
                height: parent.height - 12px;
                background: Theme.transport-wave;
            }
        }

        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                width: 84px;
                height: 36px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.transport-line;
                background: mark-touch.has-hover ? Theme.transport-hover : transparent;
                Text {
                    text: "Mark";
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.transport-text;
                    font-size: 12px;
                    font-weight: 600;
                }
                mark-touch := TouchArea {
                    clicked => { root.mark(root.elapsed-label()); }
                }
            }
            Rectangle {
                width: 92px;
                height: 36px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.transport-line;
                background: pause-touch.has-hover ? Theme.transport-hover : transparent;
                Text {
                    text: root.state == "paused" ? "Resume" : "Pause";
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.transport-text;
                    font-size: 12px;
                    font-weight: 600;
                }
                pause-touch := TouchArea {
                    clicked => { root.command(root.state == "paused" ? "resume" : "pause"); }
                }
            }
            Rectangle {
                width: 82px;
                height: 36px;
                border-radius: 5px;
                background: stop-touch.has-hover ? Theme.danger : Theme.transport-text;
                Text {
                    text: "Stop";
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: stop-touch.has-hover ? Theme.on-danger : Theme.transport;
                    font-size: 12px;
                    font-weight: 700;
                }
                stop-touch := TouchArea {
                    clicked => { root.command("stop"); }
                }
            }
        }

        Text {
            text: root.microphone == "" ? "Default input" : root.microphone;
            color: Theme.transport-muted;
            font-size: 12px;
            vertical-alignment: center;
            width: 118px;
            overflow: elide;
        }
    }
}
