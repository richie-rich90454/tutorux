{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build (shared GUI, tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "ON",
        "BUILD_TESTING": "ON",
        "TUTORUX_BUILD_GUI": "ON",
        "TUTORUX_ENABLE_FFMPEG": "OFF",
        "TUTORUX_ENABLE_LLAMA": "OFF",
        "TUTORUX_ENABLE_LTO": "ON",
        "TUTORUX_ENABLE_WHISPER": "OFF",
        "TUTORUX_FETCH_FFMPEG": "OFF",
        "TUTORUX_FETCH_LLAMA": "OFF",
        "TUTORUX_FETCH_PODOFO": "ON",
        "TUTORUX_FETCH_SLINT": "ON",
        "TUTORUX_FETCH_WHISPER": "OFF",
        "TUTORUX_STATIC_RUNTIME": "OFF"
      }
    },
    {
      "name": "portable",
      "displayName": "Portable single-file build (Windows)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/portable",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_TESTING": "ON",
