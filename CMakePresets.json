            "jobs": 4,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "portable-compact-release",
            "configurePreset": "portable-compact-release",
            "jobs": 4,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "portable-compact-debug",
