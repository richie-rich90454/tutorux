            "jobs": 4,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "portable-compact-macos-release",
            "configurePreset": "portable-compact-macos-release",
            "jobs": 4,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "portable-compact-macos-debug",
            "configurePreset": "portable-compact-macos-debug",
            "jobs": 4,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        }
    ],
    "testPresets": [
        {
            "name": "portable-static-release",
            "configurePreset": "portable-static-release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "output": {
                "outputOnFailure": true
