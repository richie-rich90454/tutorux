{
    "version": 6,
    "configurePresets": [
        {
            "name": "portable-wasm-release",
            "displayName": "Portable static browser release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-wasm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "BUILD_TESTING": "OFF",
                "TUTORUX_BUILD_GUI": "OFF",
                "TUTORUX_BUILD_WASM": "ON",
                "TUTORUX_ENABLE_LTO": "ON"
            }
        },
        {
            "name": "portable-wasm-debug",
            "displayName": "Portable static browser debug",
            "inherits": "portable-wasm-release",
            "binaryDir": "${sourceDir}/build-wasm-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TUTORUX_ENABLE_LTO": "OFF"
            }
        },
        {
            "name": "portable-static-release",
            "displayName": "Portable static release (Windows)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-static",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_SHARED_LIBS": "OFF",
                "FETCHCONTENT_FULLY_DISCONNECTED": "OFF",
                "FETCHCONTENT_UPDATES_DISCONNECTED": "ON",
                "TUTORUX_BUILD_GUI": "ON",
                "TUTORUX_ENABLE_WHISPER": "ON",
                "TUTORUX_FETCH_PODOFO": "ON",
                "TUTORUX_FETCH_SLINT": "ON",
                "TUTORUX_FETCH_WHISPER": "ON",
                "TUTORUX_ENABLE_LLAMA": "ON",
                "TUTORUX_FETCH_LLAMA": "ON",
                "TUTORUX_STATIC_RUNTIME": "ON"
            }
        },
        {
            "name": "portable-static-debug",
            "displayName": "Portable static debug",
            "inherits": "portable-static-release",
            "binaryDir": "${sourceDir}/build-static-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "portable-static-linux-release",
            "displayName": "Portable static release (Linux)",
            "inherits": "portable-static-release",
            "binaryDir": "${sourceDir}/build-linux-static",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "portable-static-linux-debug",
            "displayName": "Portable static debug (Linux)",
            "inherits": "portable-static-linux-release",
            "binaryDir": "${sourceDir}/build-linux-static-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "portable-static-macos-release",
            "displayName": "Portable static release (macOS)",
            "inherits": "portable-static-release",
            "binaryDir": "${sourceDir}/build-macos-static",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "TUTORUX_LLAMA_METAL": "ON"
            }
        },
        {
            "name": "portable-static-macos-debug",
            "displayName": "Portable static debug (macOS)",
            "inherits": "portable-static-macos-release",
            "binaryDir": "${sourceDir}/build-macos-static-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "portable-compact-release",
            "displayName": "Portable compact static release (Windows)",
            "inherits": "portable-static-release",
            "binaryDir": "${sourceDir}/build-compact",
            "cacheVariables": {
                "TUTORUX_ENABLE_LLAMA": "OFF",
                "TUTORUX_FETCH_LLAMA": "OFF"
            }
        },
        {
            "name": "portable-compact-debug",
            "displayName": "Portable compact static debug (Windows)",
            "inherits": "portable-compact-release",
            "binaryDir": "${sourceDir}/build-compact-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "portable-compact-linux-release",
            "displayName": "Portable compact static release (Linux)",
            "inherits": "portable-compact-release",
            "binaryDir": "${sourceDir}/build-linux-compact",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "portable-compact-linux-debug",
            "displayName": "Portable compact static debug (Linux)",
            "inherits": "portable-compact-linux-release",
            "binaryDir": "${sourceDir}/build-linux-compact-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "portable-compact-macos-release",
            "displayName": "Portable compact static release (macOS)",
            "inherits": "portable-compact-release",
            "binaryDir": "${sourceDir}/build-macos-compact",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "portable-compact-macos-debug",
            "displayName": "Portable compact static debug (macOS)",
            "inherits": "portable-compact-macos-release",
            "binaryDir": "${sourceDir}/build-macos-compact-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "portable-wasm-release",
            "configurePreset": "portable-wasm-release",
            "jobs": 4
        },
        {
            "name": "portable-wasm-debug",
