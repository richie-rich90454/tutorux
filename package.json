{
    "name": "tutorux",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "A local-first tutoring workstation",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
        "build": "pnpm run typecheck && vite build --mode web",
        "build:desktop": "pnpm run typecheck && vite build --mode desktop",
        "build:audio-helper": "node scripts/build-audio-helper.mjs",
        "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "lint": "eslint frontend scripts tests vite.config.ts playwright.config.ts eslint.config.js",
        "format:check": "oxfmt --check frontend scripts tests tests/fixtures/README.md README.md docs index.html vite.config.ts playwright.config.ts eslint.config.js package.json tsconfig.json tsconfig.node.json --ignore-path .gitignore",
        "format": "oxfmt --write frontend scripts tests tests/fixtures/README.md README.md docs index.html vite.config.ts playwright.config.ts eslint.config.js package.json tsconfig.json tsconfig.node.json --ignore-path .gitignore",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "benchmark:archive": "tsx scripts/benchmark-archive.ts",
        "tauri": "tauri",
        "dev:desktop": "vite --mode desktop --host 127.0.0.1 --port 1420 --strictPort",
        "desktop:dev": "tauri dev",
        "desktop:build": "node scripts/build-desktop.mjs"
    },
    "dependencies": {
        "@tauri-apps/api": "2.12.4",
        "@tauri-apps/plugin-dialog": "2.8.4",
        "@tauri-apps/plugin-fs": "2.7.1",
        "fflate": "0.8.3",
        "libsodium-wrappers-sumo": "0.8.4",
        "pdfjs-dist": "6.4.299",
        "solid-js": "1.9.18"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "2.12.4",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "5.0.5",
        "eslint": "10.13.0",
        "eslint-plugin-solid": "0.18.1",
        "jsdom": "^30.1.3",
        "oxfmt": "0.75.0",
        "tailwindcss": "^4.3.3",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vite": "8.3.5",
        "vite-plugin-solid": "2.11.15",
        "vitest": "5.0.5"
    },
    "packageManager": "pnpm@12.14.0"
}
