if(NOT DEFINED TUTORUX_RUNTIME_EXECUTABLE OR NOT DEFINED TUTORUX_RUNTIME_DESTINATION)
    message(FATAL_ERROR "Runtime executable and destination are required.")
endif()

if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()

set(TUTORUX_RUNTIME_SEARCH_DIRECTORIES)
if(DEFINED TUTORUX_RUNTIME_PODOFO_DIRECTORY AND TUTORUX_RUNTIME_PODOFO_DIRECTORY)
    list(APPEND TUTORUX_RUNTIME_SEARCH_DIRECTORIES "${TUTORUX_RUNTIME_PODOFO_DIRECTORY}")
endif()
list(APPEND TUTORUX_RUNTIME_SEARCH_DIRECTORIES "${TUTORUX_RUNTIME_SEARCH_DIRECTORY}")

# The executable's own directory is always searched, so previously copied
# runtime DLLs there would conflict with the originals in the search
# directories. Exclude the destination so those copies resolve to their
# real location.
file(TO_CMAKE_PATH "${TUTORUX_RUNTIME_DESTINATION}" TUTORUX_RUNTIME_DESTINATION_CMAKE)
string(REPLACE "/" "[/\\\\]" TUTORUX_RUNTIME_DESTINATION_REGEX
    "${TUTORUX_RUNTIME_DESTINATION_CMAKE}"
)

file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${TUTORUX_RUNTIME_EXECUTABLE}"
    DIRECTORIES ${TUTORUX_RUNTIME_SEARCH_DIRECTORIES}
    RESOLVED_DEPENDENCIES_VAR TUTORUX_RESOLVED_DEPENDENCIES
    UNRESOLVED_DEPENDENCIES_VAR TUTORUX_UNRESOLVED_DEPENDENCIES
    PRE_EXCLUDE_REGEXES
        "^api-ms-"
        "^ext-ms-"
        "^(AzureAttestManager|AzureAttestNormal|HvsiFileTrust|PdmUtilities|wpaxholder)\\.dll$"
    POST_EXCLUDE_REGEXES
        "^${TUTORUX_RUNTIME_DESTINATION_REGEX}/.*"
        ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss]/([Ss][Yy][Ss][Tt][Ee][Mm]32|[Ss][Yy][Ss][Ww][Oo]64)/.*"
)

foreach(TUTORUX_DEPENDENCY IN LISTS TUTORUX_RESOLVED_DEPENDENCIES)
    get_filename_component(TUTORUX_DEPENDENCY_NAME "${TUTORUX_DEPENDENCY}" NAME)
    set(TUTORUX_DEPENDENCY_TARGET
        "${TUTORUX_RUNTIME_DESTINATION}/${TUTORUX_DEPENDENCY_NAME}"
    )
    if(NOT TUTORUX_DEPENDENCY STREQUAL TUTORUX_DEPENDENCY_TARGET)
        file(COPY_FILE "${TUTORUX_DEPENDENCY}" "${TUTORUX_DEPENDENCY_TARGET}" ONLY_IF_DIFFERENT)
    endif()
endforeach()

if(TUTORUX_UNRESOLVED_DEPENDENCIES)
    message(WARNING "Unresolved runtime dependencies: ${TUTORUX_UNRESOLVED_DEPENDENCIES}")
endif()
