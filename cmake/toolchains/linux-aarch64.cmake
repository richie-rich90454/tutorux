set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(TUTORUX_LINUX_AARCH64_ROOT "$ENV{TUTORUX_LINUX_AARCH64_ROOT}" CACHE PATH
    "Target AArch64 cross-compiler, sysroot, and static dependency prefix"
)
set(TUTORUX_LINUX_AARCH64_SYSROOT "$ENV{TUTORUX_LINUX_AARCH64_SYSROOT}" CACHE PATH
    "Ubuntu 24.04-compatible AArch64 sysroot"
)
set(TUTORUX_LINUX_AARCH64_C_COMPILER "$ENV{TUTORUX_LINUX_AARCH64_C_COMPILER}" CACHE FILEPATH
    "AArch64 Linux C compiler"
)
set(TUTORUX_LINUX_AARCH64_CXX_COMPILER "$ENV{TUTORUX_LINUX_AARCH64_CXX_COMPILER}" CACHE FILEPATH
    "AArch64 Linux C++ compiler"
)
if(NOT TUTORUX_LINUX_AARCH64_ROOT OR NOT TUTORUX_LINUX_AARCH64_SYSROOT OR
   NOT TUTORUX_LINUX_AARCH64_C_COMPILER OR NOT TUTORUX_LINUX_AARCH64_CXX_COMPILER)
    message(FATAL_ERROR
        "Set TUTORUX_LINUX_AARCH64_ROOT, TUTORUX_LINUX_AARCH64_SYSROOT, "
        "TUTORUX_LINUX_AARCH64_C_COMPILER, and TUTORUX_LINUX_AARCH64_CXX_COMPILER "
        "before using the Linux ARM64 cross preset."
    )
endif()

set(CMAKE_C_COMPILER "${TUTORUX_LINUX_AARCH64_C_COMPILER}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${TUTORUX_LINUX_AARCH64_CXX_COMPILER}" CACHE FILEPATH "" FORCE)
set(CMAKE_SYSROOT "${TUTORUX_LINUX_AARCH64_SYSROOT}" CACHE PATH "" FORCE)
set(TUTORUX_LINUX_AARCH64_AR "$ENV{TUTORUX_LINUX_AARCH64_AR}" CACHE FILEPATH
    "AArch64 Linux archiver"
)
set(TUTORUX_LINUX_AARCH64_RANLIB "$ENV{TUTORUX_LINUX_AARCH64_RANLIB}" CACHE FILEPATH
    "AArch64 Linux ranlib"
)
if(NOT TUTORUX_LINUX_AARCH64_AR)
    set(TUTORUX_LINUX_AARCH64_AR
        "${TUTORUX_LINUX_AARCH64_ROOT}/bin/aarch64-linux-gnu-ar"
    )
endif()
if(NOT TUTORUX_LINUX_AARCH64_RANLIB)
    set(TUTORUX_LINUX_AARCH64_RANLIB
        "${TUTORUX_LINUX_AARCH64_ROOT}/bin/aarch64-linux-gnu-ranlib"
    )
endif()
set(CMAKE_AR "${TUTORUX_LINUX_AARCH64_AR}" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "${TUTORUX_LINUX_AARCH64_RANLIB}" CACHE FILEPATH "" FORCE)
set(CMAKE_PREFIX_PATH "${TUTORUX_LINUX_AARCH64_ROOT}" CACHE PATH "Target AArch64 dependency prefix" FORCE)
set(CMAKE_FIND_ROOT_PATH
    "${TUTORUX_LINUX_AARCH64_ROOT};${TUTORUX_LINUX_AARCH64_SYSROOT}"
)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(Rust_CARGO_TARGET aarch64-unknown-linux-gnu CACHE STRING
    "Rust target triple used by Corrosion for Linux ARM64"
)

set(TUTORUX_LINUX_AARCH64_PKGCONFIG_LIBDIR
    "$ENV{TUTORUX_LINUX_AARCH64_PKGCONFIG_LIBDIR}" CACHE STRING
    "Colon-separated target-only pkg-config directories"
)
if(NOT TUTORUX_LINUX_AARCH64_PKGCONFIG_LIBDIR)
    set(TUTORUX_LINUX_AARCH64_PKGCONFIG_LIBDIR
        "${TUTORUX_LINUX_AARCH64_SYSROOT}/usr/lib/aarch64-linux-gnu/pkgconfig:${TUTORUX_LINUX_AARCH64_SYSROOT}/usr/share/pkgconfig"
        CACHE STRING "Target-only pkg-config directories" FORCE
    )
endif()
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${TUTORUX_LINUX_AARCH64_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${TUTORUX_LINUX_AARCH64_PKGCONFIG_LIBDIR}")
