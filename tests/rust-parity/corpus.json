        {
            "id": "asset.add-export",
            "capability": "asset.add",
            "files": {
                "material.txt": "material payload"
            },
            "steps": [
                {
                    "id": "asset add",
                    "args": [
                        "--archive",
                        "{archive}",
                        "--json",
                        "asset",
                        "add",
                        "{dir}/material.txt"
                    ],
                    "capture": {
                        "asset": "0.id"
                    },
                    "expect": {
                        "exitCode": 0,
                        "stdoutJson": [
                            {
                                "id": "<uuid>",
                                "type": "asset",
                                "revision": "1",
                                "blob_count": "1",
                                "blob_id": "<uuid>",
                                "byte_size": "16",
                                "content_hash": "9fba0fbffed5c7d8f8c2cadb34ab07f7de4111945f1d4a6b76168403aa491373",
                                "created_at_us": "<timestamp>",
                                "filename": "material.txt",
                                "mime_type": "text/plain",
                                "origin": "user-import"
                            }
                        ]
                    }
                },
                {
                    "id": "asset export",
                    "args": [
                        "--archive",
                        "{archive}",
                        "--json",
                        "asset",
                        "export",
                        "{capture.asset}",
                        "--output",
                        "{dir}/material-out.txt"
                    ],
                    "expect": {
                        "exitCode": 0,
                        "stdoutJson": {
                            "id": "<uuid>",
                            "output": "<path>",
                            "bytes": 16
                        },
                        "file": {
                            "path": "{dir}/material-out.txt",
                            "text": "material payload"
                        }
                    }
                }
            ]
