{
    "version": 1,
    "description": "Golden CLI cases for the Rust parity harness. Shapes use <uuid>, <timestamp>, <path>, <number>, <number-string>, <string>, <sha256> and <json-string> descriptors.",
    "cases": [
        {
            "id": "archive.init",
            "capability": "archive.init",
            "seed": false,
            "steps": [
                {
                    "id": "archive init",
                    "args": ["archive", "init", "{archive}", "--name", "Parity init", "--json"],
                    "expect": {
                        "exitCode": 0,
                        "stdoutJson": {
                            "path": "<path>",
                            "name": "Parity init",
                            "bytes": "<number>",
                            "created": true
                        }
                    }
                }
            ]
        },
        {
            "id": "archive.init-existing",
            "capability": "archive.init",
            "steps": [
                {
                    "id": "archive init existing",
                    "args": ["archive", "init", "{archive}", "--name", "Again", "--json"],
                    "expect": {
                        "exitCode": 2,
                        "stdoutJson": null,
                        "stderrContains": ["already exists"]
                    }
                }
            ]
        },
