                    }
                },
                {
                    "args": [
                        "--archive",
                        "{archive}",
                        "session",
                        "create",
                        "--title",
                        "No audio",
                        "--student-id",
                        "{capture.student}",
                        "--json"
                    ],
                    "capture": {
                        "session": "id"
                    }
                }
            ],
            "steps": [
